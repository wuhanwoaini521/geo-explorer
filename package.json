{
  "name": "geo-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "🌍 Geo Explorer —— 地理探索微信小程序（MVP：攀登珠穆朗玛峰 Demo）",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-requires.mjs",
    "build:local-media": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs --with-local-media && node scripts/check-requires.mjs",
    "build:prod": "node scripts/apply-media-config.mjs && node scripts/check-media-config.mjs && npm run build",
    "clean": "node scripts/clean.mjs",
    "media:manifest": "node scripts/media-manifest.mjs --write",
    "media:deploy": "node scripts/media-cos-deploy.mjs",
    "media:cos-main": "node scripts/media-cos-deploy.mjs",
    "media:check": "node scripts/media-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "vitest run tests/worlds-contract.test.ts",
    "wechat:screenshot": "node scripts/wechat-screenshot.cjs",
    "everest:viewer": "npm --prefix tools/everest-route-calibrator run build && node tools/everest-route-calibrator/server.mjs",
    "content:report": "npx tsx scripts/content/report.ts",
    "package:audit": "node scripts/package-audit.mjs",
    "media:review": "npx tsx scripts/content/build-review-board.ts",
    "media:download": "python3 scripts/content/download-candidates.py",
    "quality:report": "npx tsx scripts/content/overnight-report.ts",
    "media:review:serve": "npx tsx scripts/content/build-review-board.ts && node scripts/content/review-server.mjs",
    "media:review:verify": "node scripts/content/verify-review-board-browser.mjs",
    "release:report": "npx tsx scripts/content/release-readiness.ts"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "geography",
    "exploration"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "miniprogram-automator": "^0.12.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
