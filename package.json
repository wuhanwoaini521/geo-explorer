{
  "name": "geo-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "🌍 Geo Explorer —— 地理探索微信小程序（MVP：攀登珠穆朗玛峰 Demo）",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "geography",
    "exploration"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}