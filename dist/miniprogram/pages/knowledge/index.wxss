page { background: #07131f; color: #f4f8fb; }
.knowledge-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 72rpx) 28rpx calc(env(safe-area-inset-bottom) + 150rpx); background: #07131f; }
.knowledge-head { display: flex; align-items: center; gap: 18rpx; }.knowledge-back { font-size: 64rpx; line-height: 34rpx; }.knowledge-title { flex: 1; font-size: 38rpx; font-weight: 800; }.knowledge-more { color: #9db4c5; letter-spacing: 7rpx; }
.knowledge-search { display: flex; align-items: center; gap: 12rpx; height: 70rpx; margin-top: 22rpx; padding: 0 18rpx; border-radius: 14rpx; background: #102538; border: 1rpx solid rgba(174, 215, 238, .15); }.knowledge-search-mark { color: #8ec9eb; font-size: 34rpx; }.knowledge-search input { flex: 1; color: #edf7fc; font-size: 23rpx; }.knowledge-clear { color: #68bce9; font-size: 19rpx; }
.knowledge-tabs { display: flex; gap: 10rpx; margin-top: 20rpx; }.knowledge-tab { flex: 1; padding: 13rpx 4rpx; text-align: center; white-space: nowrap; border-radius: 30rpx; color: #9bb0c1; background: #112536; font-size: 19rpx; }.knowledge-tab-active { color: #102236; background: #eff8ff; }
.knowledge-list { height: calc(100vh - 360rpx); margin-top: 22rpx; }.knowledge-card { position: relative; height: 306rpx; margin-bottom: 18rpx; overflow: hidden; border-radius: 16rpx; background: #102b43; }.knowledge-image, .knowledge-image-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }.knowledge-image-fallback { background: linear-gradient(145deg, #1c4b69, #0d2032); color: #a9dff7; font-size: 22rpx; letter-spacing: 2rpx; }.knowledge-card-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3,14,25,0) 15%, rgba(3,14,25,.9) 100%); }.knowledge-card-copy { position: absolute; left: 22rpx; right: 22rpx; bottom: 20rpx; display: flex; flex-direction: column; gap: 7rpx; }.knowledge-card-title { font-size: 29rpx; font-weight: 800; }.knowledge-card-body { color: #d3e2ec; font-size: 22rpx; line-height: 1.45; }.knowledge-empty { display: flex; flex-direction: column; gap: 10rpx; padding-top: 120rpx; text-align: center; color: #8fa8b9; font-size: 24rpx; }
.knowledge-page { background: #f7fafc; color: #102c3d; }
.knowledge-title { color: #102c3d; }
.knowledge-more { color: #8da1ad; }
.knowledge-search { background: #ffffff; border-color: #d5e2e9; box-shadow: 0 8rpx 22rpx rgba(16, 44, 61, .06); }
.knowledge-search-mark, .knowledge-clear { color: #2c77d9; }
.knowledge-search input { color: #102c3d; }
.knowledge-tab { color: #587180; background: #e5f3f8; border: 1rpx solid #d5e2e9; }
.knowledge-tab-active { color: #ffffff; background: #2c77d9; border-color: #2c77d9; }
.knowledge-card { background: #ffffff; box-shadow: 0 10rpx 28rpx rgba(16, 44, 61, .1); }
.knowledge-card-shade { background: linear-gradient(180deg, rgba(8,33,52,0) 15%, rgba(8,33,52,.82) 100%); }
.knowledge-card-body { color: rgba(255,255,255,.82); }
.knowledge-empty { color: #8da1ad; }
