page { background: #07131f; color: #f4f8fb; }
.knowledge-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 72rpx) 28rpx calc(env(safe-area-inset-bottom) + 28rpx); background: #07131f; }
.knowledge-head { display: flex; align-items: center; gap: 18rpx; }.knowledge-back { font-size: 64rpx; line-height: 34rpx; }.knowledge-title { flex: 1; font-size: 38rpx; font-weight: 800; }.knowledge-more { color: #9db4c5; letter-spacing: 7rpx; }
.knowledge-tabs { display: flex; gap: 10rpx; margin-top: 28rpx; }.knowledge-tab { flex: 1; padding: 13rpx 4rpx; text-align: center; white-space: nowrap; border-radius: 30rpx; color: #9bb0c1; background: #112536; font-size: 19rpx; }.knowledge-tab-active { color: #102236; background: #eff8ff; }
.knowledge-list { height: calc(100vh - 160rpx); margin-top: 22rpx; }.knowledge-card { position: relative; height: 306rpx; margin-bottom: 18rpx; overflow: hidden; border-radius: 16rpx; background: #102b43; }.knowledge-image { width: 100%; height: 100%; display: block; }.knowledge-card-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3,14,25,0) 15%, rgba(3,14,25,.9) 100%); }.knowledge-card-copy { position: absolute; left: 22rpx; right: 22rpx; bottom: 20rpx; display: flex; flex-direction: column; gap: 7rpx; }.knowledge-card-title { font-size: 29rpx; font-weight: 800; }.knowledge-card-summary { color: #d3e2ec; font-size: 22rpx; line-height: 1.45; }.knowledge-card-meta { color: #99bad0; font-size: 19rpx; }.knowledge-empty { padding-top: 120rpx; text-align: center; color: #8fa8b9; font-size: 24rpx; }
