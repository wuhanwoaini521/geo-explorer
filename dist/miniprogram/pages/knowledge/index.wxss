.page { min-height: 100vh; background: #f6f0dd; padding: 36rpx 32rpx calc(env(safe-area-inset-bottom) + 190rpx); }
.page-title { font-size: 38rpx; font-weight: 800; color: #37311e; letter-spacing: 1rpx; }
.page-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: #94896a; }

/* ---------------- 搜索 ---------------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 24rpx 0 8rpx;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.18);
}
.search-ico { font-size: 26rpx; }
.search-input { flex: 1; font-size: 26rpx; color: #37311e; }
.search-ph { color: #b0a586; }
.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(151, 124, 66, 0.14);
  color: #8a7c58;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------------- 分类筛选 ---------------- */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 22rpx 0 26rpx;
}
.cat {
  font-size: 22rpx;
  color: #6f6547;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(151, 124, 66, 0.1);
  border: 1rpx solid rgba(151, 124, 66, 0.14);
}
.cat-active {
  color: #fffdf4;
  font-weight: 700;
  background: #a87717;
  border-color: #a87717;
}

/* ---------------- 列表 ---------------- */
.list { display: flex; flex-direction: column; gap: 20rpx; }
.item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 18rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
}
.item-emoji { font-size: 44rpx; }
.item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.item-row { display: flex; align-items: center; gap: 14rpx; }
.item-name { font-size: 28rpx; font-weight: 700; color: #37311e; flex: 1; }
.item-badge {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: #5c7a34;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(107, 143, 61, 0.14);
  border: 1rpx solid rgba(107, 143, 61, 0.28);
}
.item-cat { flex-shrink: 0; font-size: 20rpx; color: #94896a; }
.item-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f6547;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-arrow { font-size: 36rpx; color: #b0a586; }

/* ---------------- 空态 ---------------- */
.empty {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-emoji { font-size: 64rpx; opacity: 0.7; }
.empty-text { font-size: 24rpx; color: #94896a; }
