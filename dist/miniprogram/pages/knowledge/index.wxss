.page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 28rpx) 24rpx calc(env(safe-area-inset-bottom) + 40rpx); background: #07131f; color: #f2f8fc; }
.knowledge-head { display: flex; align-items: center; justify-content: space-between; }
.knowledge-head > view { flex: 1; margin-left: 18rpx; display: flex; flex-direction: column; gap: 5rpx; }
.knowledge-back { font-size: 62rpx; line-height: 35rpx; }
.knowledge-more { color: #c8d9e5; letter-spacing: 6rpx; }
.eyebrow { color: #7298b0; font-size: 19rpx; letter-spacing: 4rpx; }
.page-title { display: block; font-size: 38rpx; font-weight: 800; }
.page-sub { display: block; margin-top: 26rpx; color: #8fa8b9; font-size: 23rpx; line-height: 1.6; }
.cat-row { display: flex; gap: 14rpx; margin-top: 26rpx; white-space: nowrap; }
.cat { display: inline-flex; align-items: center; justify-content: center; height: 58rpx; padding: 0 24rpx; border-radius: 30rpx; color: #91a9ba; background: #112536; border: 1rpx solid rgba(167, 207, 234, .13); font-size: 22rpx; }
.cat-active { color: #f2faff; background: #1f82bc; border-color: #41b4f1; }
.list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.item { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 16rpx; background: #102335; border: 1rpx solid rgba(169, 209, 234, .12); }
.item-image { flex-shrink: 0; width: 118rpx; height: 118rpx; border-radius: 12rpx; }
.item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.item-row { display: flex; align-items: flex-start; gap: 8rpx; }
.item-name { flex: 1; color: #edf7fb; font-size: 26rpx; font-weight: 700; line-height: 1.4; }
.item-badge { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: 8rpx; color: #65c3f4; background: rgba(60, 174, 238, .13); font-size: 17rpx; }
.item-summary { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #86a1b2; font-size: 21rpx; line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.item-arrow { color: #75b7da; font-size: 40rpx; }
.empty { margin-top: 80rpx; display: flex; flex-direction: column; align-items: center; gap: 18rpx; color: #7e99ab; }
.empty-emoji { font-size: 64rpx; }
.empty-text { font-size: 23rpx; }
