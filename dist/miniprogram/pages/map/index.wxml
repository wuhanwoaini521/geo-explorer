<view class="page">
  <view class="world-map" aria-label="世界地图">
    <canvas wx:if="{{!atlasOpen && !webglFailed}}" id="globeWebglCanvas" type="webgl" class="globe-webgl-canvas {{globeEarthOnly ? 'globe-canvas-earth-only' : ''}}" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <canvas wx:if="{{!atlasOpen && !webglFailed && !globeEarthOnly}}" id="globeLabelCanvas" type="2d" class="globe-label-canvas" disable-scroll="{{true}}" bindtouchstart="onGlobeTouchStart" catchtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <canvas wx:if="{{!atlasOpen && webglFailed && !globeFailed}}" id="globeCanvas" type="2d" class="globe-canvas {{globeEarthOnly ? 'globe-canvas-earth-only' : ''}}" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <image wx:if="{{globeFailed}}" class="world-map-fallback" src="/assets/world/world-map.svg" mode="aspectFill"></image>

    <cover-view wx:if="{{!atlasOpen && !globeEarthOnly && globeFailed}}" class="world-markers">
      <block wx:for="{{worldMarkers}}" wx:key="id">
        <cover-view wx:if="{{item.screenVisible}}" class="world-marker {{item.explorationId ? 'marker-open' : ''}} {{item.id === selectedMarkerId ? 'marker-selected' : ''}}" style="left:{{item.screenLeft}}%;top:{{item.screenTop}}%;opacity:{{item.screenOpacity}}" data-id="{{item.id}}" bindtap="onMapPointTap" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel">
          <cover-view class="marker-pin"><cover-view class="marker-glyph">{{item.typeGlyph}}</cover-view></cover-view>
          <cover-view class="marker-label marker-label-{{item.labelPlacement}}">
            <cover-view class="marker-label-title">{{item.name}}</cover-view>
            <cover-view class="marker-label-meta">{{item.typeLabel}} · {{item.metricText}}</cover-view>
          </cover-view>
        </cover-view>
      </block>
    </cover-view>

    <cover-view wx:if="{{!globeEarthOnly && !atlasOpen}}" class="world-map-caption">
      <cover-view class="caption-kicker">GEO EXPLORER</cover-view>
      <cover-view class="caption-title">在地球上发现下一段旅程</cover-view>
      <cover-view class="caption-sub">{{worldMarkerCount}} 个精选目的地 · {{atlasTotal}} 个地貌地点</cover-view>
    </cover-view>

    <cover-view wx:if="{{!globeEarthOnly && !atlasOpen && !selectedDestination}}" class="globe-hint"><cover-view class="globe-hint-dot"></cover-view><cover-view>拖动地球 · 点击地点查看简介</cover-view></cover-view>

    <cover-view wx:if="{{selectedDestination && !atlasOpen}}" class="destination-preview" bindtap="onOpenDestination">
      <cover-view class="destination-panel-head">
        <cover-view class="destination-kicker">{{selectedDestination.typeLabel}} · {{selectedDestination.region}}</cover-view>
        <cover-view class="destination-close" catchtap="onCloseDestination">×</cover-view>
      </cover-view>
      <cover-view class="destination-title">{{selectedDestination.name}}</cover-view>
      <cover-view class="destination-en">{{selectedDestination.nameEn}}</cover-view>
      <cover-view class="destination-desc destination-desc-compact">{{selectedDestination.description}}</cover-view>
      <cover-view class="destination-metric">{{selectedDestination.metricLabel}} · {{selectedDestination.metricValue}}</cover-view>
      <cover-view class="destination-action">{{selectedDestination.actionLabel}} <cover-view class="destination-arrow">›</cover-view></cover-view>
    </cover-view>
  </view>

  <block wx:if="{{!globeEarthOnly}}">
    <view class="map-head" style="top:{{headerTop}}px">
      <text class="map-back" bindtap="onBack">‹</text>
      <view class="map-title-group"><text class="map-title">探索世界</text><text class="map-title-en">WORLD OVERVIEW</text></view>
      <view class="map-header-actions"><text bindtap="onResetGlobe">复位</text><text class="map-header-action-primary" bindtap="onToggleAtlas">图鉴</text></view>
    </view>
    <view class="map-legend"><text class="legend-label">地图</text><text class="legend-item"><text class="legend-dot legend-open"></text>可探索</text><text class="legend-item"><text class="legend-dot"></text>精选地点</text><text class="legend-count">已显示 {{worldMarkerCount}}</text></view>

    <view wx:if="{{!atlasOpen}}" class="recommendation-rail">
      <view class="recommendation-head"><view><text class="recommendation-kicker">FEATURED EXPLORATIONS</text><text class="recommendation-title">推荐探索</text></view><text class="recommendation-count">横向滑动查看更多</text></view>
      <scroll-view class="recommendation-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="recommendation-row">
          <view wx:for="{{recommendations}}" wx:key="id" class="recommendation-card" data-id="{{item.id}}" bindtap="onOpenRecommendation">
            <image src="{{item.image}}" mode="aspectFill"></image><view class="recommendation-shade"></view>
            <view class="recommendation-copy"><text class="recommendation-en">{{item.nameEn}}</text><text class="recommendation-name">{{item.name}}</text><text class="recommendation-metric">{{item.metricValue}}</text></view>
            <view class="recommendation-cta"><text>{{item.actionLabel}}</text><text>›</text></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{atlasOpen}}" class="atlas-drawer">
      <view class="atlas-drawer-head"><view><text class="atlas-kicker">WORLD ATLAS</text><text class="atlas-title">地貌图鉴</text></view><text class="atlas-close" bindtap="onToggleAtlas">×</text></view>
      <scroll-view class="atlas-types" scroll-x enhanced show-scrollbar="{{false}}"><view class="atlas-type-row"><text wx:for="{{types}}" wx:key="type" class="atlas-type {{activeType === item.type ? 'atlas-type-active' : ''}}" data-type="{{item.type}}" bindtap="onTypeTap">{{item.label}}</text></view></scroll-view>
      <scroll-view class="atlas-list" scroll-y><view wx:if="{{atlas.length}}" class="atlas-grid"><view wx:for="{{atlas}}" wx:key="id" class="atlas-item" data-id="{{item.id}}" bindtap="onOpenPlace"><view class="atlas-item-mark">{{item.emoji}}</view><view class="atlas-item-copy"><text class="atlas-item-name">{{item.name}}</text><text class="atlas-item-meta">{{item.typeLabel}}{{item.exploration ? ' · 可探索' : ''}}</text><text class="atlas-item-desc">{{item.shortDescription}}</text></view><text class="atlas-item-arrow">›</text></view></view><view wx:else class="atlas-empty"><text>没有匹配的地点</text><text>试试其他关键词或分类</text></view></scroll-view>
    </view>
  </block>
</view>
