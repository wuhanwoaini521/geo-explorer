.marker-pin { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #fff; border: 2rpx solid #79a9b8; box-shadow: 0 6rpx 16rpx rgba(38, 90, 109, .22); }
.marker-pin text { transform: rotate(45deg); color: #397588; font-size: 22rpx; font-weight: 800; }
.marker-open .marker-pin { background: #2c77d9; border-color: #fff; box-shadow: 0 0 0 7rpx rgba(44,119,217,.18), 0 8rpx 18rpx rgba(38,90,109,.26); }
