.marker-label cover-view:first-child { color: #f4fbff; font-size: 19rpx; font-weight: 700; }
.marker-label cover-view:last-child { color: #91d5e7; font-size: 16rpx; }
.marker-label { display: none; flex-direction: column; align-items: center; margin-top: 8rpx; padding: 6rpx 10rpx; border-radius: 8rpx; background: rgba(5,26,42,.84); box-shadow: 0 4rpx 10rpx rgba(0,0,0,.18); white-space: nowrap; }
.marker-label-visible { display: flex; }
.marker-label text:first-child { color: #f4fbff; font-size: 19rpx; font-weight: 700; }
.marker-label text:last-child { color: #91d5e7; font-size: 16rpx; }
.map-legend { display: none; position: absolute; z-index: 4; left: 28rpx; right: 28rpx; top: 62%; align-items: center; gap: 18rpx; color: rgba(219,243,248,.82); font-size: 18rpx; }
.legend-label { color: #fff; font-size: 21rpx; font-weight: 700; }
.legend-item { display: flex; align-items: center; gap: 6rpx; }
.legend-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; border: 2rpx solid #79a9b8; }
.legend-open { background: #2c77d9; border-color: #2c77d9; }
.legend-count { margin-left: auto; color: rgba(205,234,241,.68); }
.map-tools { position: absolute; z-index: 9; right: 32rpx; top: 48%; display: flex; flex-direction: column; gap: 14rpx; }
.tool { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #dff8ff; background: rgba(7,27,43,.9); border: 1rpx solid rgba(173,224,242,.32); box-shadow: 0 8rpx 18rpx rgba(0,0,0,.2); font-size: 22rpx; font-weight: 700; }
.tool:first-child { font-size: 40rpx; font-weight: 400; }
.tool-2d { font-size: 19rpx; }
.globe-side-readout { position: absolute; z-index: 9; right: 30rpx; top: 33%; display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: rgba(230, 250, 255, .94); font-size: 15rpx; font-weight: 600; text-shadow: 0 1rpx 5rpx rgba(0, 8, 18, .9); }
.readout-north { color: rgba(246, 254, 255, .98); font-size: 20rpx; }
.readout-arrow { color: rgba(232, 250, 255, .96); font-size: 25rpx; line-height: 21rpx; }
.readout-scale { width: 30rpx; height: 106rpx; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; margin: 4rpx 0; }
.readout-scale cover-view { width: 13rpx; height: 1rpx; background: rgba(196, 235, 242, .56); }
.readout-scale .readout-knob { width: 18rpx; height: 18rpx; border: 1rpx solid rgba(104, 227, 239, .52); border-radius: 50%; background: rgba(6, 36, 58, .35); box-shadow: none; }
.recommendation-rail { position: absolute; z-index: 6; left: 18rpx; right: 18rpx; bottom: calc(env(safe-area-inset-bottom) + 136rpx); padding: 16rpx 0 0; border-radius: 18rpx; background: transparent; border: 0; box-shadow: none; }
.recommendation-head { display: flex; align-items: end; justify-content: space-between; margin-bottom: 12rpx; }
.recommendation-kicker { display: block; color: #8bdaf1; font-size: 16rpx; letter-spacing: 2rpx; }
.recommendation-title { display: block; margin-top: 4rpx; color: #fff; font-size: 26rpx; font-weight: 800; }
.recommendation-count { color: rgba(210,236,243,.64); font-size: 17rpx; }
.recommendation-row { display: inline-flex; gap: 12rpx; }
.recommendation-card { position: relative; width: 300rpx; height: 224rpx; overflow: hidden; border-radius: 14rpx; background: #123b56; border: 1rpx solid rgba(189, 235, 244, .22); }
.recommendation-card image, .recommendation-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.recommendation-shade { background: linear-gradient(90deg, rgba(5,22,36,.82), rgba(5,22,36,.08)); }
.recommendation-copy { position: absolute; left: 16rpx; top: 14rpx; display: flex; flex-direction: column; gap: 3rpx; }
.recommendation-en { color: rgba(239, 251, 255, .94); font-size: 19rpx; font-weight: 700; }
.recommendation-name { color: #fff; font-size: 23rpx; font-weight: 800; }
.recommendation-metric { color: #a9e2ef; font-size: 18rpx; }
.recommendation-cta { position: absolute; left: 14rpx; bottom: 13rpx; display: flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255, 116, 81, .9); color: #fff; font-size: 18rpx; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(255, 116, 81, .24); }
.recommendation-card:nth-child(2) .recommendation-cta { background: rgba(34, 180, 218, .92); box-shadow: 0 4rpx 12rpx rgba(34, 180, 218, .24); }
.recommendation-cta text:last-child { font-size: 28rpx; line-height: 16rpx; }
.recommendation-arrow { display: none; position: absolute; right: 14rpx; bottom: 12rpx; color: #fff; font-size: 36rpx; }
.destination-preview { position: absolute; z-index: 999; top: 300rpx; right: 42rpx; width: 252rpx; min-height: 178rpx; display: block; overflow: hidden; padding: 16rpx 16rpx 15rpx; box-sizing: border-box; border-radius: 18rpx; background: #041727; opacity: 1; border: 1rpx solid rgba(172, 229, 240, .78); box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, .56); color: #edfaff; animation: destination-panel-in .24s ease-out; }
.destination-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 6rpx; min-height: 30rpx; }
.destination-image { display: none; }
.destination-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding-top: 2rpx; }
.destination-kicker { display: block; max-width: 178rpx; color: #8bdaf1; font-size: 15rpx; line-height: 1.25; }
.destination-title { display: block; max-width: 178rpx; color: #f5fdff; font-size: 25rpx; line-height: 1.25; font-weight: 800; white-space: normal; word-break: break-all; }
.destination-en { display: block; margin-top: 3rpx; color: rgba(196, 235, 242, .68); font-size: 14rpx; letter-spacing: .6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.destination-desc { color: rgba(196, 225, 233, .74); font-size: 16rpx; line-height: 1.4; margin-top: 5rpx; }
.destination-desc-compact { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.destination-metric { display: block; margin-top: 13rpx; padding-top: 9rpx; border-top: 1rpx solid rgba(174, 224, 235, .2); color: #f2fdff; font-size: 16rpx; line-height: 1.35; white-space: normal; }
.destination-metric-label { color: rgba(185, 222, 230, .72); }
.destination-metric-value { color: #f2fdff; font-size: 20rpx; font-weight: 800; }
.destination-action { position: static; display: block; margin-top: 14rpx; padding-top: 10rpx; border-top: 1rpx solid rgba(174, 224, 235, .14); color: #7de7f5; font-size: 17rpx; line-height: 26rpx; font-weight: 700; }
.destination-action-label { color: #7de7f5; }
.destination-action .destination-arrow { display: inline; margin-left: 4rpx; font-size: 29rpx; line-height: 22rpx; }
.destination-arrow { font-size: 35rpx; line-height: 22rpx; }
.destination-close { flex-shrink: 0; color: rgba(216, 246, 250, .68); font-size: 26rpx; line-height: 24rpx; padding: 0 2rpx; }
@keyframes destination-panel-in { from { opacity: 0; transform: translateX(18rpx); } to { opacity: 1; transform: translateX(0); } }
.atlas-drawer { position: absolute; z-index: 8; left: 14rpx; right: 14rpx; top: calc(env(safe-area-inset-top) + 102rpx); bottom: calc(env(safe-area-inset-bottom) + 128rpx); padding: 22rpx 18rpx; box-sizing: border-box; border-radius: 22rpx; background: rgba(255,255,255,.98); border: 1rpx solid #c7dce3; box-shadow: 0 18rpx 55rpx rgba(16,44,61,.2); }
.atlas-drawer-head { display: flex; align-items: center; justify-content: space-between; }
.atlas-drawer-head > view { display: flex; flex-direction: column; gap: 4rpx; }
.atlas-kicker { color: #168bb9; font-size: 18rpx; letter-spacing: 4rpx; }
.atlas-title { color: #102c3d; font-size: 32rpx; font-weight: 800; }
.atlas-close { color: #2c77d9; font-size: 42rpx; padding: 8rpx 14rpx; }
.atlas-types { width: 100%; margin-top: 18rpx; }
.atlas-type-row { display: inline-flex; gap: 10rpx; }
.atlas-type { padding: 10rpx 18rpx; border-radius: 999rpx; background: #f1f7f9; border: 1rpx solid #d5e2e9; color: #587180; font-size: 20rpx; white-space: nowrap; }
.atlas-type-active { color: #fff; background: #2c77d9; border-color: #2c77d9; font-weight: 700; }
.atlas-list { height: calc(100% - 126rpx); margin-top: 16rpx; }
.atlas-grid { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 18rpx; }
.atlas-item { display: flex; align-items: center; gap: 14rpx; padding: 15rpx; border-radius: 14rpx; background: #f1f7f9; border: 1rpx solid #d5e2e9; }
.atlas-item-mark { width: 62rpx; height: 62rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #e5f3f8; font-size: 30rpx; }
.atlas-item-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.atlas-item-name { color: #102c3d; font-size: 24rpx; font-weight: 700; }
.atlas-item-meta { color: #168bb9; font-size: 18rpx; }
.atlas-item-desc { color: #8da1ad; font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.atlas-item-arrow { color: #2c77d9; font-size: 38rpx; }
.atlas-empty { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding-top: 80rpx; color: #8da1ad; font-size: 22rpx; }
