.page { position: fixed; inset: 0; overflow: hidden; background: #03182b; color: #edfaff; }
.world-map { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(circle at 46% 38%, #0b2947 0%, #04172c 45%, #010914 100%); }
.world-map::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 8% 8%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 26% 14%, rgba(160, 223, 255, .9) 0 1rpx, transparent 2rpx), radial-gradient(circle at 54% 9%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 78% 18%, rgba(160, 223, 255, .8) 0 1rpx, transparent 2rpx), radial-gradient(circle at 94% 7%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 87% 38%, rgba(160, 223, 255, .7) 0 1rpx, transparent 2rpx), radial-gradient(circle at 16% 43%, rgba(160, 223, 255, .65) 0 1rpx, transparent 2rpx), radial-gradient(circle at 42% 27%, rgba(160, 223, 255, .55) 0 1rpx, transparent 2rpx), radial-gradient(circle at 64% 52%, rgba(160, 223, 255, .65) 0 1rpx, transparent 2rpx), radial-gradient(circle at 18% 76%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 91% 72%, rgba(160, 223, 255, .7) 0 1rpx, transparent 2rpx), radial-gradient(circle at 18% 20%, rgba(88, 194, 224, .11), transparent 23%), linear-gradient(180deg, rgba(1, 12, 25, .08), rgba(1, 10, 20, .72)); pointer-events: none; }
.world-map::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(1, 11, 22, .28) 0%, transparent 28%, rgba(1, 8, 17, .78) 78%, #020e1c 100%); pointer-events: none; }
.globe-webgl-canvas, .globe-canvas { position: absolute; z-index: 1; top: 208rpx; left: 0; width: 100%; height: 900rpx; display: block; }
.globe-canvas-selected { top: 0; left: 0; width: 100%; height: 100%; }
.globe-canvas-earth-only { top: 0; left: 0; width: 100%; height: 100%; }
.world-map-fallback { position: absolute; z-index: 1; top: 228rpx; left: 0; width: 100%; height: 620rpx; opacity: .78; filter: brightness(.58) saturate(1.35); }
.globe-hint { position: absolute; z-index: 3; left: 32rpx; top: 612rpx; display: flex; align-items: center; gap: 10rpx; color: rgba(196, 237, 245, .72); font-size: 18rpx; letter-spacing: .5rpx; }
.globe-hint-dot { width: 10rpx; height: 10rpx; border: 2rpx solid #65e3ef; border-radius: 50%; box-shadow: 0 0 12rpx rgba(101, 227, 239, .8); }
.map-head { position: absolute; top: 64rpx; left: 24rpx; right: 24rpx; display: flex; align-items: flex-start; z-index: 5; }
.map-back { width: 42rpx; font-size: 58rpx; line-height: 34rpx; color: #fff; }
.map-title-group { display: flex; flex-direction: column; gap: 2rpx; }
