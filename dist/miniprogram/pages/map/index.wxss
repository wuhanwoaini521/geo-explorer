.map-clear { color: #8bdaf1; font-size: 19rpx; }
.map-scan { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; color: #7de7f5; font-size: 32rpx; line-height: 1; }
.world-map-caption { position: absolute; z-index: 12; left: 30rpx; top: 59%; display: flex; flex-direction: column; gap: 5rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.36); }
