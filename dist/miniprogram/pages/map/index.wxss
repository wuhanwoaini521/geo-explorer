.page { position: fixed; inset: 0; overflow: hidden; background: #092440; color: #f6fbff; }
.map-image, .map-image-fallback { position: absolute; inset: 0; width: 100%; height: 100%; transform: scale(1.12); }
.map-image-fallback { background: linear-gradient(160deg, #2d5f87, #0a1c2e 70%); }
.map-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 26, 48, .66) 0%, rgba(10, 34, 59, .04) 35%, rgba(5, 15, 24, .64) 100%); }
.map-head { position: absolute; top: calc(env(safe-area-inset-top) + 24rpx); left: 24rpx; right: 24rpx; display: flex; align-items: flex-start; z-index: 5; }
.map-back { width: 42rpx; font-size: 58rpx; line-height: 34rpx; color: #fff; }
.map-title-group { display: flex; flex-direction: column; gap: 2rpx; }
.map-title { font-size: 33rpx; font-weight: 800; }
.map-title-en { font-size: 23rpx; color: rgba(238, 247, 255, .75); }
.map-more { margin-left: auto; font-size: 30rpx; letter-spacing: 6rpx; color: rgba(255,255,255,.82); }
.route-segments { position: absolute; inset: 0; z-index: 2; }
.route-segment { position: absolute; height: 6rpx; transform-origin: left center; border-radius: 8rpx; background: rgba(220, 240, 255, .88); box-shadow: 0 0 12rpx rgba(47, 176, 249, .76); }
.route-points { position: absolute; inset: 0; z-index: 3; }
.route-point { position: absolute; display: flex; align-items: center; gap: 16rpx; transform: translate(-50%, -50%); }
.route-point-left .route-label { order: -1; }
.route-dot { width: 28rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f6fbff; border: 4rpx solid #238fd8; box-shadow: 0 0 0 4rpx rgba(10, 38, 65, .55); }
.route-summit-mark { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d79029; box-shadow: 0 0 0 3rpx rgba(215, 144, 41, .22); }
.route-point-current .route-dot { width: 34rpx; height: 34rpx; border-color: #fff; background: #26a9f2; box-shadow: 0 0 0 5rpx rgba(41, 174, 249, .3), 0 0 16rpx rgba(41, 174, 249, .8); }
.route-point-upcoming .route-dot { background: #d8e8f4; border-color: rgba(18, 106, 174, .8); }
.route-label { min-width: 188rpx; padding: 8rpx 14rpx; border-radius: 10rpx; background: rgba(9, 27, 44, .72); display: flex; flex-direction: column; gap: 1rpx; }
.route-name { font-size: 25rpx; font-weight: 700; color: #fff; }
.route-alt { font-size: 22rpx; color: rgba(235, 246, 255, .76); }
.map-tools { position: absolute; right: 22rpx; top: 40%; display: flex; flex-direction: column; gap: 18rpx; z-index: 4; }
.tool { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: rgba(10, 22, 35, .76); border: 1rpx solid rgba(255,255,255,.14); font-size: 42rpx; }
.tool-2d { font-size: 22rpx; font-weight: 800; }
.map-place-card { position: absolute; left: 16rpx; right: 16rpx; bottom: calc(env(safe-area-inset-bottom) + 20rpx); min-height: 190rpx; display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 20rpx; background: rgba(9, 22, 35, .9); border: 1rpx solid rgba(194, 224, 245, .18); z-index: 5; }
.map-place-image { width: 138rpx; height: 138rpx; border-radius: 12rpx; }
.map-place-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.map-place-title { font-size: 28rpx; font-weight: 700; }
.map-place-alt { font-size: 22rpx; color: #b4c7d7; }
.map-place-desc { font-size: 21rpx; line-height: 1.5; color: #91a7ba; }
.map-place-arrow { font-size: 48rpx; color: #dcecf7; }
.atlas-drawer { position: absolute; z-index: 8; left: 14rpx; right: 14rpx; top: calc(env(safe-area-inset-top) + 92rpx); bottom: calc(env(safe-area-inset-bottom) + 18rpx); padding: 22rpx 18rpx; box-sizing: border-box; border-radius: 22rpx; background: rgba(7, 20, 33, .96); border: 1rpx solid rgba(177, 215, 240, .22); box-shadow: 0 18rpx 55rpx rgba(0,0,0,.34); }
.atlas-drawer-head { display: flex; align-items: center; justify-content: space-between; }
.atlas-drawer-head > view { display: flex; flex-direction: column; gap: 4rpx; }
.atlas-kicker { color: #6aa9ce; font-size: 18rpx; letter-spacing: 4rpx; }
.atlas-title { color: #f3f8fb; font-size: 32rpx; font-weight: 800; }
.atlas-close { color: #c9e3f2; font-size: 42rpx; padding: 8rpx 14rpx; }
.atlas-search { display: flex; align-items: center; gap: 12rpx; height: 70rpx; margin-top: 18rpx; padding: 0 18rpx; border-radius: 12rpx; background: #102b43; border: 1rpx solid rgba(174, 215, 238, .16); }
.atlas-search-mark { color: #8ec9eb; font-size: 34rpx; }
.atlas-search input { flex: 1; color: #edf7fc; font-size: 23rpx; }
.atlas-clear { color: #68bce9; font-size: 19rpx; }
.atlas-types { width: 100%; margin-top: 16rpx; }
.atlas-type-row { display: inline-flex; gap: 10rpx; }
.atlas-type { padding: 10rpx 18rpx; border-radius: 999rpx; background: #102538; color: #91a9ba; font-size: 20rpx; white-space: nowrap; }
.atlas-type-active { background: #d9efff; color: #09233a; font-weight: 700; }
.atlas-list { height: calc(100% - 188rpx); margin-top: 16rpx; }
.atlas-grid { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 18rpx; }
.atlas-item { display: flex; align-items: center; gap: 14rpx; padding: 15rpx; border-radius: 14rpx; background: #102538; border: 1rpx solid rgba(174, 215, 238, .1); }
.atlas-item-mark { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 12rpx; color: #a6dfff; background: rgba(43, 157, 214, .14); border: 1rpx solid rgba(83, 188, 235, .28); font-size: 17rpx; }
.atlas-item-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.atlas-item-name { color: #f1f8fc; font-size: 24rpx; font-weight: 700; }
.atlas-item-meta { color: #64b9e9; font-size: 18rpx; }
.atlas-item-desc { color: #8ea7b7; font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.atlas-item-arrow { color: #9bc4dc; font-size: 38rpx; }
.atlas-empty { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding-top: 80rpx; color: #9aafbf; font-size: 22rpx; }
