.map-head-note { margin-left: auto; padding-top: 3rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; color: rgba(208,237,244,.7); font-size: 16rpx; white-space: nowrap; }
.map-head-note text:last-child { color: rgba(174, 219, 229, .48); font-size: 13rpx; letter-spacing: 2rpx; }
.map-search { position: absolute; z-index: 5; top: 158rpx; left: 28rpx; right: 28rpx; height: 70rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 999rpx; background: rgba(5, 25, 42, .82); border: 1rpx solid rgba(173,224,242,.3); box-shadow: 0 10rpx 26rpx rgba(0,0,0,.26); }
.map-search-mark { color: #8bdaf1; font-size: 34rpx; }
