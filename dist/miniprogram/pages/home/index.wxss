.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 190rpx);
  color: var(--geo-ink);
  background: var(--geo-paper);
}
.discovery-hero { position: relative; height: 310rpx; overflow: hidden; background: #244b63; }
.discovery-page::after { position: fixed; z-index: 59; left: 0; right: 0; bottom: 0; height: calc(env(safe-area-inset-bottom) + 154rpx); background: var(--geo-paper); content: ""; pointer-events: none; }
.discovery-hero-image, .discovery-hero-fallback, .discovery-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.discovery-hero-image { opacity: .84; }
.discovery-hero-image { top: -90rpx; bottom: auto; height: auto; }
.discovery-hero-fallback { background: linear-gradient(145deg, #9cbac0, #415b68 62%, #1a3546); }
.discovery-hero-shade { background: linear-gradient(180deg, rgba(12, 27, 39, .38), rgba(13, 33, 47, .08) 42%, rgba(22, 43, 54, .72)); }
.discovery-topline { position: absolute; top: 0; left: 44rpx; right: 60rpx; display: flex; align-items: flex-start; justify-content: space-between; }
.discovery-title-block { max-width: calc(100% - 178rpx); display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; }
.discovery-brand { color: rgba(248, 248, 239, .96); font-size: 19rpx; letter-spacing: 3rpx; font-weight: 700; }
.discovery-eyebrow { color: rgba(246, 237, 217, .76); font-size: 14rpx; letter-spacing: 2rpx; }
.discovery-actions { display: flex; align-items: center; gap: 28rpx; }
.discovery-search-toggle, .discovery-atlas { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(248, 246, 233, .48); border-radius: 50%; color: #fff8e9; background: rgba(22, 43, 54, .54); }
.discovery-action-icon { display: block; width: 32rpx; height: 32rpx; }
.discovery-title { color: #fffaf0; font-size: 48rpx; line-height: 1.08; font-weight: 800; letter-spacing: 2rpx; }
.discovery-subtitle { color: rgba(255, 250, 238, .94); font-size: 26rpx; letter-spacing: .5rpx; }
.discovery-english { display: none; }
.discovery-content { padding: 0 34rpx; }
.search-field { height: 78rpx; margin-top: -23rpx; position: relative; z-index: 2; box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; padding: 0 24rpx; border: 1rpx solid var(--geo-line); border-radius: var(--geo-radius-md); background: var(--geo-glass); box-shadow: var(--geo-shadow); }
.search-icon { width: 34rpx; height: 34rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.search-icon-image { display: block; width: 30rpx; height: 30rpx; }
.search-input { flex: 1; min-width: 0; color: #203846; font-size: 22rpx; }
.search-placeholder { color: #9c9d91; }
.search-go, .search-clear { flex-shrink: 0; color: #327b97; font-size: 21rpx; }
.search-go { padding: 12rpx 20rpx; border-radius: 999rpx; background: #e9f1e9; font-weight: 700; }
.search-clear { width: 48rpx; height: 48rpx; margin-right: -9rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f0f1e9; font-size: 34rpx; line-height: 1; }
.filters { width: 100%; margin: 16rpx 0 26rpx; }
.filter-row { display: inline-flex; gap: 22rpx; }
.filter { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 64rpx; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid #e0d8c8; border-radius: 999rpx; color: #687b7c; background: #faf6ec; font-size: 21rpx; line-height: 1.2; }
.filter-on { color: #f9f6ed; background: #287bb3; border-color: #287bb3; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(40, 123, 179, .24); }
.discovery-section-heading { display: block; margin: 12rpx 2rpx 14rpx; }
.section-link { flex-shrink: 0; color: #367e97; font-size: 20rpx; }
.destination-list { display: flex; flex-direction: column; gap: 14rpx; }
.destination { position: relative; height: 220rpx; overflow: hidden; border-radius: 20rpx; background: #405c68; box-shadow: 0 8rpx 20rpx rgba(39, 49, 48, .10); }
.destination-card-0 { height: 245rpx; }
.destination-image, .destination-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.destination-image { opacity: .97; }
.destination-shade { background: linear-gradient(90deg, rgba(13, 27, 37, .82) 0%, rgba(16, 31, 38, .46) 53%, rgba(16, 31, 38, .07) 100%), linear-gradient(0deg, rgba(10, 24, 31, .20), transparent 60%); }
.destination-catalog-row { min-height: 96rpx; display: flex; align-items: center; gap: 14rpx; padding: 15rpx 24rpx; box-sizing: border-box; border: 1rpx solid #e5dfd1; border-radius: 14rpx; background: #faf7ef; }
.catalog-row-type { flex: 0 0 auto; padding: 7rpx 10rpx; border-radius: 7rpx; color: #537b80; background: #e8efe7; font-size: 16rpx; }
.catalog-row-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.catalog-row-title { color: #263e4b; font-size: 22rpx; font-weight: 750; }
.catalog-row-subtitle { overflow: hidden; color: #75847e; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.catalog-row-arrow { width: 44rpx; height: 44rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin-left: 12rpx; }
.catalog-arrow-icon { display: block; width: 24rpx; height: 24rpx; }
.destination-copy { position: absolute; left: 23rpx; top: 19rpx; right: 90rpx; display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; }
.destination-kicker { padding: 5rpx 11rpx; border-radius: 7rpx; color: #155575; background: #bde9ef; font-size: 18rpx; font-weight: 700; }
.destination-kicker-mountain, .catalog-row-type-mountain { color: #155575; background: #bde9ef; }
.destination-kicker-ocean, .catalog-row-type-ocean { color: #1a5b83; background: #b7e1fa; }
.destination-kicker-canyon, .catalog-row-type-canyon { color: #804c2e; background: #f5d4b7; }
.destination-kicker-volcano, .catalog-row-type-volcano { color: #913d25; background: #ffd1b9; }
.destination-kicker-glacier, .catalog-row-type-glacier { color: #464b86; background: #d9dcfa; }
.destination-kicker-river, .catalog-row-type-river { color: #176a74; background: #c3e8ea; }
.destination-kicker-lake, .catalog-row-type-lake { color: #385b91; background: #c7ddf6; }
.destination-kicker-desert, .catalog-row-type-desert { color: #77531c; background: #f3dfaa; }
.destination-kicker-plateau, .catalog-row-type-plateau { color: #70503a; background: #e5d1bb; }
.destination-kicker-coast, .catalog-row-type-coast { color: #386744; background: #cce8d3; }
.destination-kicker-waterfall, .catalog-row-type-waterfall { color: #286c5d; background: #c3efe5; }
.destination-title { margin-top: 18rpx; }
.destination-title { color: #fffaf1; font-size: 31rpx; line-height: 1.18; font-weight: 800; }
.destination-subtitle { color: rgba(255, 249, 235, .92); font-size: 20rpx; }
.destination-elevation { color: rgba(255, 249, 235, .97); font-size: 24rpx; font-weight: 700; }
.destination-action { position: absolute; top: 50%; right: 30rpx; width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; transform: translateY(-50%); border: 1rpx solid rgba(255,255,255,.68); border-radius: 50%; color: #163a50; background: #f4f4e8; box-shadow: 0 7rpx 16rpx rgba(0,0,0,.22); }
.card-arrow-icon { display: block; width: 26rpx; height: 26rpx; }
.random-field-note { display: flex; align-items: center; gap: 16rpx; margin-top: 19rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(62, 150, 121, .22); border-radius: 15rpx; background: #e6f2e8; }
.random-mark { width: 55rpx; height: 55rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #f8fff5; background: #48a78a; font-size: 30rpx; }
.random-mark-icon { display: block; width: 31rpx; height: 31rpx; }
.random-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.random-title { color: #27483d; font-size: 23rpx; font-weight: 800; }
.random-caption { color: #6f9584; font-size: 17rpx; }
.random-arrow { width: 48rpx; height: 48rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin-left: 8rpx; }
.random-arrow-icon { display: block; width: 25rpx; height: 25rpx; }
.fact-note { margin-top: 20rpx; padding: 18rpx 20rpx 20rpx; border-left: 4rpx solid #cf8b4e; background: rgba(255, 249, 237, .78); }
.fact-note-head { display: flex; align-items: center; justify-content: space-between; }
.fact-index { color: #af7545; font-size: 16rpx; letter-spacing: 1.7rpx; }
.fact-refresh { display: flex; align-items: center; gap: 6rpx; color: #64838a; font-size: 18rpx; }
.fact-refresh-icon { display: block; width: 20rpx; height: 20rpx; }
.fact-copy { display: block; margin-top: 10rpx; color: #42555a; font-size: 22rpx; line-height: 1.55; }
.discovery-footnote { display: flex; justify-content: space-between; margin: 27rpx 1rpx 0; padding-top: 14rpx; border-top: 1rpx solid #dfd6c5; color: #99a096; font-size: 15rpx; letter-spacing: 1rpx; }
