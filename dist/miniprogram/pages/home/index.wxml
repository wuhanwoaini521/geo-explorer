<view class="page discovery-page geo-theme-field">
  <view class="discovery-hero">
    <image wx:if="{{!heroImageFailed}}" class="discovery-hero-image" src="{{heroImage}}" mode="widthFix" binderror="onHeroImageError"></image>
    <view wx:else class="discovery-hero-fallback"></view>
    <view class="discovery-hero-shade"></view>
    <view class="discovery-topline" style="padding-top:{{headerTop}}px">
      <view class="discovery-title-block">
        <text class="discovery-title">发现</text>
        <text class="discovery-subtitle">探索地球的每一处精彩</text>
      </view>
      <view class="discovery-actions">
        <view class="discovery-search-toggle" aria-label="搜索地点" bindtap="onToggleSearch"><image class="discovery-action-icon" src="/assets/icons/search-on-dark.svg" mode="aspectFit"></image></view>
        <view class="discovery-atlas" aria-label="打开地貌图鉴" bindtap="onOpenAtlas"><image class="discovery-action-icon" src="/assets/icons/atlas-on-dark.svg" mode="aspectFit"></image></view>
      </view>
    </view>
  </view>

  <view class="discovery-content">
    <view wx:if="{{searchOpen || query}}" class="search-field geo-search-shell">
      <view class="search-icon"><image class="search-icon-image" src="/assets/icons/search-on-light.svg" mode="aspectFit"></image></view>
      <input class="search-input" value="{{query}}" placeholder="搜索地点、山脉、海洋、地貌" placeholder-class="search-placeholder" confirm-type="search" bindinput="onQueryInput" bindconfirm="onQueryConfirm" />
      <text wx:if="{{query}}" class="search-clear" bindtap="onQueryClear">×</text>
      <text wx:else class="search-go" bindtap="onQueryConfirm">搜索</text>
    </view>

    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <text class="filter {{activeType === 'all' ? 'filter-on' : ''}}" data-type="all" bindtap="onOpenType">推荐</text>
        <text class="filter {{activeType === item.type ? 'filter-on' : ''}}" wx:for="{{discoveryTypes}}" wx:key="type" data-type="{{item.type}}" bindtap="onOpenType">{{item.label}}</text>
      </view>
    </scroll-view>

    <view class="destination-list">
      <geo-empty-state wx:if="{{sceneEmpty}}" title="没有找到相关地点" description="试试“珠峰”“海沟”或其他地貌关键词" action="清除搜索" bind:action="onQueryClear" />
      <block wx:for="{{scenes}}" wx:key="id">
        <view wx:if="{{item.image && !failedImages[item.id]}}" class="destination destination-card-{{index}}" data-id="{{item.id}}" data-target="{{item.target}}" bindtap="onOpenScene">
        <image class="destination-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onSceneImageError"></image>
        <view class="destination-shade"></view>
        <view class="destination-copy">
          <text class="destination-kicker destination-kicker-{{item.type}}">{{item.tags[0]}}</text>
          <text class="destination-title">{{item.title}}</text>
          <text class="destination-elevation">{{item.meta}}</text>
          <text class="destination-subtitle">{{item.subtitle}}</text>
        </view>
        <view class="destination-action" aria-hidden="true"><image class="card-arrow-icon" src="/assets/icons/arrow-on-light.svg" mode="aspectFit"></image></view>
      </view>
        <view wx:else class="destination-catalog-row" data-id="{{item.id}}" data-target="{{item.target}}" bindtap="onOpenScene">
          <view class="catalog-row-type catalog-row-type-{{item.type}}">{{item.tags[0]}}</view>
          <view class="catalog-row-copy"><text class="catalog-row-title">{{item.title}}</text><text class="catalog-row-subtitle">{{item.subtitle}}</text></view>
          <view class="catalog-row-arrow" aria-hidden="true"><image class="catalog-arrow-icon" src="/assets/icons/arrow-teal.svg" mode="aspectFit"></image></view>
        </view>
      </block>
    </view>

    <view class="random-field-note" bindtap="onRandomExplore">
      <view class="random-mark"><image class="random-mark-icon" src="/assets/icons/random-shuffle.svg" mode="aspectFit"></image></view><view class="random-copy"><text class="random-title">随机探索</text><text class="random-caption">把下一站交给地球 · {{placeCount}} 个地点等待发现</text></view><view class="random-arrow" aria-hidden="true"><image class="random-arrow-icon" src="/assets/icons/random-arrow.svg" mode="aspectFit"></image></view>
    </view>

    <view class="fact-note" wx:if="{{discovery}}">
      <view class="fact-note-head"><text class="fact-index">FIELD NOTE  /  {{discovery.index}}</text><view class="fact-refresh" bindtap="onShuffleDiscovery"><text>换一条</text><image class="fact-refresh-icon" src="/assets/icons/fact-refresh.svg" mode="aspectFit"></image></view></view>
      <text class="fact-copy">{{discovery.content}}</text>
    </view>

    <view class="discovery-footnote"><text>GEOGRAPHY IN MOTION</text><text>真实地貌 · 持续探索</text></view>
  </view>
</view>
