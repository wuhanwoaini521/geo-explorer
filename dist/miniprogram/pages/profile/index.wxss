.page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 30rpx) 24rpx calc(env(safe-area-inset-bottom) + 130rpx); background: #07131f; color: #edf6fb; }
.me { display: flex; flex-direction: column; align-items: center; padding: 42rpx 0 36rpx; border-radius: 20rpx; background: linear-gradient(180deg, #12324b, #0c2234); border: 1rpx solid rgba(166, 211, 238, .15); }
.me-avatar { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(120, 199, 234, .58); border-radius: 50%; color: #c9efff; background: linear-gradient(145deg, rgba(78, 167, 211, .28), rgba(12, 43, 66, .82)); font-size: 30rpx; font-weight: 700; letter-spacing: 3rpx; }
.me-name { margin-top: 16rpx; color: #f0f8fb; font-size: 34rpx; font-weight: 700; }
.me-note { margin-top: 8rpx; color: #86a7bb; font-size: 22rpx; }
.stats { display: flex; gap: 14rpx; margin: 26rpx 0; }
.st { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0; border-radius: 16rpx; background: #102536; border: 1rpx solid rgba(166, 211, 238, .13); }
.st-v { color: #62c5f8; font-size: 42rpx; font-weight: 800; }
.st-k { margin-top: 7rpx; color: #7897aa; font-size: 21rpx; }
.sec-title { margin: 18rpx 0 16rpx; color: #ecf6fa; font-size: 28rpx; font-weight: 700; }
.record { display: flex; flex-direction: column; gap: 12rpx; }
.empty { padding: 32rpx 24rpx; border-radius: 16rpx; background: #102536; border: 1rpx solid rgba(166, 211, 238, .12); color: #7895a8; font-size: 23rpx; line-height: 1.7; text-align: center; }
.rec { display: flex; align-items: center; gap: 18rpx; padding: 20rpx; border-radius: 14rpx; background: #102536; border: 1rpx solid rgba(166, 211, 238, .12); }
.rec-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1rpx solid rgba(98, 197, 248, .34); border-radius: 14rpx; color: #9bdcff; background: rgba(45, 160, 222, .12); font-size: 18rpx; letter-spacing: 1rpx; }
.rec-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.rec-name { color: #e2eff5; font-size: 25rpx; font-weight: 600; }
.rec-meta { margin-top: 6rpx; color: #7692a5; font-size: 21rpx; }
.rec-pct { color: #61c3f6; font-size: 23rpx; font-weight: 700; }
.quiz-stars { color: #6bc4f0; font-size: 27rpx; letter-spacing: 4rpx; }
.rec-remove { padding: 8rpx 12rpx; color: #ff7f92; font-size: 30rpx; }
.btn { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 22rpx; border-radius: 40rpx; background: #102536; border: 1rpx solid rgba(166, 211, 238, .22); color: #a8c5d5; font-size: 25rpx; }
