/* ---------------- 山岳世界（SVG 分片插画层：world.style === 'mountain'，全部数据驱动） ---------------- */
.m-sun {
  position: absolute;
  right: 12vw;
  top: 10vh;
  width: 16vmin;
  height: 16vmin;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, #fff8df 0%, #ffe97a 46%, rgba(255,214,120,0.22) 76%, rgba(255,214,120,0) 82%);
  box-shadow: 0 0 70rpx 24rpx rgba(255,214,120,0.4);
  transition: opacity 0.4s linear;
  pointer-events: none;
  z-index: 1;
}

/* 分片插画：全幅等比（mode:aspectFill），随视差 / 缩放 / 透明度驱动 */
.plate {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  will-change: transform, opacity;
}
.pl {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
/* 三景全屏背景：真实 DEM 渲染，按深度叠加。
   上/下越界 12%：给轻微视差留余量，位移时不露底 */
.view {
  will-change: opacity;
  top: -12%;
  height: 124%;
  transform-origin: 50% 100%;
}
.view-a { z-index: 2; }
.view-b { z-index: 3; }
.view-c { z-index: 4; }
.view-hero {
  top: 0;
  height: 100%;
  transform-origin: 50% 50%;
  z-index: 2;
}
/* 三张同一 DEM 的不同视角只取各自景别，避免整幅照片叠成双曝光：
   A 保留天空/远山，B 承载主路线山体，C 只作为底部近景冰壁。 */
.depth-far { clip-path: inset(0 0 38% 0); }
.depth-main { clip-path: inset(24% 0 0 0); }
.depth-near { clip-path: inset(56% 0 0 0); }
.pl-cloud { z-index: 5; }
.pl-ground { z-index: 6; }

/* Gate 3.3C.1：LIVE 实景层（Kala Patthar 等）——DEM 三景之上、HUD/顶部之下；
   默认透明，bindload 成功后淡入；binderror 由页面回退 DEM（WXML wx:if 移除）。
   crop 消费者：style object-position（焦点）＋ zoom（scale）→ 不做随机二次裁切；
   全屏盒（覆盖 .view 的视差顶部留白）＋中心缩放原。 */
.view-live {
  top: 0;
  height: 100%;
  transform-origin: 50% 50%;
  z-index: 6;
  opacity: 0;
  will-change: opacity;
  transition: opacity 0.22s ease;
}
.view-live-on { opacity: 1; }

/* Gate 3.3C.1 P0：LIVE 不可用兜底——有意的本地珠峰实拍全屏 cover；
   （覆盖 DEM 三景之上 z5；杜绝空白渐变 / 毛刺残片；底部交给 exp-sheet-fade 压暗） */
.view-fallback {
  top: 0;
  height: 100%;
  transform: none;
  transform-origin: 50% 50%;
  z-index: 5;
}

/* Gate 3.3C：LIVE 上的路线折线（合成层·不响应手势） */
.live-route {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 8;
  pointer-events: none;
  overflow: visible;
}
.live-route-seg {
  position: absolute;
  height: 5rpx;
  margin-top: -2rpx;
  margin-left: -2rpx;
  transform-origin: 50% 50%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(96, 165, 250, 0.35), rgba(96, 165, 250, 0.9));
  box-shadow: 0 0 8rpx rgba(56, 132, 255, 0.55);
}
.live-route-anchor {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid rgba(62, 132, 255, 0.9);
  box-shadow: 0 0 6rpx rgba(59, 132, 255, 0.6);
  transition: opacity 0.3s ease;
}
.live-route-anchor-tag {
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  transform: translateX(-50%);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #fff;
  background: rgba(10, 30, 60, 0.72);
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.live-route-dot {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  margin: -13rpx 0 0 -13rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff 0%, #4ea8ff 45%, rgba(46, 120, 255, 0.95) 100%);
  box-shadow: 0 0 10rpx rgba(78, 168, 255, 0.9), 0 0 2rpx #fff;
}
.live-route-chip {
  position: absolute;
  right: calc(16rpx + env(safe-area-inset-right));
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(10, 30, 60, 0.55);
  letter-spacing: 1rpx;
  z-index: 9;
}

/* Gate 3.4：TERRAIN 科学地形上的路线重投影（2.5D 帆布，z7 在 live-route 之下，避免与 LIVE 重叠）。
   画的是真实 terrain 路线点的全景折线，与 LIVE 校准扇线、示意直段不同；配色保持克制的冰川青；
   坐标消耗与 live-route 同构（x/y 百分位 + 斜段 rotate），当前点/峰顶旗均为真实投影。 */
.terrain-route {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 7; /* 低于 live-route(8)，避免在 LIVE 时重叠盖住实景折线 */
  pointer-events: none;
  overflow: visible;
}
.terrain-route-seg {
  position: absolute;
  height: 6rpx;
  margin-top: -3rpx;
  margin-left: -3rpx;
  transform-origin: 50% 50%;
  border-radius: 3rpx;
  background: repeating-linear-gradient(90deg, rgba(151, 241, 255, 0.95) 0 18rpx, rgba(151, 241, 255, 0.18) 18rpx 31rpx);
  box-shadow: 0 0 9rpx rgba(92, 215, 255, 0.5);
}
.terrain-route-seg-completed {
  background: linear-gradient(90deg, #fff0ad, #ffd36a 68%, #8fe9ff);
  box-shadow: 0 0 12rpx rgba(255, 205, 91, 0.86), 0 0 4rpx rgba(255,255,255,0.95);
}
.terrain-route-anchor {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid rgba(143, 237, 255, 0.95);
  box-shadow: 0 0 6rpx rgba(92, 215, 255, 0.6);
}
.terrain-route-anchor-tag {
  display: none;
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  transform: translateX(-50%);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #fff;
  background: rgba(40, 26, 6, 0.72);
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.terrain-route-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff 0%, #9ff3ff 45%, rgba(42, 187, 235, 0.95) 100%);
  box-shadow: 0 0 10rpx rgba(92, 215, 255, 0.9), 0 0 2rpx #fff;
}
.terrain-route-dot-moving { animation: terrainMarkerPulse 0.85s ease-in-out infinite; }
@keyframes terrainMarkerPulse { 0%, 100% { transform: scale(.82); opacity: .82; } 50% { transform: scale(1.25); opacity: 1; } }
.terrain-route-summit {
  position: absolute;
  transform: translate(-50%, -100%);
  color: #b9f5ff;
  font-size: 22rpx;
  text-shadow: 0 0 8rpx rgba(92, 215, 255, 0.9), 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}
.terrain-route-chip {
  position: absolute;
  right: calc(16rpx + env(safe-area-inset-right));
  bottom: calc(40vh + 24rpx);
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  color: rgba(255, 240, 200, 0.88);
  background: rgba(46, 24, 4, 0.55);
  letter-spacing: 1rpx;
  z-index: 9;
}
.live-info-chip {
  position: absolute;
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(10, 30, 60, 0.7);
  letter-spacing: 1rpx;
  z-index: 22;
  pointer-events: none;
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Gate 3.3C：LIVE / TERRAIN(DEM) 切换（右上角、低打扰胶囊） */
.vis-toggle {
  position: absolute;
  /* Gate 3.3C.1 P0：右侧位置由内联 right:{{capRight}}px 驱动（胶囊左缘外 8px）；
     此备选值仅在内联样式缺失的首帧生效，避免与原生胶囊重叠 */
  right: 100rpx;
  display: flex;
  gap: 2rpx;
  padding: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 26rpx;
  background: rgba(10, 20, 40, 0.42);
  backdrop-filter: blur(10rpx);
  z-index: 36;
  pointer-events: auto;
}
.vis-toggle-item {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  border-radius: 22rpx;
  letter-spacing: 1rpx;
  transition: color 0.2s ease, background 0.2s ease;
}
.vis-toggle-item.vis-on {
  color: #101a28;
  background: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}
/* LIVE 被兑底（实景不可用）：不发虚假“实景”；t半暗 + 文案已由 WXML 切换 */
.vis-toggle-item.vis-unavailable {
  color: rgba(255, 255, 255, 0.38);
  background: rgba(255, 255, 255, 0.06);
}

/* 指标折叠按钮 */
.metric-more {
  color: #ffe9b0;
  background: rgba(70, 60, 30, 0.42);
  border: 1rpx solid rgba(255, 233, 176, 0.35);
}

/* 阶段卡标题行（名称 + 自然带） */
.stage-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

/* ---------------- 山体内攀登路线 ---------------- */
.scene-route { position: absolute; inset: 0; z-index: 7; pointer-events: none; }
.route-segment { position: absolute; height: 7rpx; margin-top: -3.5rpx; border-radius: 8rpx; transform-origin: 0 50%; }
.route-segment-muted { background: rgba(255,232,179,0.34); box-shadow: 0 1rpx 3rpx rgba(19,31,49,0.52); }
.route-segment-completed { background: linear-gradient(90deg,#ffd47a,#fff1bd); box-shadow: 0 0 10rpx rgba(255,202,91,0.72); }
.route-waypoint { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8rpx; transform: translate(-50%,-50%); pointer-events: auto; }
.route-waypoint-dot { width: 18rpx; height: 18rpx; border: 3rpx solid rgba(255,248,222,0.94); border-radius: 50%; background: rgba(45,61,77,0.76); color: #184f50; font-size: 14rpx; line-height: 18rpx; text-align: center; box-shadow: 0 1rpx 8rpx rgba(9,19,34,0.72); }
.route-waypoint-label { display: flex; flex-direction: column; gap: 1rpx; padding: 3rpx 7rpx; border-radius: 7rpx; background: rgba(9,21,36,0.48); text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.7); }
.route-waypoint-name { color: rgba(255,247,225,0.82); font-size: 17rpx; font-weight: 600; white-space: nowrap; }
.route-waypoint-alt { color: #ffe09a; font-size: 14rpx; }
.route-waypoint-completed .route-waypoint-dot { background: #ffe19a; border-color: #fff5d5; }
.route-waypoint-current .route-waypoint-dot { width: 22rpx; height: 22rpx; line-height: 22rpx; border-color: #fff8da; background: #ffc85f; box-shadow: 0 0 0 8rpx rgba(255,197,83,0.26),0 0 16rpx rgba(255,215,122,0.9); }
.route-waypoint-current .route-waypoint-label { background: rgba(35,37,30,0.76); }
.route-waypoint-current .route-waypoint-name { color: #fff5cf; }
.route-waypoint-upcoming { opacity: 0.8; }
.route-current { position: absolute; z-index: 3; width: 30rpx; height: 30rpx; margin: -15rpx 0 0 -15rpx; border: 2rpx solid rgba(255,243,200,0.92); border-radius: 50%; background: rgba(255,192,75,0.22); box-shadow: 0 0 0 8rpx rgba(255,200,95,0.16),0 0 18rpx rgba(255,209,112,0.92); animation: routePulse 1.7s ease-in-out infinite; }
.route-current-core { position: absolute; left: 50%; top: 50%; width: 10rpx; height: 10rpx; margin: -5rpx; border-radius: 50%; background: #fff8d7; }
@keyframes routePulse { 0%,100% { transform: scale(0.86); opacity: .78; } 50% { transform: scale(1.14); opacity: 1; } }

.route-status { position: absolute; top: calc(env(safe-area-inset-top) + 250rpx); left: 28rpx; display: flex; align-items: baseline; gap: 10rpx; max-width: 500rpx; z-index: 10; padding: 8rpx 14rpx; border: 1rpx solid rgba(255,226,151,0.24); border-radius: 14rpx; background: rgba(11,22,37,0.38); backdrop-filter: blur(8rpx); text-shadow: 0 1rpx 5rpx rgba(0,0,0,0.5); }
.route-status-k { color: rgba(255,255,255,0.62); font-size: 18rpx; }
.route-status-current { color: #fff0bd; font-size: 21rpx; font-weight: 700; }
.route-status-next { color: rgba(255,255,255,0.76); font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.summit-route-finish { position: absolute; left: 28rpx; bottom: calc(env(safe-area-inset-bottom) + 220rpx); z-index: 12; padding: 10rpx 16rpx; border: 1rpx solid rgba(255,234,173,.4); border-radius: 14rpx; color: #fff1be; font-size: 21rpx; background: rgba(10,27,52,.52); text-shadow: 0 1rpx 5rpx rgba(0,0,0,.65); }

/* 右侧 Rail 仅作弱化后的路线概览。 */
.rail { top: 31%; bottom: 33%; width: 76rpx; opacity: .74; }
.rail-track { width: 4rpx; margin-left: -2rpx; border-radius: 2rpx; background: rgba(255,245,221,0.2); }
.rail-fill { width: 4rpx; margin-left: -2rpx; border-radius: 2rpx; background: linear-gradient(180deg,#ffd47a,#fff1bd); }
.rail-node { width: 116rpx; }
.rail-elev { font-size: 16rpx; color: rgba(255,247,226,0.74); }
.rn-completed { color: #fff5d4; background: rgba(235,178,69,0.48); }
.rn-current { color: #fff; background: rgba(255,204,99,0.62); animation: railBlink 1.2s ease-in-out infinite; }
.rn-upcoming { color: rgba(255,247,226,0.56); background: rgba(255,245,220,0.1); }

/* ==========================================================================
   路线模式（Gate 3：Expedition 附件 → 真实路线驱动）HUD
   地形优先：山体场景在全屏，底部约 30% 为高对比度暗色面板（死亡区再降饱和度）。
   ========================================================================== */
.route-mode .hint {
  bottom: calc(env(safe-area-inset-bottom) + 40vh + 18rpx);
}

/* ---- 顶部：登山标题 ---- */
.exp-top {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 20rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
  z-index: 10;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.55);
}
.exp-top-title {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
}
.exp-top-meta {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.66);
  letter-spacing: 1rpx;
}
.exp-back { flex-shrink: 0; color: #fff; font-size: 62rpx; line-height: 36rpx; }
.exp-top-copy { display: flex; flex-direction: column; gap: 3rpx; }
.exp-top-elev { margin-left: auto; color: #f5fbff; font-size: 24rpx; font-weight: 700; }
.exp-top-status { margin-top: 4rpx; color: #62c7f7; font-size: 17rpx; }

/* 底部 30% 面板：视觉应向“轻量 overlay”收敛（背景更通透，层级仍主/次/路线） */
.exp-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40vh;
  box-sizing: border-box;
  padding: 14rpx 26rpx calc(env(safe-area-inset-bottom) + 14rpx);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: linear-gradient(180deg, rgba(14, 20, 34, 0.82), rgba(4, 7, 14, 0.92) 58%), linear-gradient(180deg, rgba(10, 16, 28, 0.55), rgba(5, 8, 14, 0.72) 55%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(12rpx);
  z-index: 11;
  color: #ecf1f7;
  overflow: hidden;
}

/* Gate 3.3C.1 P1：hero 照片→exp-sheet 接缝暗化渐变（置于面板上缘上方，透明→暗，跨接缝消硬边） */
.exp-sheet-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 40vh; /* 面板上缘 */
  height: 22vh;
  pointer-events: none;
  z-index: 10;
  background: linear-gradient(
    180deg,
    rgba(8, 13, 26, 0) 0%,
    rgba(8, 13, 26, 0.22) 42%,
    rgba(6, 10, 20, 0.55) 74%,
    rgba(6, 9, 18, 0.86) 100%
  );
}

/* ---- 当前位置 ---- */
.exp-pos {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}
.exp-pos-l { display: flex; align-items: baseline; gap: 6rpx; }
.exp-elev {
  font-size: 70rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}
.exp-elev-unit { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-left: 4rpx; }
.exp-pos-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.exp-current-copy { display: flex; flex-direction: column; gap: 3rpx; padding: 2rpx 0; }
.exp-current-k { color: rgba(255,255,255,0.5); font-size: 17rpx; }
.exp-current-desc { color: rgba(255,255,255,0.74); font-size: 19rpx; line-height: 1.35; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 距顶峰：单行精简（去卡片，青色弱化） */
.exp-goal {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 4rpx;
  padding-top: 2rpx;
}
.exp-goal-row { display: flex; align-items: baseline; gap: 8rpx; }
.exp-goal-k { font-size: 18rpx; color: rgba(255,255,255,0.6); }
.exp-goal-v { font-size: 24rpx; font-weight: 700; color: #bde9ff; font-variant-numeric: tabular-nums; }

/* 路线进度条（青色，微调 03 的 cyan bar） */
.exp-route { display: flex; flex-direction: column; gap: 4rpx; }
.exp-route-track {
  position: relative;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.14);
  overflow: visible;
}
.exp-route-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #2e9cff, #5ec2ff);
  transition: width 0.08s linear;
}
.exp-route-marker {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border: 3rpx solid #3dabff;
  box-shadow: 0 0 8rpx rgba(61, 171, 255, 0.9);
}
.exp-route-meta { display: flex; justify-content: space-between; align-items: baseline; }
.exp-route-label { font-size: 17rpx; color: rgba(255,255,255,0.55); }
.exp-route-pct { font-size: 22rpx; font-weight: 800; color: #a7e2ff; font-variant-numeric: tabular-nums; }
.exp-route-hint { display: block; padding-top: 8rpx; text-align: center; color: rgba(222, 239, 255, 0.62); font-size: 18rpx; letter-spacing: 1rpx; }

/* 下一站（一行） */
.exp-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.exp-step-k { font-size: 18rpx; color: rgba(255,255,255,0.55); }
.exp-step-name {
  font-size: 20rpx;
  font-weight: 700;
  color: #d9e8ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.exp-step-gap { font-size: 17rpx; color: rgba(255,255,255,0.5); margin-left: auto; }
.exp-links { display: flex; justify-content: space-between; padding: 2rpx 4rpx; color: #8fcdf1; font-size: 18rpx; }
.exp-links text { padding: 6rpx 4rpx; }

/* 阶段 + 环境三指标 */
.exp-core {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
}
.exp-stage {
  flex: 1 1 58%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0;
  min-width: 0;
}
.exp-stage-emoji { font-size: 30rpx; }
.exp-stage-txt { display: flex; flex-direction: column; min-width: 0; }
.exp-stage-name {
  font-size: 21rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.exp-env {
  flex: 1 1 42%;
  display: flex;
  gap: 4rpx;
  align-items: flex-end;
  justify-content: flex-end;
}
.exp-env-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  min-width: 0;
  max-width: 130rpx;
}
.exp-env-k { font-size: 15rpx; color: rgba(255,255,255,0.45); }
.exp-env-v {
  font-size: 20rpx;
  font-weight: 700;
  color: #bde9ff;
  font-variant-numeric: tabular-nums;
}

/* 死亡区：克制变化（面板整体降饱和 + 细红描边 + 文案），不弹窗 */
.exp-sheet.exp-death {
  background: linear-gradient(180deg, rgba(20, 15, 15, 0.82), rgba(10, 6, 6, 0.92) 96%);
  border-top: 1rpx solid rgba(255, 120, 100, 0.28);
}
.exp-death .exp-env-v,
.exp-death .exp-goal-v { color: #ffb49a; }
.exp-death .exp-route-fill { background: linear-gradient(90deg, #b0604a, #e0a060); }
.exp-death .exp-route-pct { color: #ffb49a; }
.exp-death-strip {
  margin-top: 2rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-size: 17rpx;
  color: rgba(255, 180, 154, 0.85);
  background: rgba(120, 50, 40, 0.22);
  border: 1rpx solid rgba(255, 120, 100, 0.25);
}

/* 底部操作 */
.exp-actions {
  display: flex;
  gap: 12rpx;
  margin-top: auto;
}
.exp-ctl {
  flex: 1;
  height: 68rpx;
  border-radius: 20rpx;
  border: none;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 68rpx;
  padding: 0;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.exp-ctl::after { border: none; }
.exp-ctl:active { opacity: 0.85; transform: scale(0.97); }
.exp-ctl-down {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.85);
}
.exp-ctl-route {
  background: rgba(96, 156, 255, 0.24);
  border: 1rpx solid rgba(150, 200, 255, 0.5);
}
.exp-ctl-up {
  background: linear-gradient(135deg, #2e9cff, #1f6fe0);
  border: 1rpx solid rgba(150, 210, 255, 0.65);
  box-shadow: 0 4rpx 0 #0f4b9e;
}

/* ---- 峰顶轻提示（非庆祝弹层；地形优先） ---- */
.exp-summit-pill {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 118rpx);
  left: 28rpx;
  right: 28rpx;
  z-index: 14;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(8, 14, 24, 0.72);
  border: 1rpx solid rgba(170, 220, 255, 0.45);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.4);
}
.exp-summit-txt { display: flex; align-items: baseline; justify-content: space-between; }
.exp-summit-alt { font-size: 40rpx; font-weight: 800; color: #bfe9ff; font-variant-numeric: tabular-nums; }
.exp-summit-note { font-size: 24rpx; color: #fff; font-weight: 600; }
.exp-summit-actions { display: flex; gap: 16rpx; margin-top: 4rpx; }
.exp-summit-act {
  font-size: 20rpx;
  color: #bcd8ff;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(120, 170, 255, 0.18);
}
.exp-summit-act:active { opacity: 0.8; }

/* ===== 路线全景 rou-*（替代“敬请期待”占位的真实数据全景 sheet） ===== */
.rou-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 26, 14, 0.52);
}
.rou-card {
  width: 90vw;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background: #fffdf3;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(31, 26, 14, 0.35);
}
.rou-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}
.rou-title { font-size: 32rpx; font-weight: 700; color: #2a2b20; }
.rou-close { padding: 8rpx 16rpx; font-size: 30rpx; color: #94896a; }
.rou-intro {
  padding: 2rpx 28rpx 16rpx;
  font-size: 23rpx;
  color: #6a5f47;
  line-height: 1.55;
}
.rou-stats {
  display: flex;
  margin: 0 28rpx 14rpx;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  background: #f6ead1;
}
.rou-stat { flex: 1; text-align: center; }
.rou-stat-v { display: block; font-size: 28rpx; font-weight: 700; color: #a06a10; }
.rou-stat-k { display: block; margin-top: 2rpx; font-size: 20rpx; color: #94896a; }
.rou-ends {
  display: flex;
  justify-content: space-between;
  padding: 0 28rpx 10rpx;
}
.rou-profile {
  position: relative;
  height: 128rpx;
  margin: 4rpx 28rpx 8rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: rgba(31, 45, 58, 0.08);
  border: 1rpx solid rgba(151, 124, 66, 0.16);
}
.rou-profile-grid {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(151, 124, 66, 0.14);
}
.rou-profile-grid-a { top: 24%; }
.rou-profile-grid-b { top: 56%; }
.rou-profile-grid-c { top: 88%; }
.rou-profile-bar {
  position: absolute;
  width: 2rpx;
  min-height: 2rpx;
  background: linear-gradient(180deg, #2d9cf4, rgba(45, 156, 244, 0.22));
  transform: translateX(-1rpx);
}
.rou-profile-dot {
  position: absolute;
  left: 50%;
  top: -5rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: #5ec2ff;
  box-shadow: 0 0 0 3rpx rgba(45, 156, 244, 0.14);
}
.rou-profile-label {
  position: absolute;
  font-size: 17rpx;
  color: #94896a;
}
.rou-profile-label-low { left: 10rpx; bottom: 7rpx; }
.rou-profile-label-high { right: 10rpx; top: 7rpx; color: #547ba3; }
.rou-end { font-size: 22rpx; color: #4a4230; }
.rou-end-right { color: #a06a10; font-weight: 600; }
.rou-scroll { flex: 1; min-height: 0; padding: 0 28rpx; }
.rou-sec-title {
  display: block;
  margin: 18rpx 0 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #3a3a2e;
  border-bottom: 1rpx solid #eee2c6;
  padding-bottom: 8rpx;
}
.rou-item {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2ead4;
}
.rou-item.summit { background: rgba(160, 106, 16, 0.06); }
.rou-item-emoji { font-size: 26rpx; }
.rou-dot { font-size: 14rpx; color: #b98a3a; padding-top: 8rpx; }
.rou-item-main { flex: 1; min-width: 0; }
.rou-item-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; }
.rou-item-name { font-size: 25rpx; font-weight: 600; color: #2a2b20; }
.rou-item-km { font-size: 20rpx; color: #a06a10; white-space: nowrap; }
.rou-item-range { display: block; font-size: 20rpx; color: #94896a; margin-top: 2rpx; }
.rou-item-intro { display: block; font-size: 21rpx; color: #6a5f47; line-height: 1.5; margin-top: 4rpx; }
.rou-psrc { display: block; font-size: 20rpx; color: #94896a; line-height: 1.6; }
.rou-btn {
  margin: 16rpx 28rpx 24rpx;
  font-size: 26rpx;
  line-height: 2.6;
  border-radius: 999rpx;
  color: #fffdf3;
  background: linear-gradient(135deg, #b27c1d, #8a5e12);
}
.rou-btn::after { border: none; }
.rou-btn:active { transform: translateY(3rpx); }
