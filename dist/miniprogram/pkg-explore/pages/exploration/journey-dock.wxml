<block wx:if="{{journey}}">
  <view class="journey-view-switch" style="top:{{capBottom + 14}}px" catchtouchmove="noop">
    <button class="journey-view-button {{journeyView === 'overview' ? 'journey-view-active' : ''}}" data-view="overview" bindtap="onJourneyView">整条路线</button>
    <button class="journey-view-button {{journeyView === 'focus' ? 'journey-view-active' : ''}}" data-view="focus" bindtap="onJourneyView">{{worldOcean ? '当前水层' : '当前位置'}}</button>
    <text class="journey-view-position">第 {{journey.index}} / {{journey.count}} 站</text>
  </view>
  <view class="journey-dock {{worldOcean ? 'journey-dock-ocean' : ''}} {{worldCanyon ? 'journey-dock-canyon' : ''}}" catchtouchmove="noop">
    <view class="journey-location" bindtap="onInspectCurrent" role="button" aria-label="查看当前位置的发现">
      <view class="journey-location-copy"><text class="journey-eyebrow">{{journey.complete ? 'EXPEDITION COMPLETE · 探索完成' : expMoving || expClimbing ? 'EXPLORING · 正在前进' : 'YOU ARE HERE · 当前所在'}}</text><text class="journey-place">{{journey.currentName}} <text class="journey-discover-arrow">›</text></text></view>
      <view class="journey-measure"><text class="journey-measure-value">{{worldCanyon ? journey.nodes[journey.index - 1].value : expedition.currentElevText}}</text><text class="journey-measure-unit">{{journey.axisLabel}} m</text></view>
    </view>
    <view class="journey-stations">
      <view class="journey-stations-line"></view>
      <view class="journey-stations-fill" style="width:{{journey.stripPercent}}%"></view>
      <view wx:for="{{journey.nodes}}" wx:key="id" class="journey-mini-station mini-{{item.state}}" data-id="{{item.id}}" catchtap="onTapExpeditionWaypoint" role="button" aria-label="{{item.fullName}}"><view class="journey-mini-dot"></view><text>{{item.number}}</text></view>
    </view>
    <view wx:if="{{worldOcean}}" class="journey-telemetry"><text>水压 <text class="telemetry-value">≈ {{mariana.pressureText}}</text></text><text>光照 <text class="telemetry-value">{{mariana.lightText}}</text></text><text>水温 <text class="telemetry-value">≈ {{mariana.temperatureText}}</text></text></view>
    <view wx:else class="journey-telemetry"><text>{{worldCanyon ? '下切深度' : '距终点'}} <text class="telemetry-value">{{worldCanyon ? expedition.currentElevText + ' m' : expedition.remainingRouteText}}</text></text><text>{{expDeathZone ? '死亡区 · 含氧不足 1/3' : expedition.stageName}}</text></view>
    <view wx:if="{{worldFuji || worldOcean}}" class="journey-preview journey-field-note" catchtap="onInspectCurrent" role="button" aria-label="查看当前位置 {{journey.currentShortName}} 的沿途记录">
      <image wx:if="{{journey.currentImage}}" class="journey-preview-image" mode="aspectFill" src="{{journey.currentImage}}"></image>
      <view wx:else class="journey-preview-image journey-preview-placeholder"><text>记录</text></view>
      <view class="journey-preview-copy">
        <text class="journey-discovery-label">FIELD NOTE · {{journey.currentShortName}}</text>
        <text class="journey-discovery-text">{{journey.observation}}</text>
      </view>
      <text class="journey-discover-arrow">›</text>
    </view>
    <view wx:elif="{{!journey.complete}}" class="journey-preview" catchtap="onInspectNext" role="button" aria-label="查看下一站 {{journey.nextName}} 的行前介绍">
      <image wx:if="{{journey.nextImage}}" class="journey-preview-image" mode="aspectFill" src="{{journey.nextImage}}"></image>
      <view wx:else class="journey-preview-image journey-preview-placeholder"><text>路线</text></view>
      <view class="journey-preview-copy">
        <text class="journey-discovery-label">下一站预览 · {{journey.nextShortName}}</text>
        <text class="journey-discovery-text">{{journey.nextPreview}}</text>
      </view>
      <text class="journey-discover-arrow">›</text>
    </view>
    <view wx:else class="journey-discovery" bindtap="onInspectCurrent" role="button">
      <text class="journey-discovery-label">沿途发现</text>
      <text class="journey-discovery-text">{{journey.observation}}</text><text class="journey-discover-arrow">›</text>
    </view>
    <view class="journey-next"><text>{{journey.complete ? '已完成整条路线 · ' + journey.count + ' 个站点' : '下一站 · ' + journey.nextName}}</text><text>{{journey.complete ? '100%' : worldOcean ? journey.nextDepth + ' m 深' : expedition.nextGapText}}</text></view>
    <view class="journey-actions">
      <button class="journey-back" catchtap="onStepDown" disabled="{{expClimbing || journey.overallPercent === 0}}">{{worldOcean ? '上浮一站' : '返回一站'}}</button>
      <button wx:if="{{journey.complete}}" class="journey-forward" catchtap="onJourneySummary">查看探索报告</button>
      <button wx:else class="journey-forward" catchtap="onContinueJourney" disabled="{{expClimbing}}">{{expClimbing ? expClimbLabel : '前往' + journey.nextShortName + (worldOcean || worldCanyon ? ' ↓' : ' ↑')}}</button>
    </view>
  </view>
</block>
