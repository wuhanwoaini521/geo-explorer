<view wx:if="{{ready}}" class="page {{routeMode ? 'route-mode' : ''}} {{worldOcean ? 'ocean-mode' : ''}} {{worldCanyon ? 'canyon-mode' : ''}} {{worldFuji ? 'world-fuji' : ''}} journey-page journey-{{journeyView}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
  <!-- ===== 环境图层（共享天空：数据驱动自引擎） ===== -->
  <view class="layer-sky" style="background:{{skyGradient}}"></view>

  <!-- ===== 1. 山岳世界（worldMountain：真实 DEM 三景按深度叠加） ===== -->
  <block wx:if="{{worldMountain}}">
    <!-- Gate 3.4：自制远征主视觉；与路线共享同一相机视图（transform-origin=marker 锚点） -->
    <image wx:if="{{scene.plates.hero}}" class="plate view view-hero" mode="aspectFill" src="{{scene.plates.hero}}" style="transform:{{routeLayerTransform}};transform-origin:{{routeAnchorX}}% {{routeAnchorY}}%; opacity:{{scene.op.main || 1}}"></image>

    <!-- 视图 A：远景全景（徒步→BC）：下锚缩放至 DEM 山体带，天空不再占用主体 -->
    <image wx:if="{{scene.plates.far && scene.op.far > 0}}" class="plate view view-a depth-far" mode="aspectFill" src="{{scene.plates.far}}" style="transform:{{camera.farTransform}} translate3d(0,-{{par.far * 0.25}}px,0) scale({{viewZoom.a}}); opacity:{{scene.op.far}}"></image>

    <!-- 视图 B：中景山脊（冰瀑→C3），随海拔缓推进（缩放=裁剪基准 × 渐进） -->
    <image wx:if="{{scene.plates.main && scene.op.main > 0}}" class="plate view view-b depth-main" mode="aspectFill" src="{{scene.plates.main}}" style="transform:{{camera.mainTransform}} translate3d(0,-{{par.mid * 0.15}}px,0) scale({{viewZoom.b * (1 + (mntScale - 100) / 260)}}); opacity:{{scene.op.main}}"></image>

    <!-- 视图 C：死亡区冰岩壁（冲顶段） -->
    <image wx:if="{{scene.plates.mid && scene.op.mid > 0}}" class="plate view view-c depth-near" mode="aspectFill" src="{{scene.plates.mid}}" style="transform:{{camera.nearTransform}} translate3d(0,-{{par.near * 0.15}}px,0) scale({{viewZoom.c}}); opacity:{{scene.op.mid}}"></image>

    <!-- 云海 / 云丝带（已下架：与照片级渲染风格冲突，保留图层结构） -->
    <image wx:if="{{scene.plates.cloud}}" class="plate pl-cloud" mode="aspectFit" src="{{scene.plates.cloud}}" style="transform:translate3d(0,-{{par.mid}}px,0); opacity:{{scene.op.cloud}}"></image>

    <!-- Gate 3.3C.1 P0：LIVE 不可用（visLiveFallback）→ 使用 TERRAIN 同源 hero 兜底 -->
    <image wx:if="{{routeMode && visLiveFallback && scene.plates.hero}}" class="plate view view-fallback" mode="aspectFill" src="{{scene.plates.hero}}" style="transform:{{routeLayerTransform}};transform-origin:{{routeAnchorX}}% {{routeAnchorY}}%"></image>

    <!-- Gate 3.3C.1：LIVE 实景层 -->
    <image wx:if="{{visLiveSrc}}" class="plate view view-live {{visLiveReady ? 'view-live-on' : ''}}" mode="aspectFill" src="{{visLiveSrc}}" style="object-position:{{liveCropUi.focusX}}% {{liveCropUi.focusY}}%; transform:{{routeLayerTransform}};transform-origin:{{routeAnchorX}}% {{routeAnchorY}}%;" bindload="onLiveImageLoad" binderror="onLiveImageError"></image>

    <!-- Gate 3.3C：LIVE 照片之上示意折线（仅非路线模式） -->
    <view wx:if="{{visLiveSrc && liveOverlay && !routeMode}}" class="live-route">
      <view wx:for="{{liveOverlay.segments}}" wx:key="index" class="live-route-seg" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.lengthX}}%;transform:rotate({{item.rotateDeg}}deg)"></view>
      <view wx:for="{{liveOverlay.origins}}" wx:key="key" class="live-route-anchor" style="left:{{item.x}}%;top:{{item.y}}%;opacity:{{item.label ? 1 : 0}}">
        <text class="live-route-anchor-tag" wx:if="{{item.label}}">{{item.label}}</text>
      </view>
      <view class="live-route-dot" style="left:{{liveOverlay.marker.x}}%;top:{{liveOverlay.marker.y}}%"></view>
      <view wx:if="{{liveOverlay.schematic}}" class="live-route-chip">示意路线</view>
    </view>

    <!-- §40：LIVE 实景数据说明一行 -->
    <view wx:if="{{liveInfo}}" class="live-info-chip">{{liveInfo}}</view>
  </block>

  <!-- ===== 2. 海洋世界：程序化垂直水柱，不以任务舱内照片冒充海沟或海床 ===== -->
  <block wx:elif="{{worldOcean}}">
    <include src="journey-ocean.wxml" />
  </block>

  <!-- ===== 3. 通用陆地世界（非山岳、非海洋：大峡谷等） ===== -->
  <block wx:else>
    <image wx:if="{{worldPhoto}}" class="world-photo" mode="aspectFill" src="{{worldPhoto}}" style="transform:translate3d(0,-{{par.ground * 0.4}}px,0)"></image>
    <block wx:if="{{!worldPhoto}}">
      <view class="ridge far" style="transform:translate3d(0,-{{par.far}}px,0)">
        <view class="peak peak-a">▲</view>
        <view class="peak peak-b">◥</view>
      </view>
      <view class="ridge mid" style="transform:translate3d(0,-{{par.mid}}px,0)">
        <view class="peak peak-c">△</view>
      </view>
      <view class="ground-wrap" style="transform:translate3d(0,-{{par.ground}}px,0)">
        <view class="ground-veg" style="opacity:{{vegetation}}; background:{{greenTint}}"></view>
        <view class="ground-snow" style="opacity:{{snowCover}}"></view>
        <view class="ground-main" style="background:linear-gradient(180deg,{{terrainTop}} 0%,{{terrainBottom}} 100%)"></view>
        <view class="ground-glare"></view>
      </view>
      <view class="flora-layer" style="transform:translate3d(0,-{{par.near}}px,0)"></view>
    </block>
  </block>

  <!-- ===== 4. 沉浸路线层（Terrain / Ocean-Conforming Route：山岳与海洋深潜通用） ===== -->
  <view wx:if="{{routeMode && !worldOcean && conceptRoute && conceptRouteMarker && routeLayerTransform}}" class="concept-route {{worldOcean ? 'concept-route-ocean' : ''}}" style="transform:{{routeLayerTransform}};transform-origin:{{routeAnchorX}}% {{routeAnchorY}}%">
    <!-- 未来路线：弱化浅色线（近端更粗更亮 / 远端更细更淡，形成空间远近感） -->
    <view wx:for="{{conceptRoute.segments}}" wx:key="id" class="concept-route-seg concept-route-seg-base" style="{{item.style}}"></view>
    <!-- 已走路线：点亮（含当前段的局部裁剪，跟随 marker） -->
    <view
      wx:for="{{conceptRoute.completedSegments}}"
      wx:key="id"
      class="concept-route-seg concept-route-seg-completed {{item.active ? 'concept-route-seg-active' : ''}}"
      style="{{item.style}}"
    ></view>
    <!-- Waypoint：路线上的真实地理节点（completed / current / upcoming 三种状态） -->
    <view
      wx:for="{{conceptRoute.points}}"
      wx:key="id"
      class="concept-route-point concept-route-point-{{item.state}} {{item.isSummit ? 'concept-route-point-summit' : ''}} {{worldOcean && item.isSummit ? 'concept-route-point-bottom' : ''}}"
      style="{{item.style}} transform:scale({{routeAnnotationScale}});transform-origin:50% 50%;"
      data-id="{{item.id}}"
      bindtap="onTapExpeditionWaypoint"
    >
      <view wx:if="{{item.isSummit && !worldOcean}}" class="concept-route-point-flag"><text class="concept-route-point-flag-cloth"></text></view>
      <view wx:if="{{item.isSummit && worldOcean}}" class="concept-route-bottom-target"></view>
      <view class="concept-route-point-dot"></view>
      <view class="concept-route-point-label">
        <text class="concept-route-point-name">{{item.shortName}}</text>
        <text wx:if="{{item.state !== 'upcoming'}}" class="concept-route-point-alt">{{item.altitudeText}}</text>
      </view>
    </view>
    <!-- 海洋使用极简科学探测器，陆地世界保留既有路线 marker。 -->
    <view class="concept-route-marker {{expMoving || expClimbing ? 'concept-route-marker-moving' : ''}}" style="left:{{conceptRouteMarker.x}}%;top:{{conceptRouteMarker.y}}%;transform:scale({{routeAnnotationScale}});transform-origin:50% 50%;">
      <view wx:if="{{worldOcean}}" class="mariana-probe">
        <view class="probe-antenna"></view>
        <view class="probe-body"><view class="probe-port"></view></view>
        <view class="probe-skid"></view>
      </view>
      <view wx:else class="concept-route-marker-core"></view>
      <text wx:if="{{routeMarkerAltText}}" class="concept-route-marker-tag">{{routeMarkerAltText}}</text>
    </view>
  </view>

  <!-- 场景内空间路线（旧非路线模式兼容） -->
  <view wx:if="{{route && scene.mode !== 'summit' && !routeMode}}" class="scene-route" aria-label="{{route.name}}">
    <view wx:for="{{route.segments}}" wx:key="id" class="route-segment route-segment-muted" style="{{item.style}}"></view>
    <block wx:for="{{route.segments}}" wx:key="id">
      <view wx:if="{{item.completed}}" class="route-segment route-segment-completed" style="{{item.completedStyle}}"></view>
    </block>
    <view
      wx:for="{{route.waypoints}}"
      wx:key="id"
      class="route-waypoint route-waypoint-{{item.state}}"
      style="{{item.style}}"
      data-id="{{item.id}}"
      bindtap="onTapRouteWaypoint"
    >
      <view class="route-waypoint-dot"><text wx:if="{{item.state === 'completed'}}">✓</text></view>
      <view class="route-waypoint-label">
        <text class="route-waypoint-name">{{item.shortName}}</text>
        <text wx:if="{{item.state === 'current'}}" class="route-waypoint-alt">{{item.altitudeText}}</text>
      </view>
    </view>
    <view class="route-current" style="{{route.currentStyle}}"><view class="route-current-core"></view></view>
  </view>
  <view wx:if="{{route && scene.mode === 'summit' && !routeMode}}" class="summit-route-finish">
    <text>✓ {{route.name}} · 已抵达 {{route.currentName}}</text>
  </view>

  <!-- 风雪粒子（强度=雪量，档位化；山岳 DEM 与实景照片自带氛围，不再叠加粒子避免盖脸） -->
  <view wx:if="{{!worldMountain && !worldPhoto && !worldOcean}}" class="snow-layer">
    <view wx:for="{{particles}}" wx:key="id" class="snow-flake" style="left:{{item.left}}%; width:{{item.size}}px; height:{{item.size}}px; animation-duration:{{item.duration}}s; animation-delay:{{item.delay}}s; opacity:{{item.opacity}}"></view>
  </view>

  <!-- 云雾罩（山岳 DEM 与实景照片自带氛围，不再叠加） -->
  <view wx:if="{{!worldMountain && !worldPhoto && !worldOcean}}" class="fog" style="opacity:{{fogOpacity}}"></view>

  <!-- ===== 路线模式 HUD（Gate 3：Expedition 附件 → 真实路线驱动；地形优先 + 底部 30% 暗色限流 UI） ===== -->
  <block wx:if="{{routeMode}}">
    <!-- 顶部：地貌观察标题（路线只作为观察顺序，不是登山导航） -->
    <view class="exp-top" style="top:{{capTop}}px">
      <text class="exp-back" bindtap="onBackHome">‹</text>
      <view class="exp-top-copy"><text class="exp-top-title">{{journey ? journey.sceneLabel : '地貌探索'}}</text><text class="exp-top-meta">{{metaPlace}}</text><text wx:if="{{expMoving || expMotionText}}" class="exp-top-status">{{expMotionText || (worldOcean ? '正在下潜' : worldCanyon ? '正在下降' : '正在切换观察点')}} · {{expedition.nextLandform}}</text></view>
      <text class="exp-top-elev">{{expedition.currentElevText}} m</text>
    </view>

    <!-- Gate 3.3C.1：LIVE 实景 / TERRAIN（DEM）切换（右上角低打扰；right 由 capRight 驱动，清开原生胶囊） -->
    <view wx:if="{{!worldOcean && !worldFuji}}" class="vis-toggle">
      <text class="vis-toggle-item {{visActive === 'LIVE' ? 'vis-on' : ''}} {{visLiveFallback ? 'vis-unavailable' : ''}}" data-mode="LIVE" bindtap="onToggleVisualMode">{{visLiveFallback ? '实景·不可用' : '实景'}}</text>
      <text class="vis-toggle-item {{visActive === 'TERRAIN' ? 'vis-on' : ''}}" data-mode="TERRAIN" bindtap="onToggleVisualMode">DEM</text>
    </view>

    <include src="journey-dock.wxml" />
    <include src="journey-canyon.wxml" />

    <!-- Gate 3.3C.1 P1：hero→面板 跨接缝照片暗化渐变（不挪/不加高面板；在面板上缘铺淡出，消除硬接缝） -->
    <view class="exp-sheet-fade"></view>

    <!-- 终点徽章：不遮住主地形，但必须让用户一眼确认旅程已完成。 -->
    <view wx:if="{{expSummit && expSummit.show && !worldOcean}}" class="exp-summit-pill">
      <view class="exp-summit-row">
        <view class="exp-summit-emblem {{worldOcean ? 'exp-bottom-emblem' : ''}}">
          <view wx:if="{{worldOcean}}" class="exp-bottom-ring"></view>
          <block wx:else>
          <view class="exp-summit-flag-pole"></view>
          <view class="exp-summit-flag"></view>
          </block>
        </view>
        <view class="exp-summit-copy">
          <text class="exp-summit-kicker">{{expTerminus.kicker}}</text>
          <text class="exp-summit-title">{{expTerminus.headline}}</text>
        </view>
        <text class="exp-summit-alt">{{worldOcean ? '深度 ' : worldCanyon ? '下切 ' : ''}}{{expSummit.altitudeText}} m</text>
      </view>
      <text class="exp-summit-note">{{expSummit.note}} · 路线完成 100%</text>
    </view>
  </block>

  <!-- ===== 顶部 HUD ===== -->
  <view wx:if="{{!routeMode}}" class="hud-top">
    <view class="hud-left">
      <text class="elevation-num">{{elevationText}}</text>
      <text class="elevation-unit">{{ui.axisUnit}}</text>
    </view>
    <view class="hud-right">
      <view class="hud-metrics">
        <text wx:for="{{metricsShow}}" wx:key="key" class="metric">{{item.label}} {{item.value}}{{item.unit}}</text>
        <text wx:if="{{metricsMore}}" class="metric metric-more" bindtap="onToggleMetrics">{{metricsOpen ? '收起 ▾' : '更多 ▸'}}</text>
      </view>
      <text class="hud-km">{{kmStage}}</text>
    </view>
  </view>

  <!-- 阶段信息卡（低打扰：名称 + 自然带宽 + 描述简述） -->
  <view wx:if="{{!routeMode}}" class="stage-card">
    <view class="stage-mark"><text>地貌</text></view>
    <view class="stage-main">
      <view class="stage-line">
        <text class="stage-name">{{stageName}}</text>
        <text class="stage-biome">{{biome}}</text>
      </view>
      <text class="stage-desc">{{stageDescription}}</text>
    </view>
    <text class="stage-next">{{nextStageName}}</text>
  </view>

  <view wx:if="{{route && !routeMode}}" class="route-status">
    <text class="route-status-k">当前位置</text>
    <text class="route-status-current">{{route.currentName}}</text>
    <text class="route-status-next">下一站 · {{route.nextName}}</text>
  </view>

  <!-- 进度条 -->
  <view wx:if="{{!routeMode}}" class="progress-row">
    <view class="progress-ico" aria-label="地貌进度"></view>
    <view class="progress-track"><view class="progress-bar" style="width:{{pct}}%"></view></view>
    <text class="progress-pct">{{pct}}<text class="pct-sign">%</text></text>
  </view>

  <!-- 底部操作条 -->
  <view wx:if="{{!routeMode}}" class="controls">
    <button class="ctl ctl-down" bindtap="onStepDown">
      <text class="ctl-glyph down">{{ui.backGlyph}}</text>
      <text class="ctl-label">{{ui.backLabel}}</text>
    </button>
    <view class="ctl-center">
      <text class="g-mark">GEO</text>
    </view>
    <button class="ctl ctl-up" bindtap="onStepUp">
      <text class="ctl-glyph up">{{ui.forwardGlyph}}</text>
      <text class="ctl-label">{{ui.forwardLabel}}</text>
    </button>
  </view>

  <!-- 知识提示条 -->
  <view wx:if="{{hint.show && !routeMode}}" class="hint" bindtap="onHintTap">
    <text class="hint-ico">i</text>
    <text class="hint-text">{{hint.text}}</text>
    <text class="hint-arrow">›</text>
  </view>

  <!-- 右侧 Rail 仅作路线概览；空间位置以山体内路线为准。 -->
  <view wx:if="{{route && !routeMode}}" class="rail">
    <view class="rail-track"></view>
    <view class="rail-fill" style="height:{{progress*100}}%"></view>
    <view
      wx:for="{{route.rail}}"
      wx:key="id"
      class="rail-node rail-node-{{item.state}}"
      style="top:{{item.top}}%"
      data-id="{{item.id}}"
      bindtap="onTapRouteWaypoint"
    >
      <text class="rail-elev">{{item.label}}</text>
      <text wx:if="{{item.state === 'completed'}}" class="rn rn-completed">✓</text>
      <text wx:elif="{{item.state === 'current'}}" class="rn rn-current">◎</text>
      <text wx:else class="rn rn-upcoming">·</text>
    </view>
    <text class="rail-cap rail-cap-top">{{expTerminus.top}}</text>
    <text class="rail-cap rail-cap-bottom">起点</text>
  </view>

  <!-- ===== 开始引导 ===== -->
  <view wx:if="{{intro}}" class="overlay intro">
    <view class="intro-card">
      <view class="ico"><text>GEO</text></view>
      <text class="intro-title">{{title}}</text>
      <text class="intro-sub">{{subtitle}}</text>
      <view class="intro-meta">
        <text class="meta-chip">{{metaPlace}} · {{metaRegion}}</text>
        <text class="meta-chip">地貌观察 · {{estMinutes}} 分钟</text>
      </view>
      <view class="intro-desc">{{metaDesc}}</view>
      <button class="btn-primary" bindtap="onStartClimb">开始探索</button>
      <view class="intro-hint">{{ui.advanceHint}}</view>
    </view>
  </view>

  <!-- 里程碑穿越提示（克制横幅；复用 stage-banner 样式） -->
  <view wx:if="{{milestoneBanner.show && !routeMode}}" class="stage-banner ms-banner">
    <view class="sb-mark"><text>地貌</text></view>
    <view class="sb-main">
      <text class="sb-name">{{milestoneBanner.title}}</text>
      <text class="sb-biome">{{milestoneBanner.biome}}</text>
    </view>
  </view>

  <!-- 自然带横幅 ===== -->
  <view wx:if="{{!routeMode && !milestoneBanner.show && stageBanner.show}}" class="stage-banner">
    <view class="sb-mark"><text>地貌</text></view>
    <view class="sb-main">
      <text class="sb-name">{{stageBanner.title}}</text>
      <text class="sb-biome">{{stageBanner.biome}}</text>
    </view>
  </view>

  <!-- ===== 路线全景（可真·数据，替代“敬请期待”） ===== -->
  <view wx:if="{{routeOverview && routeOverview.show}}" class="rou-mask" catchtouchmove="noop">
    <view class="rou-card">
      <view class="rou-head">
          <text class="rou-title">{{routeOverview.name}}</text>
        <text class="rou-close" bindtap="onCloseRouteOverview">✕</text>
      </view>
      <text class="rou-intro">{{routeOverview.intro}}</text>

      <view class="rou-stats">
        <view class="rou-stat">
          <text class="rou-stat-v">{{routeOverview.totalKmText}}</text>
          <text class="rou-stat-k">全程</text>
        </view>
        <view class="rou-stat">
          <text class="rou-stat-v">{{routeOverview.ascentText}}</text>
          <text class="rou-stat-k">{{routeOverview.ascentLabel}}</text>
        </view>
        <view class="rou-stat">
          <text class="rou-stat-v">{{routeOverview.descentText}}</text>
          <text class="rou-stat-k">{{routeOverview.descentLabel}}</text>
        </view>
      </view>

      <view class="rou-ends">
        <text class="rou-end">起点 · {{routeOverview.startName}} {{routeOverview.startElevText}}</text>
        <text class="rou-end rou-end-right">终点 · {{routeOverview.endName}} {{routeOverview.endElevText}}</text>
      </view>

      <view class="rou-profile">
        <view class="rou-profile-grid rou-profile-grid-a"></view>
        <view class="rou-profile-grid rou-profile-grid-b"></view>
        <view class="rou-profile-grid rou-profile-grid-c"></view>
        <view wx:for="{{routeOverview.elevationProfile}}" wx:key="x" class="rou-profile-bar" style="left:{{item.x}}%;top:{{item.top}}%;height:{{item.height}}%">
          <view class="rou-profile-dot"></view>
        </view>
        <text class="rou-profile-label rou-profile-label-low">路线起点</text>
        <text class="rou-profile-label rou-profile-label-high">{{routeOverview.profileLabel}}</text>
      </view>

      <scroll-view class="rou-scroll" scroll-y>
        <view class="rou-sec-title">{{routeOverview.stageLabel}}（{{routeOverview.stages.length}}）</view>
        <view class="rou-item" wx:for="{{routeOverview.stages}}" wx:key="index">
          <view class="rou-item-mark"><text>{{worldOcean ? '水层' : '地貌'}}</text></view>
          <view class="rou-item-main">
            <view class="rou-item-head">
              <text class="rou-item-name">{{item.index}}. {{item.name}}</text>
              <text class="rou-item-km">{{item.kmText}}</text>
            </view>
            <text class="rou-item-range">{{item.rangeText}}</text>
            <text class="rou-item-intro">{{item.intro}}</text>
          </view>
        </view>

        <view class="rou-sec-title">里程碑（{{routeOverview.milestones.length}}）</view>
        <view class="rou-item {{item.isSummit ? 'summit' : ''}}" wx:for="{{routeOverview.milestones}}" wx:key="name">
          <text class="rou-dot">●</text>
          <view class="rou-item-main">
            <view class="rou-item-head">
              <text class="rou-item-name">{{item.name}}</text>
              <text class="rou-item-km">{{item.kmText}}</text>
            </view>
            <text class="rou-item-range">{{item.kindLabel}} · {{item.elevText}}</text>
          </view>
        </view>

        <view wx:if="{{routeOverview.provenance.length}}" class="rou-ears">
          <text class="rou-sec-title">数据来源</text>
          <text class="rou-psrc" wx:for="{{routeOverview.provenance}}" wx:key="*this">· {{item}}</text>
        </view>
      </scroll-view>

      <button class="rou-btn" bindtap="onCloseRouteOverview">继续探索</button>
    </view>
  </view>

  <!-- ===== Waypoint Discovery Card（地点知识卡）=====
       到达山上的真实节点后解锁：地点名 / 英文名 / 海拔 / 实景图 / 地形类型 /
       简介 / 详细说明 / 知识要点。半高卡片，不永久遮挡山体：上方仍能看到
       路线与当前位置；图片可点击全屏查看（wx.previewImage）。 -->
  <view wx:if="{{waypointCard && waypointCard.show}}" class="wpd-sheet" catchtouchstart="noop" catchtouchmove="noop">
    <view class="wpd-grip" bindtap="onWaypointCardClose">
      <view class="wpd-grip-bar"></view>
    </view>

    <view class="wpd-head">
      <view class="wpd-head-copy">
        <text class="wpd-name">{{waypointCard.title}}</text>
        <text wx:if="{{waypointCard.titleEn}}" class="wpd-name-en">{{waypointCard.titleEn}}</text>
      </view>
      <view class="wpd-head-right">
        <text class="wpd-alt">{{waypointCard.altitudeText}}</text>
        <text wx:if="{{waypointCard.unlocked}}" class="wpd-unlocked">已到达</text>
        <text wx:else class="wpd-locked">行前预览</text>
      </view>
      <text class="wpd-close" bindtap="onWaypointCardClose">✕</text>
    </view>

    <scroll-view class="wpd-scroll" scroll-y>
      <view wx:if="{{waypointCard.image}}" class="wpd-media" bindtap="onPreviewWaypointImage">
        <image class="wpd-image" mode="aspectFill" src="{{waypointCard.image}}"></image>
        <view class="wpd-media-shade"></view>
        <text wx:if="{{waypointCard.imageKindLabel}}" class="wpd-media-kind">{{waypointCard.imageKindLabel}}</text>
        <text class="wpd-media-hint">查看大图 ↗</text>
        <view class="wpd-media-caption">
          <text class="wpd-media-caption-k">画面地点</text>
          <text class="wpd-media-caption-v">{{waypointCard.title}} · {{waypointCard.landform}}</text>
        </view>
        <view wx:if="{{waypointCard.imageCount > 1}}" class="wpd-dots">
          <view
            wx:for="{{waypointCard.images}}"
            wx:key="*this"
            class="wpd-dot {{waypointCard.imageIndex === index ? 'wpd-dot-on' : ''}}"
            data-index="{{index}}"
            catchtap="onWaypointImagePick"
          ></view>
        </view>
      </view>
      <text wx:if="{{waypointCard.imageCredit}}" class="wpd-credit">{{waypointCard.imageCredit}}</text>

      <view wx:if="{{waypointCard.whatToNotice}}" class="wpd-observe">
        <view class="wpd-observe-mark"></view>
        <view class="wpd-observe-copy">
          <text class="wpd-observe-k">看图提示</text>
          <text class="wpd-observe-v">{{waypointCard.whatToNotice}}</text>
        </view>
      </view>

      <view wx:if="{{waypointCard.terrain || waypointCard.landform}}" class="wpd-chips">
        <text wx:if="{{waypointCard.terrain}}" class="wpd-chip">{{waypointCard.terrain}}</text>
        <text class="wpd-chip wpd-chip-soft">{{waypointCard.landform}}</text>
      </view>

      <text class="wpd-desc">{{waypointCard.desc}}</text>

      <view wx:if="{{waypointCard.detail}}" class="wpd-more" bindtap="onToggleWaypointDetail">
        <text class="wpd-more-t">{{waypointCard.detailOpen ? '收起说明 ▴' : '展开说明 ▾'}}</text>
      </view>
      <text wx:if="{{waypointCard.detailOpen}}" class="wpd-detail">{{waypointCard.detail}}</text>

      <view wx:if="{{waypointCard.facts.length}}" class="wpd-facts">
        <text class="wpd-facts-title">知识要点</text>
        <view wx:for="{{waypointCard.facts}}" wx:key="*this" class="wpd-fact">
          <text class="wpd-fact-dot">·</text>
          <text class="wpd-fact-text">{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="wpd-actions">
      <button
        wx:if="{{waypointCard.unlocked && waypointCard.knowledgeId}}"
        class="wpd-btn wpd-btn-ghost"
        bindtap="onOpenWaypointKnowledge"
      >查看完整知识</button>
      <button wx:if="{{waypointCard.isNext && !waypointCard.unlocked}}" class="wpd-btn wpd-btn-primary" catchtap="onWaypointPreviewContinue">前往 {{waypointCard.title}}</button>
      <button wx:else class="wpd-btn wpd-btn-primary" bindtap="onWaypointCardClose">返回探索</button>
    </view>
  </view>

  <!-- ===== 知识卡（分层） ===== -->
  <knowledge-popup
    wx:if="{{openNode}}"
    visible="{{openNode ? true : false}}"
    node="{{openNode}}"
    axis-label="{{ui.axisLabel}}"
    axis-unit="{{ui.axisUnit}}"
    context-name="{{expedition.currentLandform}}"
    context-elevation="{{expedition.currentElevText}}"
    bind:close="onPopupClose"
    bind:continue="onPopupContinue"
  />

  <!-- ===== 随堂 Quiz（答错不阻断） ===== -->
  <view wx:if="{{quiz && quiz.show}}" class="quiz-mask" catchtouchmove="noop">
    <view class="quiz-card">
      <view class="quiz-head">
        <view class="quiz-ico"><text>知识</text></view>
        <text class="quiz-tag">随堂测验</text>
      </view>
      <text class="quiz-lead">{{quiz.lead}}</text>
      <text class="quiz-q">{{quiz.question}}</text>
      <view class="quiz-options">
        <view
          wx:for="{{quiz.options}}"
          wx:key="*this"
          class="quiz-opt {{quiz.selected === index ? 'sel' : ''}} {{quiz.revealed && quiz.selected === index && quiz.correct ? 'right' : ''}} {{quiz.revealed && quiz.selected === index && !quiz.correct ? 'wrong' : ''}}"
          data-index="{{index}}"
          bindtap="onQuizPick"
        >{{item}}</view>
      </view>
      <view wx:if="{{quiz.revealed}}" class="quiz-result">
        <text class="quiz-verdict">{{quiz.correct ? '✓ 回答正确' : '✗ 答错了也没关系'}}</text>
        <text class="quiz-explain">{{quiz.explanation}}</text>
      </view>
      <button wx:if="{{quiz.revealed}}" class="quiz-btn" bindtap="onQuizContinue">继续探索</button>
      <view wx:else class="quiz-skip" bindtap="onQuizClose">跳过（不影响进度）</view>
    </view>
  </view>

  <!-- ===== 终局庆祝 ===== -->
  <view wx:if="{{celebration}}" class="overlay celebration">
    <view class="celebrate-mark"><text>GEO</text></view>
    <text class="celebrate-title">{{destination.title}}</text>
    <text class="celebrate-elev">{{destination.tagline}}</text>
    <text class="celebrate-msg">{{metaPlace}} · {{ui.axisLabel}} {{maxElevationText}} {{ui.axisUnit}}</text>
  </view>

  <!-- ===== 登顶总结（含成就 + 三个动作） ===== -->
  <view wx:if="{{summit && summaryStats}}" class="overlay summit">
    <view class="summit-card">
      <view class="summit-head">
        <view class="summit-badge"><text>完成</text></view>
        <view class="summit-head-text">
          <text class="summit-title">探险完成！</text>
          <text class="summit-sub">你探索了 {{metaPlace}} · {{ui.extentWord}} {{summaryStats.maxText}} {{ui.axisUnit}}</text>
        </view>
      </view>

      <view class="summit-stats">
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.durationText}}</text>
          <text class="sstat-label">用时</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.unlocked}}/{{summaryStats.nodeTotal}}</text>
          <text class="sstat-label">知识点</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.quizText}}</text>
          <text class="sstat-label">随堂</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.accuracyText}}</text>
          <text class="sstat-label">正确率</text>
        </view>
      </view>

      <view class="summit-band">
        <text class="summit-band-t">{{ui.stagesLabel}}</text>
        <view class="band-chips">
          <text wx:for="{{summaryStats.stageNames}}" wx:key="*this" class="band-chip">{{item}}</text>
          <text class="band-ratio">{{summaryStats.stageNames.length}}/{{summaryStats.stageTotal}}</text>
        </view>
      </view>

      <view class="summit-ach">
        <text class="summit-band-t">获得成就</text>
        <view wx:if="{{summaryStats.achievements.length}}" class="ach-list">
          <view wx:for="{{summaryStats.achievements}}" wx:key="id" class="ach-item">
            <view class="ach-mark"><text>成就</text></view>
            <view class="ach-text">
              <text class="ach-title">{{item.title}}</text>
              <text class="ach-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
        <text wx:else class="ach-empty">继续探索更多自然带与随堂题，解锁成就吧～</text>
      </view>

      <view class="summit-band" wx:if="{{nextStops.length}}">
        <text class="summit-band-t">下一站 · 继续探索</text>
        <view class="next-stops">
          <view class="next-stop" wx:for="{{nextStops}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onOpenNextStop">
            <view class="next-stop-mark"><text>下一站</text></view>
            <view class="next-stop-text">
              <text class="next-stop-name">{{item.name}}</text>
              <text class="next-stop-sub">{{item.shortDescription}}</text>
            </view>
            <text class="next-stop-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="summit-actions">
        <button class="act act-primary" bindtap="onRestart">重新探索</button>
        <button class="act act-ghost" bindtap="onGoProfile">探索记录</button>
        <button class="act act-ghost" bindtap="onBackHome">返回首页</button>
      </view>
    </view>
  </view>
</view>
