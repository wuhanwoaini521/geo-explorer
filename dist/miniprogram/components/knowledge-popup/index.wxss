/* Gate 3.3C.1 P1：知识卡（发现卡）→ 暗色半透明玻璃
   深色 immersive 页统一：透明玻璃底 + 细边框 + 减弱投影 + 单一 accent 图标（emoji）。
   不再使用亮米色（bright cream）卡片；强调色收敛为细蓝高亮，不做 cyan-heavy 卡片。 */
.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(6, 10, 18, 0.58);
  backdrop-filter: blur(8rpx);
}
.popup-sheet {
  width: 100%;
  max-height: 72vh; /* 更小占用 */
  overflow-y: auto;
  background: rgba(15, 22, 37, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-bottom: none;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.35); /* 减弱的投影 */
  backdrop-filter: blur(26rpx);
  padding: 30rpx 30rpx 44rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  color: #eef3fa;
  animation: sheetIn 0.28s ease both;
}
@keyframes sheetIn {
  from { transform: translateY(60rpx); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}
.popup-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
/* 单一 accent 图标（知识 emoji）——整卡唯一强高亮 */
.popup-emoji {
  font-size: 52rpx;
  line-height: 1;
}
.popup-head-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f4f7fc;
  letter-spacing: 1rpx;
}
.popup-elev {
  font-size: 22rpx;
  color: #9fd4ff;
}
.popup-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aaabd;
  font-size: 28rpx;
}
.popup-summary {
  margin-top: 22rpx;
  font-size: 27rpx;
  color: #dfe6f0;
  line-height: 1.6;
}
.popup-expand {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #9fd4ff;
  font-size: 26rpx;
}
.popup-expand-arrow {
  font-size: 22rpx;
}
.popup-detail {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #cdd6e3;
  line-height: 1.7;
}
.popup-facts {
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.popup-facts-title {
  font-size: 22rpx;
  color: #9fd4ff;
  letter-spacing: 2rpx;
}
.fact {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.fact-label {
  font-size: 22rpx;
  color: #93a4bb;
}
.fact-value {
  font-size: 24rpx;
  color: #dce4f0;
  line-height: 1.5;
}
.popup-source {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.popup-source-flag {
  font-size: 20rpx;
  color: #8fc4f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(120, 174, 224, 0.12);
}
.popup-source-text {
  font-size: 20rpx;
  color: #93a4bb;
}
.popup-actions {
  margin-top: 30rpx;
}
/* 主按钮：克制小玻璃（非 cyan-heavy 填充），与整体暗玻璃一致 */
.popup-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #eef4fb;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.popup-btn-primary:active {
  transform: translateY(2rpx);
  background: rgba(255, 255, 255, 0.14);
}
/* ---------- 分层：分类标签 / 查看详情 / 完整知识 ---------- */
.popup-cat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.popup-cat {
  font-size: 20rpx;
  color: #c7d6e8;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}
.popup-btn-expand {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #9fd4ff;
  font-size: 26rpx;
  padding: 10rpx 0;
}
.popup-subtitle {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: #9fd4ff;
  letter-spacing: 2rpx;
}
.popup-sources {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.popup-src-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}
.popup-src-bullet {
  color: #7f8fa6;
  font-size: 24rpx;
  line-height: 1.6;
}
.popup-src-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.popup-src-name {
  font-size: 22rpx;
  color: #b9c6d8;
  line-height: 1.5;
}
.popup-src-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.tag-approx {
  font-size: 20rpx;
  color: #d6b37e;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(214, 179, 126, 0.12);
}
.tag-verified {
  font-size: 20rpx;
  color: #8fce9a;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(143, 206, 154, 0.12);
}
.fact-src {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #93a4bb;
}
.popup-btn-lib {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #b9c6d8;
  font-size: 24rpx;
}