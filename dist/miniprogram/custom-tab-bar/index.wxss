/* 自定义 tabBar：设计图中的四项深色底栏。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 0 0 env(safe-area-inset-bottom);
  pointer-events: none;
}
.pill {
  position: relative;
  display: flex;
  height: 104rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: rgba(6, 18, 29, 0.96);
  border-top: 1rpx solid rgba(172, 210, 238, 0.18);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.18);
  pointer-events: auto;
}
/* tab 区：内缩于胶囊圆角，指示器两端不再膈应圆角 */
.tabs {
  position: relative;
  flex: 1;
  display: flex;
  height: 100%;
}

/* 滑动指示器：琥珀柔光胶囊，带回弹曲线 */
.indicator {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 25%;
  border-radius: 18rpx;
  background: rgba(109, 188, 244, 0.12);
  border: 1rpx solid rgba(109, 188, 244, 0.2);
  transition: left 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.tab-ico {
  font-size: 36rpx;
  line-height: 1.1;
  filter: grayscale(0.6);
  opacity: 0.66;
  transition: filter 0.25s, opacity 0.25s, transform 0.25s;
}
.tab-text {
  font-size: 20rpx;
  color: #8397aa;
  letter-spacing: 2rpx;
  transition: color 0.25s;
}
.tab-on .tab-ico {
  filter: grayscale(0);
  opacity: 1;
  transform: translateY(-4rpx) scale(1.12);
  animation: tabBounce 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tab-on .tab-text {
  color: #c8edff;
  font-weight: 700;
}
@keyframes tabBounce {
  0% { transform: translateY(6rpx) scale(0.82); }
  55% { transform: translateY(-10rpx) scale(1.22); }
  100% { transform: translateY(-4rpx) scale(1.12); }
}
