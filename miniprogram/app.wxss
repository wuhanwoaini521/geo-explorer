/**
 * 全局样式 —— Geo Explorer Expedition V2（深夜蓝黑 / 冰蓝数据）。
 */
page {
  background: #f7fafc;
  color: #102c3d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

/* 按钮重置 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* Hepler */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.gap-s {
  gap: 12rpx;
}
.gap-m {
  gap: 20rpx;
}
.text-dim {
  color: #587180;
}
.text-muted {
  color: #8da1ad;
}
.text-accent {
  color: #2c77d9;
}
.text-xl {
  font-size: 40rpx;
  font-weight: 600;
}
.text-lg {
  font-size: 32rpx;
  font-weight: 600;
}
.text-sm {
  font-size: 22rpx;
}
.text-xs {
  font-size: 20rpx;
}
.caption {
  font-size: 20rpx;
  color: #8da1ad;
  letter-spacing: 1rpx;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mt-s { margin-top: 16rpx; }
.mt-m { margin-top: 28rpx; }
.mt-l { margin-top: 48rpx; }
.mb-s { margin-bottom: 16rpx; }
.mb-m { margin-bottom: 28rpx; }

/* 通用卡片 */
.panel {
  background: #ffffff;
  border: 1rpx solid #d5e2e9;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(16, 44, 61, 0.06);
}

/* 主按钮：硬投影 + 墨色描边，可按压回弹 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 44rpx;
  background: #2c77d9;
  border: 1rpx solid #2c77d9;
  box-shadow: 0 8rpx 20rpx rgba(44, 119, 217, 0.22);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.btn-primary:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(17, 145, 226, 0.25);
  opacity: 0.94;
}
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 44rpx;
  border: 1rpx solid #c8d9e2;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(16, 44, 61, 0.08);
  color: #2c77d9;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.btn-ghost:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.18);
}

/* 淡入 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fadeIn 0.42s ease both;
}
