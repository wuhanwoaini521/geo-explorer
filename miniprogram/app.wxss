/**
 * 全局样式 —— Geo Explorer 视觉基调（第 11 节：现代/自然/探索/克制）。
 * 深色底 + 青色主色 + 级联星空式的克制动效。
 */
page {
  background: #0a1426;
  color: #e6eef7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

/* 按钮重置 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* Hepler */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.gap-s {
  gap: 12rpx;
}
.gap-m {
  gap: 20rpx;
}
.text-dim {
  color: #8fa3bf;
}
.text-muted {
  color: #6f7f96;
}
.text-accent {
  color: #8ce6cf;
}
.text-xl {
  font-size: 40rpx;
  font-weight: 600;
}
.text-lg {
  font-size: 32rpx;
  font-weight: 600;
}
.text-sm {
  font-size: 22rpx;
}
.text-xs {
  font-size: 20rpx;
}
.caption {
  font-size: 20rpx;
  color: #6f7f96;
  letter-spacing: 1rpx;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mt-s { margin-top: 16rpx; }
.mt-m { margin-top: 28rpx; }
.mt-l { margin-top: 48rpx; }
.mb-s { margin-bottom: 16rpx; }
.mb-m { margin-bottom: 28rpx; }

/* 通用卡片 */
.panel {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #2fb6a0, #1d8fa6);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 168, 160, 0.32);
}
.btn-primary:active {
  opacity: 0.86;
  transform: translateY(2rpx);
}
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.06);
  color: #e6eef7;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* 淡入 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fadeIn 0.42s ease both;
}