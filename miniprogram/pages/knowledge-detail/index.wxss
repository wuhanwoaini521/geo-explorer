.page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 30rpx) 28rpx calc(env(safe-area-inset-bottom) + 50rpx); background: #07131f; color: #eef7fb; }
.head { display: flex; flex-direction: column; align-items: center; padding: 34rpx 18rpx 30rpx; border-bottom: 1rpx solid rgba(174, 211, 234, .13); }
.head-mark { width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 193, 243, .55); border-radius: 50%; color: #9bdcff; background: rgba(45, 160, 222, .12); font-size: 24rpx; letter-spacing: 3rpx; }
.head-title { margin-top: 16rpx; color: #f1f8fc; font-size: 35rpx; font-weight: 800; line-height: 1.4; text-align: center; }
.head-cat { margin-top: 12rpx; padding: 6rpx 20rpx; border-radius: 999rpx; color: #66c1f3; background: rgba(45, 160, 222, .12); border: 1rpx solid rgba(75, 181, 238, .3); font-size: 21rpx; }
.section { margin-top: 30rpx; }
.section-title { color: #76bce5; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-body { display: block; margin-top: 14rpx; color: #bbceda; font-size: 26rpx; line-height: 1.8; }
.note { padding-top: 22rpx; border-top: 1rpx solid rgba(174, 211, 234, .13); }
.note .section-body { color: #7792a4; font-size: 21rpx; }
.place-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.place-link { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 18rpx; border-radius: 12rpx; background: #102335; border: 1rpx solid rgba(165, 207, 232, .13); }
.place-link-mark { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 193, 243, .38); border-radius: 50%; color: #9bdcff; font-size: 18rpx; }
.place-link-name { color: #e3f0f7; font-size: 23rpx; font-weight: 600; }
.place-link-type { color: #7894a7; font-size: 19rpx; }
