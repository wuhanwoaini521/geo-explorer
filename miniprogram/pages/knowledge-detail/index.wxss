.page { min-height: 100vh; background: #f6f0dd; padding: 36rpx 32rpx 80rpx; }
.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(151, 124, 66, 0.16);
}
.head-emoji { font-size: 64rpx; }
.head-title { margin-top: 16rpx; font-size: 36rpx; font-weight: 800; color: #37311e; text-align: center; letter-spacing: 1rpx; }
.head-cat {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a06a10;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(168, 119, 23, 0.1);
  border: 1rpx solid rgba(168, 119, 23, 0.24);
}
.section { margin-top: 30rpx; }
.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #a06a10;
  letter-spacing: 2rpx;
}
.section-body {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #37311e;
  line-height: 1.75;
}
.note { padding-top: 20rpx; border-top: 1rpx solid rgba(151, 124, 66, 0.16); }
.note .section-body { font-size: 22rpx; color: #8a7c58; }

/* 相关地点 */
.place-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.place-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}
.place-link:active { background: #f6eed7; }
.place-link-emoji { font-size: 30rpx; }
.place-link-name { font-size: 24rpx; font-weight: 600; }
.place-link-type { font-size: 19rpx; color: #94896a; }
