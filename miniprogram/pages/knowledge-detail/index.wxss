.page { min-height: 100vh; background: #0a1216; padding: 36rpx 32rpx 80rpx; }
.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.head-emoji { font-size: 84rpx; }
.head-title { margin-top: 16rpx; font-size: 36rpx; font-weight: 800; color: #ffffff; text-align: center; }
.head-cat {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8ce6cf;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(140, 230, 207, 0.1);
}
.section { margin-top: 30rpx; }
.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #8ce6cf;
  letter-spacing: 1rpx;
}
.section-body {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #d7e6f5;
  line-height: 1.75;
}
.note { padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,0.06); }
.note .section-body { font-size: 22rpx; color: #8fa3bf; }