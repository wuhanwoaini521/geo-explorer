.page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 30rpx) 28rpx calc(env(safe-area-inset-bottom) + 140rpx); background: #07131f; color: #eef7fb; }
.head { display: flex; flex-direction: column; align-items: center; padding: 34rpx 18rpx 30rpx; border-bottom: 1rpx solid rgba(174, 211, 234, .13); }
.detail-back { padding: 10rpx 0; color: #a7e1ff; font-size: 23rpx; }
.head-mark { width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 193, 243, .55); border-radius: 50%; color: #9bdcff; background: rgba(45, 160, 222, .12); font-size: 24rpx; letter-spacing: 3rpx; }
.head-title { margin-top: 16rpx; color: #f1f8fc; font-size: 35rpx; font-weight: 800; line-height: 1.4; text-align: center; }
.head-cat { margin-top: 12rpx; padding: 6rpx 20rpx; border-radius: 999rpx; color: #66c1f3; background: rgba(45, 160, 222, .12); border: 1rpx solid rgba(75, 181, 238, .3); font-size: 21rpx; }
.section { margin-top: 30rpx; }
.section-title { color: #76bce5; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-body { display: block; margin-top: 14rpx; color: #bbceda; font-size: 26rpx; line-height: 1.8; }
.note { padding-top: 22rpx; border-top: 1rpx solid rgba(174, 211, 234, .13); }
.note .section-body { color: #7792a4; font-size: 21rpx; }
.detail-actions { display: flex; gap: 14rpx; margin-top: 34rpx; padding-bottom: 20rpx; }
.detail-action-primary, .detail-action-secondary { flex: 1; display: flex; align-items: center; justify-content: center; height: 76rpx; border-radius: 38rpx; font-size: 23rpx; }
.detail-action-primary { color: #07131f; background: #9edfff; }
.detail-action-secondary { color: #b9d8e8; border: 1rpx solid rgba(165, 207, 232, .25); }
.place-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.place-link { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 18rpx; border-radius: 12rpx; background: #102335; border: 1rpx solid rgba(165, 207, 232, .13); }
.place-link-mark { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 193, 243, .38); border-radius: 50%; color: #9bdcff; font-size: 18rpx; }
.place-link-name { color: #e3f0f7; font-size: 23rpx; font-weight: 600; }
.place-link-type { color: #7894a7; font-size: 19rpx; }

.process-explorer { margin-top: 28rpx; padding: 22rpx; border-radius: 18rpx; background: linear-gradient(145deg, #e2f3f5, #ffffff); border: 1rpx solid #c9e1e5; box-shadow: 0 10rpx 24rpx rgba(16,44,61,.08); }
.process-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.process-head .section-title { color: #102c3d; }
.process-question { display: block; max-width: 510rpx; margin-top: 6rpx; color: #587180; font-size: 20rpx; line-height: 1.45; }
.process-count { flex-shrink: 0; color: #2c77d9; font-size: 20rpx; font-weight: 700; }
.process-steps { display: flex; align-items: center; margin-top: 20rpx; }
.process-step-dot { position: relative; flex: 1; display: flex; align-items: center; }
.process-step-dot::after { content: ""; flex: 1; height: 4rpx; margin-left: 8rpx; background: #c7e1e5; }
.process-step-dot:last-child { flex: 0 0 36rpx; }
.process-step-dot:last-child::after { display: none; }
.process-step-dot text { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #78919c; background: #c7e1e5; font-size: 14rpx; font-weight: 700; }
.process-step-dot.complete::after { background: #5bb9d0; }
.process-step-dot.complete text, .process-step-dot.current text { color: #fff; background: #2c77d9; }
.process-step-dot.current text { box-shadow: 0 0 0 6rpx rgba(44,119,217,.16); }
.process-visual { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: 178rpx; margin-top: 18rpx; padding: 22rpx; overflow: hidden; border-radius: 14rpx; background: #123b56; }
.process-visual::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 80% 20%, rgba(54,181,227,.42), transparent 42%), linear-gradient(135deg, transparent 45%, rgba(255,255,255,.07) 46%, transparent 47%); }
.visual-line { position: relative; z-index: 1; color: #b9f1f4; font-family: Georgia, serif; font-size: 29rpx; letter-spacing: 3rpx; }
.visual-title { position: relative; z-index: 1; margin-top: 18rpx; color: #fff; font-size: 29rpx; font-weight: 800; }
.visual-step { position: absolute; z-index: 1; right: 20rpx; bottom: 16rpx; color: rgba(255,255,255,.44); font-size: 46rpx; font-weight: 800; }
.process-explanation { display: block; margin-top: 16rpx; color: #587180; font-size: 23rpx; line-height: 1.65; }
.process-progress { height: 6rpx; margin-top: 18rpx; overflow: hidden; border-radius: 4rpx; background: #c7e1e5; }
.process-progress-on { height: 100%; border-radius: 4rpx; background: #2c77d9; transition: width .25s ease; }
.process-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.process-prev, .process-next { flex: 1; display: flex; align-items: center; justify-content: center; height: 64rpx; border-radius: 32rpx; font-size: 21rpx; }
.process-prev { color: #2c77d9; border: 1rpx solid #b9ddea; background: #fff; }
.process-next { color: #fff; background: #2c77d9; }
.process-prev.disabled, .process-next.disabled { opacity: .46; }

.page { background: #f7fafc; color: #102c3d; }
.detail-back { color: #2c77d9; }
.head-mark { color: #168bb9; background: #e5f3f8; border-color: #b9ddea; }
.head-title, .section-title { color: #102c3d; }
.head-cat { color: #168bb9; background: #e5f3f8; border-color: #b9ddea; }
.section-body { color: #587180; }
.note .section-body, .place-link-type { color: #8da1ad; }
.detail-action-primary { color: #ffffff; background: #2c77d9; }
.detail-action-secondary { color: #2c77d9; border-color: #b9ddea; background: #ffffff; }
.place-link { background: #ffffff; border-color: #d5e2e9; box-shadow: 0 8rpx 20rpx rgba(16,44,61,.05); }
.place-link-mark { color: #168bb9; border-color: #b9ddea; }
.place-link-name { color: #102c3d; }
