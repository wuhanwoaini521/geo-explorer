/* 首页 */
.page {
  min-height: 100vh;
  background: #0a1426;
  padding-bottom: 60rpx;
}

.hero {
  padding: 64rpx 40rpx 44rpx;
  background: linear-gradient(160deg, #16324f, #0c1c33);
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9fb7d4;
}

.hero-stats {
  display: flex;
  margin-top: 34rpx;
  gap: 16rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}
.stat-v {
  font-size: 40rpx;
  font-weight: 800;
  color: #8ce6cf;
}
.stat-k {
  font-size: 22rpx;
  color: #9fb7d4;
  margin-top: 6rpx;
}

.section-title {
  padding: 40rpx 40rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #eaf3fc;
}

.scene-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.scene-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 32rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #16233d, #101c33);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.card-left {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(140, 230, 207, 0.12);
}
.card-emoji {
  font-size: 64rpx;
}
.card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}
.card-badge {
  font-size: 20rpx;
  color: #8ce6cf;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(140, 230, 207, 0.14);
  white-space: nowrap;
}
.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a9c1dc;
}
.card-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7d8ba0;
}
.card-cta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #38c2a0;
  font-weight: 600;
}

.about {
  margin: 48rpx 32rpx 0;
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}
.about-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #cfe2f2;
}
.about-text {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7d8ba0;
  line-height: 1.7;
}