/* 首页 —— 探索的起点（暖纸 / 古地图编辑风） */
.page {
  min-height: 100vh;
  background: #f6f0dd;
  color: #37311e;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 190rpx);
  box-sizing: border-box;
}

/* ===== Hero ===== */
.hero {
  padding: 44rpx 8rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #94896a;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #6f6547;
  line-height: 1.6;
}
.hero-plate {
  position: relative;
  margin-top: 12rpx;
  height: 340rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 86, 14, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(122, 98, 45, 0.14);
}
.hero-plate-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-plate-tag {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(43, 33, 14, 0.62);
}
.hero-plate-tag-t {
  color: #ffe19a;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.hero-plate-tag-s {
  color: rgba(255, 225, 154, 0.66);
  font-size: 18rpx;
}
.hero-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}
.stat {
  flex: 1;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 16rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-v {
  font-size: 36rpx;
  font-weight: 800;
  color: #a06a10;
  font-family: Georgia, serif;
}
.stat-k {
  font-size: 20rpx;
  color: #94896a;
}

/* ===== 区块 ===== */
.section {
  margin-top: 52rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #d9a63a;
}
.sec-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-right: 8rpx;
}
.sec-link {
  font-size: 22rpx;
  color: #a06a10;
}

/* ===== 场景卡片 ===== */
.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.scene-card {
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 98, 45, 0.08);
}
.scene-card:active { background: #faf3e0; }
.card-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.card-left {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #f1e9d0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-emoji { font-size: 48rpx; }
.card-idx {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: rgba(151, 124, 66, 0.16);
  font-family: Georgia, serif;
  line-height: 1;
}
.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.card-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-name {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.card-badge {
  font-size: 18rpx;
  color: #a06a10;
  background: rgba(168, 119, 23, 0.1);
  border: 1rpx solid rgba(168, 119, 23, 0.22);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.card-sub {
  font-size: 24rpx;
  color: #6f6547;
}
.card-meta {
  font-size: 20rpx;
  color: #94896a;
}
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx dashed rgba(151, 124, 66, 0.28);
  padding-top: 18rpx;
}
.card-cta {
  font-size: 24rpx;
  color: #a06a10;
  letter-spacing: 2rpx;
}
.card-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e3b04b, #b57f1f);
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-arrow-ico {
  color: #fffdf4;
  font-size: 28rpx;
}

/* ===== 精选目的地（横向滚动） ===== */
.featured-scroll {
  width: 100%;
}
.featured-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 2rpx 12rpx;
}
.featured-card {
  flex-shrink: 0;
  width: 264rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 18rpx;
  padding: 22rpx 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(122, 98, 45, 0.06);
}
.featured-card:active { background: #f6eed7; }
.featured-ex {
  border-color: rgba(168, 119, 23, 0.36);
}
.featured-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.featured-emoji { font-size: 52rpx; }
.featured-badge {
  font-size: 18rpx;
  color: #a06a10;
  border: 1rpx solid rgba(168, 119, 23, 0.3);
  background: rgba(168, 119, 23, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.featured-name {
  font-size: 28rpx;
  font-weight: 700;
}
.featured-sub {
  font-size: 20rpx;
  color: #94896a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.featured-meta {
  font-size: 19rpx;
  color: #6f6547;
}

/* ===== 按地貌探索 ===== */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.type-cell {
  width: calc((100% - 42rpx) / 4);
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 16rpx;
  padding: 20rpx 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
}
.type-cell:active { background: #f6eed7; }
.type-emoji { font-size: 40rpx; }
.type-label {
  font-size: 22rpx;
  color: #37311e;
}
.type-count {
  font-size: 18rpx;
  color: #94896a;
}

/* ===== 你知道吗 ===== */
.dyc {
  background: linear-gradient(160deg, #fbf5e2, #f3e9cc);
  border: 1rpx solid rgba(151, 124, 66, 0.2);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.dyc-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.dyc-emoji { font-size: 40rpx; }
.dyc-tag {
  font-size: 20rpx;
  color: #8a7c58;
  background: rgba(151, 124, 66, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.dyc-fact {
  font-size: 27rpx;
  line-height: 1.7;
  color: #37311e;
}
.dyc-note {
  font-size: 22rpx;
  color: #6f6547;
  line-height: 1.6;
}
.dyc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx dashed rgba(151, 124, 66, 0.28);
  padding-top: 14rpx;
}
.dyc-src {
  flex: 1;
  min-width: 0;
  font-size: 19rpx;
  color: #94896a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dyc-shuffle {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #a06a10;
  padding: 6rpx 12rpx;
}

/* ===== 关于 ===== */
.about {
  margin-top: 52rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.about-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.about-text {
  font-size: 23rpx;
  color: #6f6547;
  line-height: 1.7;
}
