.page {
  min-height: 100vh;
  /* 末尾留出 TabBar 高度 + 安全区 + 额外呼吸空间，最后一张卡可完整滚到栏上方。 */
  padding: 0 26rpx calc(env(safe-area-inset-bottom) + 220rpx);
  box-sizing: border-box;
  color: #f5f8fb;
  background: #07131f;
}
.home-hero { position: relative; height: 390rpx; margin: 0 -26rpx; overflow: hidden; background: #0a2138; }
.home-hero-image { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .72; }
.home-hero-fallback { position: absolute; inset: 0; background: linear-gradient(145deg, #204b6f, #07131f 72%); }
.home-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4, 14, 25, .5), rgba(4, 14, 25, .78) 68%, #07131f 100%); }
.home-topbar { position: absolute; top: calc(env(safe-area-inset-top) + 20rpx); left: 28rpx; right: 28rpx; display: flex; justify-content: space-between; align-items: center; }
.home-brand { font-size: 20rpx; letter-spacing: 5rpx; color: rgba(238, 247, 255, .86); }
.home-more { font-size: 28rpx; letter-spacing: 5rpx; color: rgba(238, 247, 255, .72); }
.home-copy { position: absolute; left: 28rpx; top: 126rpx; display: flex; flex-direction: column; gap: 10rpx; }
.home-title { font-size: 54rpx; font-weight: 800; letter-spacing: 3rpx; color: #fff; }
.home-sub { font-size: 25rpx; color: rgba(230, 241, 251, .78); }
.search { position: absolute; left: 26rpx; right: 26rpx; bottom: 36rpx; height: 76rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 22rpx; border-radius: 40rpx; background: rgba(104, 137, 167, .36); border: 1rpx solid rgba(205, 229, 248, .14); }
.search-icon { font-size: 42rpx; line-height: 1; color: #d5e7f6; transform: rotate(-20deg); }
.search-input { flex: 1; font-size: 25rpx; color: #eef7ff; }
.search-placeholder { color: rgba(226, 239, 250, .7); }
.filters { width: 100%; margin: 14rpx 0 18rpx; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 2rpx 0; }
.filter { flex-shrink: 0; padding: 13rpx 22rpx; border-radius: 999rpx; background: #142638; color: #a6b7c8; font-size: 22rpx; }
.filter-on { color: #092039; background: #d9efff; font-weight: 700; }
.destination-list { display: flex; flex-direction: column; gap: 14rpx; }
.scene-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 42rpx 24rpx; border-radius: 18rpx; background: #102538; border: 1rpx solid rgba(180, 217, 239, .12); color: #a8bfce; font-size: 23rpx; text-align: center; }
.scene-empty-clear { margin-top: 6rpx; color: #65bff0; }
.destination { position: relative; height: 198rpx; overflow: hidden; border-radius: 18rpx; border: 1rpx solid rgba(190, 218, 239, .15); background: #102333; }
.destination-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.destination-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(4, 12, 21, .9), rgba(4, 12, 21, .34) 66%, rgba(4, 12, 21, .1)); }
.destination-copy { position: absolute; left: 24rpx; top: 23rpx; display: flex; flex-direction: column; gap: 7rpx; }
.destination-title { font-size: 36rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx; }
.destination-subtitle { font-size: 23rpx; color: #d2e0ec; }
.destination-tags { display: flex; gap: 10rpx; margin-top: 6rpx; }
.destination-tag { padding: 5rpx 14rpx; border-radius: 7rpx; background: #138bd1; color: #eef9ff; font-size: 19rpx; }
.destination-tag-muted { background: rgba(39, 58, 73, .84); color: #d0dde7; }
.destination-action { position: absolute; right: 20rpx; top: 50%; width: 58rpx; height: 58rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; transform: translateY(-50%); background: rgba(6, 18, 29, .76); }
.destination-action text { font-size: 48rpx; line-height: 1; color: #fff; font-family: Arial, sans-serif; }
.destination-image-fallback { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 22rpx; box-sizing: border-box; background: linear-gradient(135deg, #214a68, #0d1b2a); color: rgba(255,255,255,.42); font-size: 24rpx; }
.home-section { margin-top: 22rpx; }
.home-stats { display: flex; justify-content: space-between; padding: 20rpx 18rpx; border-top: 1rpx solid rgba(169, 205, 230, .14); border-bottom: 1rpx solid rgba(169, 205, 230, .14); }
.home-stats > view { display: flex; flex-direction: column; gap: 6rpx; align-items: center; flex: 1; }
.stat-value { color: #eaf7ff; font-size: 31rpx; font-weight: 800; }
.stat-label { color: #7892a6; font-size: 19rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: center; color: #eff8ff; font-size: 28rpx; font-weight: 700; }
.section-link { color: #64b9e9; font-size: 20rpx; font-weight: 400; }
.featured-scroll { width: 100%; margin-top: 14rpx; }
.featured-row { display: inline-flex; gap: 12rpx; }
.featured-card { width: 254rpx; min-height: 196rpx; padding: 18rpx; box-sizing: border-box; display: flex; flex-direction: column; gap: 7rpx; border-radius: 16rpx; background: #102538; border: 1rpx solid rgba(180, 217, 239, .12); }
.featured-mark, .discovery-mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 38rpx; border-radius: 8rpx; color: #9bdcff; background: rgba(44, 156, 214, .14); border: 1rpx solid rgba(89, 190, 238, .3); font-size: 17rpx; letter-spacing: 1rpx; }
.featured-name { color: #f2f8fc; font-size: 25rpx; font-weight: 700; }
.featured-type { color: #69bce8; font-size: 19rpx; }
.featured-desc { color: #89a3b6; font-size: 20rpx; line-height: 1.45; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.discovery-card { padding: 20rpx; border-radius: 16rpx; background: #102538; border: 1rpx solid rgba(180, 217, 239, .12); }
.discovery-head { display: flex; align-items: center; gap: 12rpx; }
.discovery-head > view:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.discovery-label { color: #6aafd5; font-size: 19rpx; }
.discovery-title { color: #eef8ff; font-size: 25rpx; font-weight: 700; }
.discovery-content { display: block; margin-top: 15rpx; color: #adc1ce; font-size: 22rpx; line-height: 1.6; }

/* Penpot 现代亮色图鉴首页：照片保留沉浸感，内容区回到白色编辑型信息层。 */
.page { color: #102c3d; background: #f7fafc; }
.home-hero { background: #c8dce5; }
.home-hero-shade { background: linear-gradient(180deg, rgba(8, 33, 52, .24), rgba(8, 33, 52, .42) 58%, #f7fafc 100%); }
.home-brand, .home-more { color: rgba(255, 255, 255, .9); }
.home-title { color: #ffffff; text-shadow: 0 3rpx 16rpx rgba(8, 33, 52, .26); }
.home-sub { color: rgba(255, 255, 255, .88); }
.search { background: rgba(255, 255, 255, .88); border-color: rgba(255, 255, 255, .9); box-shadow: 0 10rpx 28rpx rgba(16, 44, 61, .12); }
.search-icon { color: #2c77d9; }
.search-input { color: #102c3d; }
.search-placeholder { color: #718894; }
.filter { background: #e5f3f8; color: #587180; border: 1rpx solid #d5e2e9; }
.filter-on { color: #ffffff; background: #2c77d9; border-color: #2c77d9; }
.scene-empty, .featured-card, .discovery-card { background: #ffffff; border-color: #d5e2e9; box-shadow: 0 10rpx 28rpx rgba(16, 44, 61, .06); }
.scene-empty { color: #587180; }
.scene-empty-clear, .section-link { color: #2c77d9; }
.destination { border-color: #d5e2e9; box-shadow: 0 8rpx 24rpx rgba(16, 44, 61, .1); }
.destination-shade { background: linear-gradient(90deg, rgba(8, 33, 52, .78), rgba(8, 33, 52, .2) 72%, rgba(8, 33, 52, .04)); }
.destination-tag { background: #36b5e3; color: #ffffff; }
.destination-tag-muted { background: rgba(16, 44, 61, .5); color: #ffffff; }
.destination-action { background: rgba(255, 255, 255, .92); box-shadow: 0 6rpx 18rpx rgba(16, 44, 61, .14); }
.destination-action text { color: #2c77d9; }
.home-stats { border-color: #d5e2e9; }
.stat-value { color: #102c3d; }
.stat-label { color: #8da1ad; }
.section-heading { color: #102c3d; }
.featured-mark, .discovery-mark { color: #168bb9; background: #e5f3f8; border-color: #b9ddea; }
.featured-name, .discovery-title { color: #102c3d; }
.featured-type, .discovery-label { color: #168bb9; }
.featured-desc, .discovery-content { color: #587180; }
