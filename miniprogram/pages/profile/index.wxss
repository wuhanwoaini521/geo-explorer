.profile-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 25rpx calc(env(safe-area-inset-bottom) + 190rpx);
  overflow: hidden;
  color: var(--geo-ink);
  background: #061a2a;
}
.profile-backdrop, .profile-backdrop-shade { position: absolute; top: 0; left: 0; width: 100%; height: 480rpx; pointer-events: none; }
.profile-backdrop { opacity: .3; }
.profile-backdrop-shade { background: linear-gradient(180deg,rgba(4,18,32,.1),#061a2a 92%); }
.profile-head, .passport-card, .stats-grid, .profile-section-heading, .badge-scroll, .record-list, .profile-actions, .profile-footnote { position: relative; z-index: 1; }
.profile-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 19rpx; }
.profile-head > view { display: flex; flex-direction: column; gap: 4rpx; }
.profile-title { color: #f5f3e7; font-size: 38rpx; line-height: 1.1; font-weight: 800; }
.profile-subtitle { color: rgba(205,226,216,.82); font-size: 20rpx; }
.profile-settings { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(136,190,192,.25); border-radius: 50%; color: #d3e2dc; background: rgba(10,32,48,.68); font-size: 27rpx; }
.passport-card { position: relative; overflow: hidden; padding: 30rpx 34rpx 28rpx; border: 2rpx solid rgba(239,222,185,.9); border-radius: 24rpx; color: #263c43; background: var(--geo-paper); box-shadow: 0 12rpx 28rpx rgba(1,12,22,.2); }
.passport-card::before { position: absolute; inset: 10rpx; border: 1rpx dashed rgba(102,124,117,.35); border-radius: 16rpx; content: ""; pointer-events: none; }
.passport-main { position: relative; z-index: 1; min-height: 210rpx; box-sizing: border-box; padding-top: 12rpx; display: flex; align-items: flex-start; gap: 50rpx; }
.passport-avatar { width: 150rpx; height: 150rpx; flex: 0 0 150rpx; overflow: hidden; border: 4rpx solid #d5be8d; border-radius: 50%; background: #c9d8d1; }
.passport-identity { flex: 1; min-width: 0; display: flex; flex-direction: column; padding-right: 118rpx; }
.passport-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; }
.passport-eyebrow { color: #8c978c; font-size: 32rpx; line-height: 1.05; font-weight: 700; }
.passport-brand-name { color: #73827e; font-size: 24rpx; line-height: 1.2; }
.passport-identity-divider { width: 100%; margin: 16rpx 0 24rpx; border-top: 1rpx dashed rgba(102,124,117,.28); }
.passport-name { color: #1e3845; font-size: 36rpx; line-height: 1.08; font-weight: 800; }
.passport-role { margin-top: 20rpx; color: #72908a; font-size: 20rpx; letter-spacing: 1.1rpx; }
.passport-stamp { position: absolute; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid rgba(48,139,136,.48); color: #3f9993; font-size: 10rpx; font-weight: 800; letter-spacing: 1rpx; opacity: .76; }
.passport-stamp-large { right: 20rpx; top: -5rpx; width: 124rpx; height: 90rpx; transform: rotate(12deg); border-style: dashed; border-radius: 8rpx; color: #818a83; background: rgba(92,159,145,.04); }
.passport-stamp-large text:first-child { font-size: 16rpx; }
.passport-stamp-round { right: -10rpx; bottom: -1rpx; width: 170rpx; height: 140rpx; transform: rotate(-13deg); border-width: 3rpx; border-radius: 50%; box-shadow: inset 0 0 0 5rpx rgba(48,139,136,.1); }
.passport-stamp-round text { font-size: 20rpx; }
.passport-progress-row { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 26rpx; padding: 0 50rpx 0 24rpx; }
.passport-level { flex: 0 0 auto; color: #183f4c; font-size: 36rpx; font-weight: 900; }
.passport-progress { flex: 1; max-width: 270rpx; height: 14rpx; overflow: hidden; border-radius: 99rpx; background: #d3c7ab; }
.passport-progress-fill { height: 100%; border-radius: 99rpx; background: #28a99e; transition: width 230ms ease-out; }
.passport-exp { flex: 0 0 auto; color: #526c70; font-size: 22rpx; font-weight: 700; }
.stats-grid { display: flex; gap: 0; margin-top: 14rpx; overflow: hidden; border: 1rpx solid rgba(130,186,194,.18); border-radius: 18rpx; background: rgba(8,35,53,.9); }
.metric-card { flex: 1; min-width: 0; min-height: 130rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.metric-card + .metric-card { border-left: 1rpx solid rgba(130,186,194,.14); }
.metric-value { color: #f1f1e5; font-size: 30rpx; line-height: 1.1; font-weight: 800; }
.metric-label { margin-top: 8rpx; color: #a9c0bc; font-size: 16rpx; white-space: nowrap; }
.profile-section-heading { display: flex; align-items: center; justify-content: space-between; margin: 27rpx 2rpx 12rpx; color: #f0f2eb; font-size: 25rpx; font-weight: 780; }
.section-more { color: #b2c8c6; font-size: 16rpx; font-weight: 500; }
.badge-scroll { width: 100%; }
.badge-row { display: flex; justify-content: space-between; gap: 9rpx; }
.badge-card { width: 24%; flex: 0 0 24%; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.badge-art { position: relative; isolation: isolate; width: 128rpx; height: 128rpx; flex: 0 0 128rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; overflow: hidden; clip-path: polygon(50% 0,94% 20%,94% 70%,50% 100%,6% 70%,6% 20%); background: linear-gradient(145deg,#edf7f6 0%,#779aaa 13%,#dce9ec 26%,#3d6078 47%,#90aebb 67%,#eaf0e8 83%,#506d7e 100%); box-shadow: 0 0 0 2rpx rgba(3,14,27,.9),0 7rpx 17rpx rgba(0,8,18,.42),0 0 13rpx rgba(105,196,226,.2),inset 0 2rpx 4rpx rgba(255,255,255,.72); }
.badge-art image, .badge-art-fallback { position: absolute; z-index: 0; top: 9rpx; right: 9rpx; bottom: 9rpx; left: 9rpx; width: auto; height: auto; clip-path: polygon(50% 0,94% 20%,94% 70%,50% 100%,6% 70%,6% 20%); }
.badge-art::before { position: absolute; z-index: 1; inset: 4rpx; border: 2rpx solid rgba(239,249,247,.74); clip-path: polygon(50% 0,94% 20%,94% 70%,50% 100%,6% 70%,6% 20%); content: ""; pointer-events: none; }
.badge-art::after { position: absolute; z-index: 2; inset: 9rpx; clip-path: polygon(50% 0,94% 20%,94% 70%,50% 100%,6% 70%,6% 20%); background: linear-gradient(145deg,rgba(255,255,255,.26),transparent 38%,rgba(4,16,28,.2)); content: ""; pointer-events: none; }
.badge-hex-border { position: absolute; z-index: 3; inset: 8rpx; border: 1rpx solid rgba(234,246,244,.55); clip-path: polygon(50% 0,94% 20%,94% 70%,50% 100%,6% 70%,6% 20%); pointer-events: none; }
.badge-pending-dot { position: absolute; z-index: 4; right: 13%; top: 12%; width: 12rpx; height: 12rpx; border: 2rpx solid #e8f1ed; border-radius: 50%; background: #7b98a1; }
.badge-art-fallback { display: flex; align-items: center; justify-content: center; color: #d2eff0; font-size: 34rpx; }
.badge-medal-colorado .badge-art, .badge-medal-fuji .badge-art { background: linear-gradient(145deg,#fff0c7 0%,#a8623b 13%,#ffe3a0 26%,#81503c 47%,#c98c56 67%,#fff0c9 83%,#87583e 100%); box-shadow: 0 0 0 2rpx rgba(24,11,8,.9),0 7rpx 17rpx rgba(0,8,18,.42),0 0 13rpx rgba(239,166,98,.2),inset 0 2rpx 4rpx rgba(255,250,227,.76); }
.badge-medal-colorado .badge-art::before, .badge-medal-fuji .badge-art::before { border-color: rgba(255,240,198,.82); }
.badge-medal-colorado .badge-hex-border, .badge-medal-fuji .badge-hex-border { border-color: rgba(255,224,166,.62); }
.badge-title { max-width: 100%; margin-top: 7rpx; color: #e8f0e7; font-size: 17rpx; font-weight: 800; text-align: center; }
.badge-subtitle { max-width: 100%; margin-top: 3rpx; overflow: hidden; color: #a6bdbc; font-size: 12rpx; white-space: nowrap; text-overflow: ellipsis; }
.record-heading { margin-top: 27rpx; }
.record-list { display: flex; flex-direction: column; gap: 9rpx; }
.profile-compact-empty { padding: 14rpx 16rpx; border: 1rpx solid rgba(135,190,197,.14); border-radius: 13rpx; color: #97adae; background: rgba(9,38,56,.62); font-size: 16rpx; }
.record-card, .challenge-row, .favorite-row { min-height: 102rpx; display: flex; align-items: center; gap: 13rpx; padding: 11rpx; box-sizing: border-box; border: 1rpx solid rgba(135,190,197,.17); border-radius: 16rpx; background: rgba(9,38,56,.9); }
.record-card-live { position: relative; min-height: 320rpx; align-items: flex-end; padding: 18rpx; overflow: hidden; background: #0a2639; }
.record-card-live::after { position: absolute; z-index: 0; inset: 0; background: linear-gradient(180deg,rgba(5,20,31,.08) 4%,rgba(5,20,31,.36) 42%,rgba(5,20,31,.96) 100%); content: ""; pointer-events: none; }
.record-current-kicker { position: absolute; z-index: 1; top: 17rpx; left: 18rpx; padding: 6rpx 11rpx; border: 1rpx solid rgba(199,232,218,.24); border-radius: 999rpx; color: #d7ece0; background: rgba(5,25,39,.62); font-size: 16rpx; }
.record-card-live .record-image, .record-card-live .record-image-fallback { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; border-radius: 0; opacity: .78; }
.record-card-live .record-copy, .record-card-live .record-percent { position: relative; z-index: 1; }
.record-card-live .record-copy { padding-bottom: 3rpx; }
.record-card-live .record-meta { color: rgba(221,236,224,.82); }
.record-image, .record-image-fallback { width: 88rpx; height: 78rpx; flex-shrink: 0; border-radius: 10rpx; }
.record-image-fallback { display: flex; align-items: center; justify-content: center; color: #a6d9d7; background: linear-gradient(145deg,#245972,#102f46); font-size: 34rpx; }
.record-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.record-title { color: #eaf2e9; font-size: 19rpx; font-weight: 750; }
.record-meta { overflow: hidden; color: #a5b8b6; font-size: 15rpx; white-space: nowrap; text-overflow: ellipsis; }
.record-percent { flex-shrink: 0; color: #e2eeeb; font-size: 19rpx; font-weight: 700; }
.record-track { height: 8rpx; margin-top: 3rpx; overflow: hidden; border-radius: 999rpx; background: rgba(176,199,200,.18); }
.record-track-fill { height: 100%; border-radius: inherit; background: #27b3ac; }
.challenge-row { min-height: 82rpx; }
.difficulty-mark { width: 52rpx; height: 52rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(100,200,207,.25); border-radius: 9rpx; color: #8bd7dc; background: rgba(42,133,150,.17); font-size: 20rpx; font-weight: 800; }
.challenge-stars { flex-shrink: 0; color: #e1be71; font-size: 16rpx; }
.favorite-row { min-height: 80rpx; }
.favorite-open { width: 63rpx; height: 60rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8rpx; color: #c4e3dd; background: #183e51; font-size: 25rpx; }
.favorite-open image { width: 100%; height: 100%; }
.favorite-remove { padding: 10rpx; color: #d9907e; font-size: 25rpx; }
.profile-actions { margin-top: 25rpx; overflow: hidden; border: 1rpx solid rgba(135,190,197,.16); border-radius: 13rpx; background: rgba(9,38,56,.84); }
.action-link { display: flex; justify-content: space-between; padding: 19rpx 17rpx; color: #dcebe4; font-size: 19rpx; }
.action-link + .action-link { border-top: 1rpx solid rgba(135,190,197,.12); }
.action-link > text:last-child { color: #83bec1; font-size: 25rpx; }
.action-danger { color: #dfaa9f; }
.profile-footnote { display: flex; justify-content: center; margin-top: 18rpx; color: #8aa4a3; font-size: 14rpx; }
@media (max-width: 360px) {
  .profile-page { padding-right: 21rpx; padding-left: 21rpx; }
  .stats-grid { border-radius: 15rpx; }
  .metric-label { font-size: 13rpx; }
  .passport-stamp-large { width: 78rpx; }
  .badge-row { gap: 5rpx; }
}
