.page { min-height: 100vh; background: #f6f0dd; padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 210rpx); }
.me {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f3ead0, #ede3c6);
  border: 1rpx solid rgba(151, 124, 66, 0.16);
}
.me-avatar { font-size: 72rpx; }
.me-name { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; color: #37311e; letter-spacing: 1rpx; }
.me-note { margin-top: 8rpx; font-size: 22rpx; color: #94896a; }

.stats { display: flex; gap: 20rpx; margin: 30rpx 0; }
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 18rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.14);
}
.st-v { font-size: 44rpx; font-weight: 800; color: #a06a10; }
.st-k { margin-top: 8rpx; font-size: 22rpx; color: #94896a; }

.sec-title { margin: 10rpx 0 20rpx; font-size: 28rpx; font-weight: 700; color: #37311e; letter-spacing: 1rpx; }
.record { display: flex; flex-direction: column; gap: 16rpx; }
.empty {
  padding: 40rpx 30rpx;
  border-radius: 18rpx;
  background: #f1e9d0;
  border: 1rpx solid rgba(151, 124, 66, 0.12);
  color: #94896a;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
.rec {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.14);
}
.rec-emoji { font-size: 40rpx; }
.rec-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.rec-name { font-size: 26rpx; font-weight: 600; color: #37311e; }
.rec-meta { margin-top: 6rpx; font-size: 22rpx; color: #94896a; }
.rec-pct { font-size: 24rpx; font-weight: 700; color: #a06a10; }

.quiz-stars { font-size: 28rpx; letter-spacing: 4rpx; color: #c08a2d; }

/* 收藏 */
.rec-remove {
  font-size: 30rpx;
  color: #b3401f;
  padding: 8rpx 12rpx;
}
.rec-main:active { opacity: 0.75; }

.btn {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.28);
  color: #6f6547;
  font-size: 28rpx;
  font-weight: 600;
}
.btn:active { opacity: 0.8; }
