<view class="page profile-page geo-theme-dark">
  <image wx:if="{{profileHero}}" class="profile-backdrop" src="{{profileHero}}" mode="aspectFill" aria-hidden="true" />
  <view class="profile-backdrop-shade" />
  <view class="profile-head" style="padding-top:{{headerTop}}px">
    <view><text class="profile-title">我的</text><text class="profile-subtitle">探索者护照 · 记录你的成长</text></view>
    <text class="profile-settings" bindtap="onOpenSettings" aria-label="设置，包含数据来源与许可和清空本地数据">⚙</text>
  </view>

  <view class="passport-card">
    <view class="passport-main">
      <image class="passport-avatar" src="/assets/ui/avatar-explorer-pixel-v1.png" mode="aspectFill" />
      <view class="passport-identity"><view class="passport-brand"><text class="passport-eyebrow">GE</text><text class="passport-brand-name">Geo Explorer</text></view><view class="passport-identity-divider"></view><text class="passport-name">hansen</text><text class="passport-role">EARTH EXPLORER</text></view>
      <view class="passport-stamp passport-stamp-large"><image wx:if="{{profileHero}}" class="passport-stamp-photo" src="{{profileHero}}" mode="aspectFill" /><view class="passport-stamp-copy"><text>FIELD</text><text>EXPLORER</text><text>✦ · ✦</text></view></view>
      <view class="passport-stamp passport-stamp-round"><image wx:if="{{profileHero}}" class="passport-stamp-photo" src="{{profileHero}}" mode="aspectFill" /></view>
    </view>
    <view class="passport-progress-row"><text class="passport-level">Lv. {{passport.level}}</text><view class="passport-progress"><view class="passport-progress-fill" style="width:{{passport.percent}}%"></view></view><text class="passport-exp">{{passport.current}} / {{passport.threshold}}</text></view>
  </view>

  <view class="stats-grid geo-frosted-frame">
    <view class="metric-card"><text class="metric-value">{{stats.completed}}</text><text class="metric-label">完成探索</text></view>
    <view class="metric-card"><text class="metric-value">{{stats.totalFound}}</text><text class="metric-label">已获知识</text></view>
    <view class="metric-card"><text class="metric-value">{{stats.challenges}}</text><text class="metric-label">挑战次数</text></view>
    <view class="metric-card"><text class="metric-value">{{stats.places}}</text><text class="metric-label">图鉴地点</text></view>
  </view>

  <view class="profile-section-heading"><text>我的勋章</text><text class="section-more">更多 ›</text></view>
  <scroll-view class="badge-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="badge-row">
      <view wx:for="{{badges}}" wx:key="id" class="badge-card badge-medal-{{item.id}} {{item.earned ? 'badge-earned' : ''}}" aria-label="{{item.title}}，{{item.earned ? '已获得' : '未获得'}}">
        <view class="badge-art"><image wx:if="{{item.image && !failedImages[item.id]}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image><view wx:else class="badge-art-fallback">{{item.emoji}}</view><view class="badge-hex-border"></view><view wx:if="{{!item.earned}}" class="badge-pending-dot"></view></view>
        <text class="badge-title">{{item.title}}</text><text class="badge-subtitle">{{item.subtitle}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="profile-section-heading record-heading"><text>探索记录</text><text class="section-more">更多 ›</text></view>
  <view class="record-list" wx:if="{{!empty}}">
    <view class="record-card {{!item.completed ? 'record-card-live' : ''}}" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenRecord">
      <image wx:if="{{item.image && !failedImages[item.id]}}" class="record-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image><view wx:else class="record-image-fallback">{{item.emoji}}</view>
      <text wx:if="{{!item.completed}}" class="record-current-kicker">进行中的旅程</text>
      <view class="record-copy"><text class="record-title">{{item.title}} · {{item.completed ? '已完成' : '进行中'}}</text><text class="record-meta">当前 {{item.reachText}} {{item.unitText}} / 目标 {{item.maxText}} {{item.unitText}}</text><text class="record-meta">已获知识 {{item.knowledgeCount}} 条</text><view class="record-track"><view class="record-track-fill" style="width:{{item.pct}}%"></view></view></view>
      <text class="record-percent">{{item.pct}}%</text>
    </view>
  </view>
  <geo-empty-state wx:else mark="▦" title="第一段旅程还没开始" description="探索地球，进度会保存在这本护照里。" />

  <view wx:if="{{!quizEmpty}}" class="profile-history-section">
    <view class="profile-section-heading"><text>挑战成绩</text><text class="section-more">{{quiz.totalPlays}} 次</text></view>
    <view class="record-list"><view class="challenge-row" wx:for="{{quiz.levels}}" wx:key="difficulty"><view class="difficulty-mark">0{{item.difficulty}}</view><view class="record-copy"><text class="record-title">难度 {{item.difficulty}} · 最佳 {{item.bestCorrect}}/{{item.bestTotal}}</text><text class="record-meta">{{item.bestText}} · 挑战 {{item.plays}} 次</text></view><text class="challenge-stars">{{item.stars}}</text></view></view>
  </view>

  <view wx:if="{{!favoritesEmpty}}" class="profile-history-section">
    <view class="profile-section-heading"><text>我的收藏</text><text class="section-more">{{favoritesList.length}} 个地点</text></view>
    <view class="record-list">
      <view class="favorite-row" wx:for="{{favoritesList}}" wx:key="id">
        <view class="favorite-open" data-id="{{item.id}}" bindtap="onOpenFavorite"><image wx:if="{{item.image && !failedImages[item.id]}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image><text wx:else>{{item.emoji}}</text></view>
        <view class="record-copy" data-id="{{item.id}}" bindtap="onOpenFavorite"><text class="record-title">{{item.name}}</text><text class="record-meta">{{item.typeLabel}} · {{item.shortDescription}}</text></view>
        <text class="favorite-remove" data-id="{{item.id}}" catchtap="onRemoveFavorite">♥</text>
      </view>
    </view>
  </view>

</view>
