<view class="page">
  <view class="me">
    <view class="me-avatar"><text>GE</text></view>
    <text class="me-name">Geo 探索者</text>
    <text class="me-note">数据存于本地 · 后续接入账号同步</text>
  </view>

  <view class="stats">
    <view class="st">
      <text class="st-v">{{stats.completed}}/{{stats.totalExplorations}}</text>
      <text class="st-k">完成探索</text>
    </view>
    <view class="st">
      <text class="st-v">{{stats.totalFound}}/{{stats.totalKnowledge}}</text>
      <text class="st-k">已获知识</text>
    </view>
    <view class="st">
      <text class="st-v">{{quiz.totalPlays}}</text>
      <text class="st-k">挑战次数</text>
    </view>
  </view>

  <view class="sec-title">挑战成绩</view>
  <view class="record" wx:if="{{!quizEmpty}}">
    <view class="rec" wx:for="{{quiz.levels}}" wx:key="difficulty">
      <view class="rec-mark quiz-stars">{{item.stars}}</view>
      <view class="rec-main">
        <text class="rec-name">难度 {{item.difficulty}} 最佳</text>
        <text class="rec-meta">{{item.bestText}} · 挑战 {{item.plays}} 次</text>
      </view>
    </view>
  </view>
  <view class="record empty" wx:else>
    <text>还没有挑战记录，去「挑战」页开始第一组地貌题</text>
  </view>

  <view class="sec-title">我的收藏 · 书签</view>
  <view class="record" wx:if="{{!favoritesEmpty}}">
    <view class="rec" wx:for="{{favoritesList}}" wx:key="id">
      <view class="rec-mark"><text>地貌</text></view>
      <view class="rec-main" data-id="{{item.id}}" bindtap="onOpenFavorite">
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-meta">{{item.typeLabel}} · {{item.shortDescription}}</text>
      </view>
      <text class="rec-remove" data-id="{{item.id}}" catchtap="onRemoveFavorite">♥</text>
    </view>
  </view>
  <view class="record empty" wx:else>
    <text>还没有收藏。在图鉴里收藏想继续研究的地貌</text>
  </view>

  <view class="sec-title">探索记录 · 历史</view>
  <view class="record" wx:if="{{!empty}}">
    <view class="rec" wx:for="{{records}}" wx:key="id">
      <view class="rec-mark"><text>观察</text></view>
      <view class="rec-main">
        <text class="rec-name">{{item.title}}{{item.completed ? ' · 已完成' : ''}}</text>
        <text class="rec-meta">已达 {{item.reachText}} {{item.unitText}} / 峰顶 {{item.maxText}} {{item.unitText}} · 知识 {{item.knowledgeCount}} 条</text>
      </view>
      <text class="rec-pct">{{item.pct}}%</text>
    </view>
  </view>
  <view class="record empty" wx:else>
    <text>还没有探索记录，去首页开始第一段地貌观察</text>
  </view>

  <view class="btn" bindtap="onOpenCredits">数据来源与许可</view>
  <view class="btn btn-danger" bindtap="onClear">清空本地数据</view>
</view>
