.page { min-height: 100vh; background: #0a1216; padding: 36rpx 32rpx 60rpx; }
.page-title { font-size: 38rpx; font-weight: 800; color: #ffffff; }
.page-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8fa3bf; }

.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 26rpx 0;
}
.cat {
  font-size: 22rpx;
  color: #8ce6cf;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(140, 230, 207, 0.1);
}

.list { display: flex; flex-direction: column; gap: 20rpx; }
.item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #16233d, #0f1c33);
}
.item-emoji { font-size: 52rpx; }
.item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.item-row { display: flex; align-items: center; gap: 14rpx; }
.item-name { font-size: 28rpx; font-weight: 700; color: #ffffff; flex: 1; }
.item-cat { font-size: 20rpx; color: #7d8ba0; }
.item-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9fb7d4;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-arrow { font-size: 36rpx; color: #5b6c84; }