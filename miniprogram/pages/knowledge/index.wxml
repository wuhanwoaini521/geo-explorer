<view class="knowledge-page geo-theme-dark">
  <view class="knowledge-head" style="padding-top:{{headerTop}}px">
    <view class="knowledge-heading"><text class="knowledge-title">知识</text><text class="knowledge-subtitle">构建你的地球知识地图</text></view>
    <view class="knowledge-head-mark" aria-label="全部知识">≡</view>
  </view>
  <view class="knowledge-search"><text class="knowledge-search-mark">⌕</text><input value="{{query}}" placeholder="搜索知识、地貌或关键词" placeholder-class="knowledge-placeholder" confirm-type="search" bindinput="onQueryInput" /><text wx:if="{{query}}" bindtap="onQueryClear" class="knowledge-clear">×</text></view>

  <scroll-view class="knowledge-scroll" style="top:{{scrollTop}}px" scroll-y="true" enhanced show-scrollbar="{{false}}">
    <view class="atlas-section">
      <view class="atlas-graph">
        <view class="atlas-edge atlas-edge-0"></view><view class="atlas-edge atlas-edge-1"></view><view class="atlas-edge atlas-edge-2"></view><view class="atlas-edge atlas-edge-3"></view>
        <view class="atlas-edge atlas-edge-4"></view><view class="atlas-edge atlas-edge-5"></view><view class="atlas-edge atlas-edge-6"></view><view class="atlas-edge atlas-edge-7"></view>
        <view class="atlas-core"><canvas wx:if="{{!earthFailed}}" id="knowledgeEarthCanvas" type="webgl" class="atlas-earth-canvas"></canvas><view wx:else class="atlas-earth-fallback"><view class="atlas-earth-land atlas-earth-land-one"></view><view class="atlas-earth-land atlas-earth-land-two"></view><view class="atlas-earth-glint"></view></view><cover-view class="atlas-core-caption">地球系统</cover-view></view>
        <view wx:for="{{nodes}}" wx:key="id" class="atlas-node atlas-node-{{item.status}}" style="left:{{item.x}}%;top:{{item.y}}%" data-topic-id="{{item.topicId}}" aria-label="{{item.label}}，{{item.statusLabel}}" bindtap="onOpenNode">
          <view class="atlas-node-image-wrap"><image wx:if="{{item.image}}" class="atlas-node-image" src="{{item.image}}" mode="aspectFill"></image><text wx:else class="atlas-node-fallback">◇</text><text class="atlas-node-state"></text></view>
          <text class="atlas-node-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="knowledge-section-title knowledge-recommended-heading"><text>推荐知识</text><text class="knowledge-section-action">更多 ›</text></view>
    <scroll-view class="featured-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="featured-row">
        <view wx:for="{{featuredItems}}" wx:key="id" class="featured-card" data-id="{{item.id}}" bindtap="onOpen">
          <image wx:if="{{item.image && !failedImages[item.id]}}" class="featured-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
          <view wx:else class="featured-fallback">{{item.emoji}}</view><view class="featured-shade"></view>
          <view class="featured-copy"><text class="featured-category">{{item.category}}</text><text class="featured-title">{{item.title}}</text><text class="featured-summary">{{item.summary}}</text></view>
        </view>
      </view>
    </scroll-view>

    <view class="knowledge-section-title knowledge-process-heading"><text>知识专题</text><text class="knowledge-section-action">更多 ›</text></view>
    <scroll-view class="process-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="process-row">
        <view wx:for="{{processCards}}" wx:key="id" class="process-card" data-id="{{item.id}}" bindtap="onOpenProcess">
          <image wx:if="{{item.image && !failedImages[item.id]}}" class="process-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image><view wx:else class="process-image-fallback">{{item.emoji}}</view><view class="process-shade"></view>
          <view class="process-copy"><text class="process-kicker">{{item.kicker}}</text><text class="process-title">{{item.title}}</text><text class="process-question">{{item.question}}</text><text class="process-meta">{{item.stepsText}} ›</text></view>
        </view>
      </view>
    </scroll-view>

    <geo-section-heading class="knowledge-library-heading" kicker="FIELD LIBRARY" title="全部知识" caption="{{items.length}} / {{total}}" />
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-row"><text wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'category-active' : ''}}" data-category="{{item}}" bindtap="onCategoryTap">{{item}}</text></view></scroll-view>
    <view wx:if="{{!empty}}" class="knowledge-grid"><view class="knowledge-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen"><image wx:if="{{item.image && !failedImages[item.id]}}" class="knowledge-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image><view wx:else class="knowledge-image-fallback">{{item.emoji}}</view><view class="knowledge-card-shade"></view><view class="knowledge-card-copy"><view class="card-topline"><text class="knowledge-card-cat">{{item.category}}</text><text wx:if="{{item.unlocked}}" class="knowledge-unlocked">探索解锁</text></view><text class="knowledge-card-title">{{item.title}}</text><text class="knowledge-card-body">{{item.summary}}</text></view></view></view>
    <geo-empty-state wx:else title="没有匹配的知识条目" description="试试其他关键词或分类" />
    <view class="knowledge-bottom-space"></view>
  </scroll-view>
</view>
