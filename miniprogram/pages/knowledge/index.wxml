<view class="knowledge-page">
  <view class="knowledge-head"><text class="knowledge-back" bindtap="onBack">‹</text><text class="knowledge-title">相关知识</text><text class="knowledge-more">•••</text></view>
  <view class="knowledge-tabs"><text wx:for="{{categories}}" wx:key="*this" class="knowledge-tab {{activeTab === item ? 'knowledge-tab-active' : ''}}" data-category="{{item}}" bindtap="onCategoryTap">{{item}}</text></view>
  <scroll-view class="knowledge-list" scroll-y="true">
    <view wx:if="{{!empty}}">
      <view class="knowledge-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <image class="knowledge-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="knowledge-card-shade"></view>
        <view class="knowledge-card-copy"><text class="knowledge-card-title">{{item.title}}</text><text class="knowledge-card-body">{{item.content}}</text></view>
      </view>
    </view>
    <view wx:else class="knowledge-empty">没有匹配的知识条目</view>
  </scroll-view>
</view>
