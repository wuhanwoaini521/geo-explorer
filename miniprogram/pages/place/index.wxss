.page { min-height: 100vh; background: #07131f; color: #f3f8fc; }
.detail-hero { position: relative; height: 690rpx; overflow: hidden; }
.detail-hero-image, .detail-hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }.detail-hero-fallback { background: linear-gradient(145deg, #244f70, #081522 76%); }
.detail-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5, 18, 32, .65) 0%, rgba(7, 19, 31, .06) 42%, #07131f 100%); }
.detail-nav { position: absolute; z-index: 2; top: calc(env(safe-area-inset-top) + 24rpx); left: 28rpx; right: 28rpx; display: flex; align-items: center; justify-content: space-between; }
.detail-back { font-size: 64rpx; line-height: 36rpx; color: #fff; }
.detail-nav-actions { display: flex; align-items: center; gap: 22rpx; }
.detail-fav, .detail-more { color: #fff; font-size: 35rpx; }
.detail-fav.on { color: #ff7791; }
.detail-more { letter-spacing: 6rpx; font-size: 28rpx; }
.detail-heading { position: absolute; z-index: 2; left: 32rpx; right: 32rpx; bottom: 52rpx; display: flex; flex-direction: column; }
.detail-kicker { font-size: 22rpx; color: #8fc5ed; letter-spacing: 2rpx; }
.detail-name { margin-top: 10rpx; font-size: 54rpx; font-weight: 800; letter-spacing: 1rpx; }
.detail-name-en { margin-top: 2rpx; color: rgba(240, 248, 255, .72); font-size: 24rpx; letter-spacing: 1rpx; }
.detail-elevation { margin-top: 18rpx; color: #f6fbff; font-size: 25rpx; font-weight: 700; }
.detail-content { box-sizing: border-box; height: calc(100vh - 560rpx); min-height: 500rpx; padding: 0 24rpx calc(env(safe-area-inset-bottom) + 50rpx); }
.detail-tabs { display: flex; gap: 28rpx; height: 82rpx; align-items: center; white-space: nowrap; }
.detail-tab { color: #71879b; font-size: 23rpx; padding: 12rpx 4rpx; }
.detail-tab.active { color: #eaf6ff; border-bottom: 5rpx solid #2aa5ee; }
.detail-tab-panel { min-height: 280rpx; }
.detail-tab-image { margin-top: 20rpx; }
.detail-tab-image-fallback { display: flex; align-items: center; justify-content: center; height: 250rpx; margin-top: 20rpx; border-radius: 16rpx; background: linear-gradient(145deg, #244f70, #081522 76%); color: #a9dff7; font-size: 22rpx; }
.tab-empty { display: block; margin-top: 24rpx; color: #8fa8b9; font-size: 22rpx; }
.detail-panel { padding: 28rpx; border-radius: 18rpx; background: #112536; border: 1rpx solid rgba(176, 214, 240, .14); }
.panel-label { display: block; color: #79b7df; font-size: 21rpx; letter-spacing: 2rpx; }
.panel-title { display: block; margin-top: 12rpx; font-size: 30rpx; font-weight: 700; line-height: 1.45; }
.panel-body { display: block; margin-top: 14rpx; color: #abc0d0; font-size: 24rpx; line-height: 1.7; }
.panel-data { display: flex; gap: 12rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(180, 215, 236, .12); }
.panel-data > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.data-value { color: #eaf5fb; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.data-label { color: #70889d; font-size: 19rpx; }
.detail-inline-image { width: 100%; height: 250rpx; margin-top: 22rpx; border-radius: 16rpx; opacity: .92; }
.key-section, .detail-facts, .section { margin-top: 32rpx; }
.section-title { display: block; color: #edf7fc; font-size: 28rpx; font-weight: 700; }
.key-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 21rpx 0; color: #718a9f; font-size: 23rpx; border-bottom: 1rpx solid rgba(177, 210, 232, .13); }
.key-row text:last-child { max-width: 74%; color: #c7d8e4; text-align: right; }
.fact { display: flex; gap: 16rpx; padding: 18rpx 0; color: #adc0cf; font-size: 23rpx; line-height: 1.6; border-bottom: 1rpx solid rgba(177, 210, 232, .1); }
.fact-index { color: #5f91b5; font-family: Georgia, serif; font-size: 28rpx; }
.explore-cta { display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; padding: 24rpx; border-radius: 16rpx; background: linear-gradient(135deg, #124d78, #0c304e); border: 1rpx solid rgba(72, 181, 244, .3); }
.explore-cta > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.cta-title { font-size: 27rpx; font-weight: 700; }
.cta-sub { color: #8bb1c8; font-size: 19rpx; }
.cta-btn { flex-shrink: 0; margin: 0; padding: 0 22rpx; height: 64rpx; line-height: 64rpx; border: 0; border-radius: 32rpx; background: #219bea; color: #fff; font-size: 23rpx; }
.cta-btn::after { border: 0; }
.section-row { display: flex; align-items: center; justify-content: space-between; }
.section-link { color: #58baff; font-size: 22rpx; }
.related-list { display: flex; gap: 14rpx; margin-top: 16rpx; }
.related-card { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; padding: 17rpx; border-radius: 14rpx; background: #102335; }
.related-mark,
.k-mark { display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #9bdcff; background: rgba(45, 160, 222, .12); border: 1rpx solid rgba(75, 181, 238, .3); font-size: 18rpx; letter-spacing: 1rpx; }
.related-mark { width: 58rpx; height: 58rpx; border-radius: 50%; }
.k-mark { width: 52rpx; height: 52rpx; border-radius: 12rpx; }
.related-name { font-size: 24rpx; font-weight: 700; }
.related-sub { color: #7f98ab; font-size: 19rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.k-list { display: flex; flex-direction: column; gap: 10rpx; margin-top: 16rpx; }
.k-item { display: flex; align-items: center; gap: 14rpx; padding: 17rpx; border-radius: 12rpx; background: #102335; color: #8fc5e7; }
.k-title { flex: 1; color: #dceaf3; font-size: 23rpx; }
.k-cat { color: #7b9bb0; font-size: 19rpx; }
.footer-note { display: block; margin-top: 34rpx; padding-bottom: 24rpx; color: #5c7385; font-size: 19rpx; line-height: 1.6; }
