<view class="page" wx:if="{{place}}">
  <view class="detail-hero">
    <image class="detail-hero-image" src="{{place.heroImage}}" mode="aspectFill"></image>
    <view class="detail-hero-shade"></view>
    <view class="detail-nav">
      <text class="detail-back" bindtap="onBack">‹</text>
      <view class="detail-nav-actions">
        <text bindtap="onToggleFavorite" class="detail-fav {{favorited ? 'on' : ''}}">{{favorited ? '♥' : '♡'}}</text>
        <text class="detail-more">•••</text>
      </view>
    </view>
    <view class="detail-heading">
      <text class="detail-kicker">{{place.typeLabel}} · {{place.region}}</text>
      <text class="detail-name">{{place.name}}</text>
      <text class="detail-name-en">{{place.nameEn}}</text>
      <text class="detail-elevation">{{place.elevText}} {{place.elevLabel}}</text>
    </view>
  </view>

  <scroll-view class="detail-content" scroll-y>
    <view class="detail-tabs">
      <text class="detail-tab active">概览</text>
      <text class="detail-tab">环境</text>
      <text class="detail-tab">地形</text>
      <text class="detail-tab">历史</text>
      <text class="detail-tab">相关知识</text>
    </view>

    <view class="detail-panel">
      <text class="panel-label">关于这座山</text>
      <text class="panel-title">{{place.shortDescription}}</text>
      <text class="panel-body">{{place.description}}</text>
      <view class="panel-data">
        <view><text class="data-value">{{place.coordText}}</text><text class="data-label">坐标</text></view>
        <view><text class="data-value">{{place.country}}</text><text class="data-label">所在地区</text></view>
        <view><text class="data-value">{{place.geologicalAge || '喜马拉雅造山带'}}</text><text class="data-label">地质背景</text></view>
      </view>
    </view>

    <image class="detail-inline-image" src="{{place.heroImage}}" mode="aspectFill"></image>

    <view class="key-section">
      <text class="section-title">关键数据</text>
      <view class="key-row"><text>成因</text><text>{{place.formation}}</text></view>
      <view class="key-row" wx:if="{{place.climate}}"><text>气候</text><text>{{place.climate}}</text></view>
      <view class="key-row"><text>{{place.elevLabel}}</text><text>{{place.elevText}}</text></view>
    </view>

    <view class="detail-facts" wx:if="{{place.facts.length}}">
      <text class="section-title">你知道吗</text>
      <view class="fact" wx:for="{{place.facts}}" wx:key="*this"><text class="fact-index">0{{index + 1}}</text><text>{{item}}</text></view>
    </view>

    <view class="explore-cta" wx:if="{{place.explorationId}}">
      <view><text class="cta-title">{{place.explorationTitle}}</text><text class="cta-sub">沉浸式场景探索 · 真实地理数据驱动</text></view>
      <button class="cta-btn" bindtap="onStartExploration">进入探索 ›</button>
    </view>

    <view class="section related-section" wx:if="{{related.length}}">
      <view class="section-row"><text class="section-title">继续探索</text><text bindtap="onOpenMap" class="section-link">全部图鉴 ›</text></view>
      <view class="related-list"><view class="related-card" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenRelated"><text class="related-emoji">{{item.emoji}}</text><text class="related-name">{{item.name}}</text><text class="related-sub">{{item.shortDescription}}</text></view></view>
    </view>

    <view class="section" wx:if="{{knowledge.length}}"><text class="section-title">关联知识</text><view class="k-list"><view class="k-item" wx:for="{{knowledge}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenKnowledge"><text>{{item.emoji}}</text><text class="k-title">{{item.title}}</text><text class="k-cat">{{item.category}}</text></view></view></view>
    <text class="footer-note">数据来源：公开资料（Wikipedia / 官方测量公告）· 部分数值为近似值</text>
  </scroll-view>
</view>
