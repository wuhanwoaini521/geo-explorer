<view wx:if="{{ready}}" class="page" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
  <!-- ===== 环境图层（共享天空：数据驱动自引擎） ===== -->
  <view class="layer-sky" style="background:{{skyGradient}}"></view>

  <!-- ===== 山岳世界（world.style === 'mountain'：真实 DEM 渲染三景硬切换，同屏只挂载一张） ===== -->
  <block wx:if="{{worldMountain}}">
    <!-- 视图 A：远景全景（徒步→BC） -->
    <image wx:if="{{scene.plates.far && scene.op.far > 0}}" class="plate view view-a" mode="aspectFill" src="{{scene.plates.far}}" style="transform:translate3d(0,-{{par.far * 0.4}}px,0); opacity:{{scene.op.far}}"></image>

    <!-- 视图 B：中景山脊（冰瀑→C3），随海拔缓推近 -->
    <image wx:if="{{scene.plates.main && scene.op.main > 0}}" class="plate view view-b" mode="aspectFill" src="{{scene.plates.main}}" style="transform:translate3d(0,-{{par.mid * 0.3}}px,0) scale({{1 + (mntScale - 100) / 260}}); opacity:{{scene.op.main}}"></image>

    <!-- 视图 C：死亡区冰岩壁（冲顶段） -->
    <image wx:if="{{scene.plates.mid && scene.op.mid > 0}}" class="plate view view-c" mode="aspectFill" src="{{scene.plates.mid}}" style="transform:translate3d(0,-{{par.near * 0.3}}px,0); opacity:{{scene.op.mid}}"></image>

    <!-- 云海 / 云丝带（已下架：与照片级渲染风格冲突，保留图层结构） -->
    <image wx:if="{{scene.plates.cloud}}" class="plate pl-cloud" mode="aspectFit" src="{{scene.plates.cloud}}" style="transform:translate3d(0,-{{par.mid}}px,0); opacity:{{scene.op.cloud}}"></image>
  </block>

  <!-- 场景内空间路线：由 route Scene Data 驱动，路线贴在山体画布中而非 HUD。 -->
  <view wx:if="{{route && scene.mode !== 'summit'}}" class="scene-route" aria-label="{{route.name}}">
    <view wx:for="{{route.segments}}" wx:key="id" class="route-segment route-segment-muted" style="{{item.style}}"></view>
    <block wx:for="{{route.segments}}" wx:key="id">
      <view wx:if="{{item.completed}}" class="route-segment route-segment-completed" style="{{item.completedStyle}}"></view>
    </block>
    <view
      wx:for="{{route.waypoints}}"
      wx:key="id"
      class="route-waypoint route-waypoint-{{item.state}}"
      style="{{item.style}}"
      data-id="{{item.id}}"
      bindtap="onTapRouteWaypoint"
    >
      <view class="route-waypoint-dot"><text wx:if="{{item.state === 'completed'}}">✓</text></view>
      <view class="route-waypoint-label">
        <text class="route-waypoint-name">{{item.shortName}}</text>
        <text wx:if="{{item.state === 'current'}}" class="route-waypoint-alt">{{item.altitudeText}}</text>
      </view>
    </view>
    <view class="route-current" style="{{route.currentStyle}}"><view class="route-current-core"></view></view>
  </view>
  <view wx:if="{{route && scene.mode === 'summit'}}" class="summit-route-finish">
    <text>✓ {{route.name}} · 已抵达 {{route.currentName}}</text>
  </view>

  <!-- ===== 通用世界（非山岳：Marian 等） ===== -->
  <block wx:else>
    <!-- 海洋专属：表层光柱 + 上浮气泡（山脊/山峰不适用于水中） -->
    <block wx:if="{{worldOcean}}">
      <view class="ocean-rays" style="opacity:{{rayOpacity}}">
        <view class="ocean-ray ray-a"></view>
        <view class="ocean-ray ray-b"></view>
        <view class="ocean-ray ray-c"></view>
      </view>
      <view class="bubbles-layer">
        <view wx:for="{{bubbles}}" wx:key="id" class="bubble" style="left:{{item.left}}%; width:{{item.size}}px; height:{{item.size}}px; animation-duration:{{item.duration + 3}}s; animation-delay:{{item.delay}}s; opacity:{{item.opacity}}"></view>
      </view>
    </block>
    <view wx:if="{{!worldOcean}}" class="ridge far" style="transform:translate3d(0,-{{par.far}}px,0)">
      <view class="peak peak-a">▲</view>
      <view class="peak peak-b">◥</view>
    </view>
    <view wx:if="{{!worldOcean}}" class="ridge mid" style="transform:translate3d(0,-{{par.mid}}px,0)">
      <view class="peak peak-c">△</view>
    </view>
    <view class="ground-wrap" style="transform:translate3d(0,-{{par.ground}}px,0)">
      <view wx:if="{{!worldOcean}}" class="ground-veg" style="opacity:{{vegetation}}; background:{{greenTint}}"></view>
      <view class="ground-snow" style="opacity:{{worldOcean ? 0 : snowCover}}"></view>
      <view class="ground-main" style="background:linear-gradient(180deg,{{terrainTop}} 0%,{{terrainBottom}} 100%)"></view>
      <view class="ground-glare"></view>
    </view>
    <view class="flora-layer" style="transform:translate3d(0,-{{par.near}}px,0)">
      <text wx:for="{{flora}}" wx:key="emoji" class="flora-item" style="left:{{item.left}}%; bottom:{{item.bottom}}vh; font-size:{{item.size}}rpx">{{item.emoji}}</text>
    </view>
    <view class="climber" style="transform:translate3d(0,-{{par.climber}}px,0) rotate({{0-climberLean}}deg)">
      <text class="hillman">{{worldOcean ? '🤿' : '🧗'}}</text>
    </view>
  </block>

  <!-- 风雪粒子（强度=雪量，档位化；山岳世界仅雪线以上出现，避免盖脸） -->
  <view wx:if="{{!worldMountain || snowCover >= 0.35}}" class="snow-layer">
    <view wx:for="{{particles}}" wx:key="id" class="snow-flake" style="left:{{item.left}}%; width:{{item.size}}px; height:{{item.size}}px; animation-duration:{{item.duration}}s; animation-delay:{{item.delay}}s; opacity:{{item.opacity}}"></view>
  </view>

  <!-- 云雾罩（山岳世界用照片自带氛围，不再叠加） -->
  <view wx:if="{{!worldMountain}}" class="fog" style="opacity:{{fogOpacity}}"></view>

  <!-- ===== 顶部 HUD ===== -->
  <view class="hud-top">
    <view class="hud-left">
      <text class="elevation-num">{{elevationText}}</text>
      <text class="elevation-unit">{{ui.axisUnit}}</text>
    </view>
    <view class="hud-right">
      <view class="hud-metrics">
        <text wx:for="{{metricsShow}}" wx:key="key" class="metric">{{item.icon}} {{item.value}}{{item.unit}}</text>
        <text wx:if="{{metricsMore}}" class="metric metric-more" bindtap="onToggleMetrics">{{metricsOpen ? '收起 ▾' : '更多 ▸'}}</text>
      </view>
      <text class="hud-km">{{kmStage}}</text>
    </view>
  </view>

  <!-- 阶段信息卡（低打扰：名称 + 自然带宽 + 描述简述） -->
  <view class="stage-card">
    <text class="stage-emoji">{{stageEmoji}}</text>
    <view class="stage-main">
      <view class="stage-line">
        <text class="stage-name">{{stageName}}</text>
        <text class="stage-biome">{{biome}}</text>
      </view>
      <text class="stage-desc">{{stageDescription}}</text>
    </view>
    <text class="stage-next">{{nextStageName}}</text>
  </view>

  <view wx:if="{{route}}" class="route-status">
    <text class="route-status-k">当前位置</text>
    <text class="route-status-current">{{route.currentName}}</text>
    <text class="route-status-next">下一站 · {{route.nextName}}</text>
  </view>

  <!-- 进度条 -->
  <view class="progress-row">
    <text class="progress-ico">⛰</text>
    <view class="progress-track"><view class="progress-bar" style="width:{{pct}}%"></view></view>
    <text class="progress-pct">{{pct}}<text class="pct-sign">%</text></text>
  </view>

  <!-- 底部操作条 -->
  <view class="controls">
    <button class="ctl ctl-down" bindtap="onStepDown">
      <text class="ctl-glyph down">{{ui.backGlyph}}</text>
      <text class="ctl-label">{{ui.backLabel}}</text>
    </button>
    <view class="ctl-center">
      <text class="g-mark">🧭</text>
    </view>
    <button class="ctl ctl-up" bindtap="onStepUp">
      <text class="ctl-glyph up">{{ui.forwardGlyph}}</text>
      <text class="ctl-label">{{ui.forwardLabel}}</text>
    </button>
  </view>

  <!-- 知识提示条 -->
  <view wx:if="{{hint.show}}" class="hint" bindtap="onHintTap">
    <text class="hint-ico">💡</text>
    <text class="hint-text">{{hint.text}}</text>
    <text class="hint-arrow">›</text>
  </view>

  <!-- 右侧 Rail 仅作路线概览；空间位置以山体内路线为准。 -->
  <view wx:if="{{route}}" class="rail">
    <view class="rail-track"></view>
    <view class="rail-fill" style="height:{{progress*100}}%"></view>
    <view
      wx:for="{{route.rail}}"
      wx:key="id"
      class="rail-node rail-node-{{item.state}}"
      style="top:{{item.top}}%"
      data-id="{{item.id}}"
      bindtap="onTapRouteWaypoint"
    >
      <text class="rail-elev">{{item.label}}</text>
      <text wx:if="{{item.state === 'completed'}}" class="rn rn-completed">✓</text>
      <text wx:elif="{{item.state === 'current'}}" class="rn rn-current">◎</text>
      <text wx:else class="rn rn-upcoming">·</text>
    </view>
    <text class="rail-cap rail-cap-top">峰顶</text>
    <text class="rail-cap rail-cap-bottom">起点</text>
  </view>

  <!-- ===== 开始引导 ===== -->
  <view wx:if="{{intro}}" class="overlay intro">
    <view class="intro-card">
      <text class="ico">{{emoji}}</text>
      <text class="intro-title">{{title}}</text>
      <text class="intro-sub">{{subtitle}}</text>
      <view class="intro-meta">
        <text class="meta-chip">📍 {{metaPlace}} · {{metaRegion}}</text>
        <text class="meta-chip">⏱️ 约 {{estMinutes}} 分钟</text>
      </view>
      <view class="intro-desc">{{metaDesc}}</view>
      <button class="btn-primary" bindtap="onStartClimb">开始探索</button>
      <view class="intro-hint">{{ui.advanceHint}}</view>
    </view>
  </view>

  <!-- ===== 自然带横幅 ===== -->
  <view wx:if="{{stageBanner.show}}" class="stage-banner">
    <text class="sb-emoji">{{stageBanner.emoji}}</text>
    <view class="sb-main">
      <text class="sb-name">{{stageBanner.title}}</text>
      <text class="sb-biome">{{stageBanner.biome}}</text>
    </view>
  </view>

  <!-- ===== 途经点介绍卡 ===== -->
  <view wx:if="{{waypointCard && waypointCard.show}}" class="wpc-mask" catchtouchmove="noop">
    <view class="wpc-card">
      <view class="wpc-head">
        <text class="wpc-name">{{waypointCard.name}}</text>
        <text wx:if="{{waypointCard.altitudeText}}" class="wpc-alt">{{waypointCard.altitudeText}}</text>
      </view>
      <text class="wpc-desc">{{waypointCard.desc}}</text>
      <text wx:if="{{waypointCard.lockedKnowledge}}" class="wpc-lock">🔒 抵达此处后可解锁相关知识</text>
      <button class="wpc-btn" bindtap="onWaypointCardClose">继续攀登</button>
    </view>
  </view>

  <!-- ===== 知识卡（分层） ===== -->
  <knowledge-popup
    wx:if="{{openNode}}"
    visible="{{openNode ? true : false}}"
    node="{{openNode}}"
    axis-label="{{ui.axisLabel}}"
    axis-unit="{{ui.axisUnit}}"
    bind:close="onPopupClose"
    bind:continue="onPopupContinue"
  />

  <!-- ===== 随堂 Quiz（答错不阻断） ===== -->
  <view wx:if="{{quiz && quiz.show}}" class="quiz-mask" catchtouchmove="noop">
    <view class="quiz-card">
      <view class="quiz-head">
        <text class="quiz-ico">{{quiz.nodeEmoji}}</text>
        <text class="quiz-tag">随堂测验</text>
      </view>
      <text class="quiz-lead">{{quiz.lead}}</text>
      <text class="quiz-q">{{quiz.question}}</text>
      <view class="quiz-options">
        <view
          wx:for="{{quiz.options}}"
          wx:key="*this"
          class="quiz-opt {{quiz.selected === index ? 'sel' : ''}} {{quiz.revealed && quiz.selected === index && quiz.correct ? 'right' : ''}} {{quiz.revealed && quiz.selected === index && !quiz.correct ? 'wrong' : ''}}"
          data-index="{{index}}"
          bindtap="onQuizPick"
        >{{item}}</view>
      </view>
      <view wx:if="{{quiz.revealed}}" class="quiz-result">
        <text class="quiz-verdict">{{quiz.correct ? '✓ 回答正确' : '✗ 答错了也没关系'}}</text>
        <text class="quiz-explain">{{quiz.explanation}}</text>
      </view>
      <button wx:if="{{quiz.revealed}}" class="quiz-btn" bindtap="onQuizContinue">继续探索</button>
      <view wx:else class="quiz-skip" bindtap="onQuizClose">跳过（不影响进度）</view>
    </view>
  </view>

  <!-- ===== 终局庆祝 ===== -->
  <view wx:if="{{celebration}}" class="overlay celebration">
    <text class="celebrate-emoji">{{destination.emoji}}</text>
    <text class="celebrate-title">{{destination.title}}</text>
    <text class="celebrate-elev">{{destination.tagline}}</text>
    <text class="celebrate-msg">{{metaPlace}} · {{ui.axisLabel}} {{maxElevationText}} {{ui.axisUnit}}</text>
  </view>

  <!-- ===== 登顶总结（含成就 + 三个动作） ===== -->
  <view wx:if="{{summit && summaryStats}}" class="overlay summit">
    <view class="summit-card">
      <view class="summit-head">
        <text class="summit-badge">🏆</text>
        <view class="summit-head-text">
          <text class="summit-title">探险完成！</text>
          <text class="summit-sub">你探索了 {{metaPlace}} · {{ui.extentWord}} {{summaryStats.maxText}} {{ui.axisUnit}}</text>
        </view>
      </view>

      <view class="summit-stats">
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.durationText}}</text>
          <text class="sstat-label">用时</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.unlocked}}/{{summaryStats.nodeTotal}}</text>
          <text class="sstat-label">知识点</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.quizText}}</text>
          <text class="sstat-label">随堂</text>
        </view>
        <view class="sstat">
          <text class="sstat-val">{{summaryStats.accuracyText}}</text>
          <text class="sstat-label">正确率</text>
        </view>
      </view>

      <view class="summit-band">
        <text class="summit-band-t">{{ui.stagesLabel}}</text>
        <view class="band-chips">
          <text wx:for="{{summaryStats.stageNames}}" wx:key="*this" class="band-chip">{{item}}</text>
          <text class="band-ratio">{{summaryStats.stageNames.length}}/{{summaryStats.stageTotal}}</text>
        </view>
      </view>

      <view class="summit-ach">
        <text class="summit-band-t">获得成就</text>
        <view wx:if="{{summaryStats.achievements.length}}" class="ach-list">
          <view wx:for="{{summaryStats.achievements}}" wx:key="id" class="ach-item">
            <text class="ach-emoji">{{item.emoji}}</text>
            <view class="ach-text">
              <text class="ach-title">{{item.title}}</text>
              <text class="ach-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
        <text wx:else class="ach-empty">继续探索更多自然带与随堂题，解锁成就吧～</text>
      </view>

      <view class="summit-actions">
        <button class="act act-primary" bindtap="onRestart">重新探索</button>
        <button class="act act-ghost" bindtap="onGoProfile">探索记录</button>
        <button class="act act-ghost" bindtap="onBackHome">返回首页</button>
      </view>
    </view>
  </view>
</view>
