/* ============ 探索场景（沉浸式 2.5D 视差） ============ */
.page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.scene {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1b2b4a;
}

.layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  will-change: transform;
}

/* ---------- 天空 ---------- */
.sky {
  height: 100%;
  z-index: 1;
}
.sun {
  position: absolute;
  right: 16%;
  top: 12%;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 244, 214, 0.95), rgba(255, 236, 190, 0.25) 70%, transparent);
}
.cloud {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  filter: blur(6rpx);
}
.cloud-a { width: 320rpx; height: 46rpx; left: 8%;  top: 20%; }
.cloud-b { width: 240rpx; height: 38rpx; left: 60%; top: 30%; }
.cloud-c { width: 200rpx; height: 30rpx; left: 30%; top: 16%; }

/* ---------- 山体剪影（border 三角）通用 ---------- */
.ridge {
  bottom: 0;
  z-index: 2;
}
.peak {
  position: absolute;
  width: 0;
  height: 0;
}
.far { z-index: 2; }
.far .peak {
  border-bottom: 340rpx solid rgba(96, 132, 178, 0.5);
}
.far-a {
  border-left: 300rpx solid transparent;
  border-right: 440rpx solid transparent;
  left: -10%;
  bottom: -10rpx;
}
.far-b {
  border-left: 460rpx solid transparent;
  border-right: 340rpx solid transparent;
  left: 28%;
  bottom: -6rpx;
}
.far-c {
  border-left: 260rpx solid transparent;
  border-right: 320rpx solid transparent;
  left: 66%;
  bottom: -10rpx;
}

.mid { z-index: 3; }
.mid .peak {
  background: #1f3e66;
}
.mid-a {
  border-left: 360rpx solid transparent;
  border-right: 420rpx solid transparent;
  left: -6%;
  bottom: -24rpx;
}
.mid-b {
  border-left: 480rpx solid transparent;
  border-right: 300rpx solid transparent;
  left: 30%;
  bottom: -20rpx;
}
.snowcap {
  position: absolute;
  left: 44%;
  bottom: 118rpx;
  width: 90rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #ffffff, rgba(255, 255, 255, 0.55));
  clip-path: polygon(0% 100%, 50% 20%, 100% 100%);
}

.near { z-index: 4; }
.near .peak {
  background: rgba(56, 74, 96, 0.9);
}
.near-a {
  border-left: 460rpx solid transparent;
  border-right: 340rpx solid transparent;
  left: -12%;
  bottom: -40rpx;
}
.near-b {
  border-left: 380rpx solid transparent;
  border-right: 480rpx solid transparent;
  left: 52%;
  bottom: -36rpx;
}
.trees {
  position: absolute;
  left: 6%;
  bottom: 26rpx;
  font-size: 44rpx;
  letter-spacing: 20rpx;
  line-height: 1;
}
.tree { display: inline-block; }

/* ---------- 云雾遮罩 ---------- */
.fog {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55vh;
  z-index: 6;
  background: linear-gradient(180deg, transparent, rgba(220, 230, 244, 0.32));
  pointer-events: none;
}

/* ---------- 地面 ---------- */
.ground {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34vh;
  z-index: 5;
}
.ground-base {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100%;
  background: linear-gradient(180deg, rgba(70, 92, 110, 0) 0%, #2c3c50 55%, #22303f 100%);
}
.ground-snow {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100%;
  background: linear-gradient(180deg, rgba(255,255,255,0) 40%, rgba(240,244,248,0.9) 100%);
  transition: opacity 0.3s ease;
}
.ground-veg {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42%;
  border-radius: 30% 30% 0 0;
  transition: opacity 0.3s ease;
}

/* ---------- 攀登者 ---------- */
.climber {
  position: absolute;
  left: 12%;
  bottom: 28vh;
  z-index: 7;
  font-size: 56rpx;
  line-height: 1;
  filter: drop-shadow(0 0 8rpx rgba(0,0,0,0.25));
  transition: transform 0.12s linear;
}
.climber-body {
  display: inline-block;
  animation: bob 1.6s ease-in-out infinite;
}
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* ---------- 飘雪 ---------- */
.snowfall {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 8;
  pointer-events: none;
}
.flake {
  position: absolute;
  top: -30px;
}
.flake-core {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  animation: sway ease-in-out infinite alternate;
}
@keyframes sway {
  from { transform: translateX(-24rpx); }
  to { transform: translateX(26rpx); }
}
@keyframes fall {
  from { transform: translateY(-8vh); }
  to { transform: translateY(115vh); }
}
/* fall 由 flake 自身动画承载：见下方 */
.flake {
  animation: fall linear infinite;
}

/* ---------- 右侧海拔刻度 ---------- */
.alt-rail {
  position: absolute;
  right: 16rpx;
  top: 24vh;
  bottom: 30vh;
  width: 56rpx;
  z-index: 9;
}
.rail-line {
  position: absolute;
  left: 26rpx;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: rgba(255, 255, 255, 0.28);
}
.rail-summit {
  position: absolute;
  top: -6rpx;
  left: 0;
  font-size: 20rpx;
  color: #8ce6cf;
}
.mark {
  position: absolute;
  left: 0;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mark-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.08);
  color: #cfe4f6;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}
.mark.found .mark-dot {
  background: rgba(46, 198, 176, 0.9);
  border-color: #8ce6cf;
}
.mark-elev {
  font-size: 18rpx;
  color: rgba(230, 240, 250, 0.85);
  margin-top: 4rpx;
  white-space: nowrap;
}

/* ---------- HUD ---------- */
.hud {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 15;
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx 0;
  background: linear-gradient(180deg, rgba(5, 12, 26, 0.5), transparent);
}
.hud-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hud-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.hud-chip {
  font-size: 22rpx;
  color: #b9d5ef;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}
.hud-stage {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}
.stage-emoji {
  font-size: 52rpx;
  line-height: 1;
}
.stage-box {
  display: flex;
  flex-direction: column;
}
.stage-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}
.stage-desc {
  font-size: 20rpx;
  color: rgba(214, 227, 242, 0.85);
  margin-top: 2rpx;
}
.hud-elev {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.elev-num {
  font-size: 88rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  text-shadow: 0 2rpx 18rpx rgba(0,0,0,0.25);
}
.elev-unit {
  font-size: 30rpx;
  color: #8ce6cf;
  font-weight: 600;
}
.elev-km {
  font-size: 22rpx;
  color: #cfe2f2;
}

/* ---------- 底部操作 ---------- */
.dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 16;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: linear-gradient(180deg, transparent, rgba(8, 14, 30, 0.92));
}
.dock-metrics {
  display: flex;
  margin-top: 18rpx;
  gap: 16rpx;
}
.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}
.metric-v {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}
.metric-k {
  font-size: 20rpx;
  color: rgba(204, 220, 240, 0.85);
  margin-top: 4rpx;
}
.dock-actions {
  display: flex;
  margin-top: 20rpx;
  gap: 20rpx;
}
.act {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.act-up {
  background: linear-gradient(135deg, #2fb6a0, #1d8fa6);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(29, 143, 166, 0.4);
}
.act-down {
  background: rgba(255, 255, 255, 0.1);
  color: #cfe2f2;
}
.act:active { opacity: 0.85; }

/* ---------- 发现提示 ---------- */
.hint {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(env(safe-area-inset-bottom) + 270rpx);
  z-index: 30;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(20, 32, 54, 0.85);
  border: 1rpx solid rgba(140, 230, 207, 0.5);
  color: #e6f7f1;
  font-size: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.3);
  animation: fadeIn 0.3s ease both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateX(-50%) translateY(8rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ---------- 覆盖层（intro / summit / summary） ---------- */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 14, 28, 0.78);
  backdrop-filter: blur(10rpx);
}
.overlay-dim { background: rgba(8, 14, 28, 0.55); }
.card {
  width: 620rpx;
  max-width: 88vw;
  max-height: 78vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  padding: 44rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #1b2b4a, #12203c);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}
.card-emoji {
  font-size: 96rpx;
  text-align: center;
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  text-align: center;
}
.card-sub {
  font-size: 24rpx;
  color: #a9c1dc;
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.6;
}
.card-fact {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
}
.card-fact-k { font-size: 22rpx; color: #8fa3bf; }
.card-fact-v { font-size: 24rpx; color: #eaf3fc; font-weight: 600; }

.summit-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffd97a;
  text-align: center;
}
.summit-sub {
  font-size: 26rpx;
  color: #eaf6ff;
  text-align: center;
  margin-top: 14rpx;
}
.summit-line {
  font-size: 22rpx;
  color: #a9c1dc;
  text-align: center;
  margin-top: 18rpx;
  line-height: 1.6;
}

.learned-list {
  margin: 26rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.learned-item {
  font-size: 24rpx;
  color: #d7e6f5;
  line-height: 1.5;
  border-left: 4rpx solid #2fb6a0;
  padding-left: 14rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 26rpx;
  letter-spacing: 2rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #2fb6a0, #1d8fa6);
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(29, 143, 166, 0.4);
}
.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: #cfe2f2;
}
.btn:active { opacity: 0.86; }