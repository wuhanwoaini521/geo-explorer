page { background: #07131f; color: #f2f7fb; }
.camp-page { min-height: 100vh; background: #07131f; }
.camp-hero { position: relative; height: 30vh; min-height: 340rpx; overflow: hidden; }
.camp-hero-image { width: 100%; height: 100%; display: block; }
.camp-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3,13,24,.18), rgba(7,19,31,.1) 42%, #07131f 100%); }
.camp-nav { position: absolute; top: calc(env(safe-area-inset-top) + 54rpx); left: 28rpx; right: 28rpx; display: flex; justify-content: space-between; align-items: center; }
.camp-back { font-size: 64rpx; line-height: 34rpx; color: #fff; text-shadow: 0 2rpx 8rpx #07131f; }
.camp-more { color: #fff; font-size: 30rpx; letter-spacing: 8rpx; }
.camp-heading { position: absolute; left: 30rpx; right: 30rpx; bottom: 32rpx; display: flex; flex-direction: column; gap: 5rpx; }
.camp-title { font-size: 40rpx; font-weight: 800; }
.camp-range { color: #b8d9ee; font-size: 25rpx; }
.camp-body { padding: 0 24rpx calc(env(safe-area-inset-bottom) + 34rpx); }
.camp-tabs { display: flex; white-space: nowrap; gap: 12rpx; padding: 16rpx 0 18rpx; }
.camp-tab { padding: 10rpx 24rpx; border-radius: 30rpx; color: #91a7ba; background: #112536; font-size: 22rpx; }
.camp-tab-active { color: #102236; background: #eff8ff; }
.camp-copy { padding: 20rpx 18rpx 24rpx; background: #102b43; border-radius: 16rpx; }
.camp-section-title { display: block; font-size: 29rpx; font-weight: 800; }
.camp-section-body { display: block; margin-top: 14rpx; color: #c1d3e1; font-size: 24rpx; line-height: 1.75; }
.camp-inline-image { display: block; width: 100%; height: 220rpx; margin-top: 16rpx; border-radius: 14rpx; }
.camp-facts { margin-top: 24rpx; border-top: 1rpx solid rgba(177,210,232,.16); }
.camp-facts-title { display: block; margin: 22rpx 0 10rpx; font-size: 29rpx; font-weight: 800; }
.camp-fact { display: flex; justify-content: space-between; padding: 19rpx 18rpx; border: 1rpx solid rgba(177,210,232,.08); border-bottom: none; color: #8ca6ba; font-size: 23rpx; }
.camp-fact:last-child { border-bottom: 1rpx solid rgba(177,210,232,.08); }
.camp-fact text:last-child { color: #e9f4fb; }
.camp-knowledge-link { margin-top: 22rpx; padding: 20rpx; border-radius: 14rpx; color: #8fd2ff; background: #102b43; text-align: center; font-size: 24rpx; }
