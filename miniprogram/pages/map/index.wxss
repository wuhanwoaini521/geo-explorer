/* 地图页：场景选择 —— 暖纸基调 */
.page {
  min-height: 100vh;
  background: #f6f0dd;
  color: #37311e;
  padding: 0 32rpx 60rpx;
  box-sizing: border-box;
}
.head {
  padding: 40rpx 8rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.head-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #37311e;
}
.head-sub {
  font-size: 24rpx;
  color: #94896a;
}
.section {
  margin-top: 16rpx;
}
.section-title,
.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #37311e;
  padding: 12rpx 8rpx;
  letter-spacing: 2rpx;
}

/* 开放卡片 */
.open-card {
  background: #fffdf4;
  border: 1rpx solid rgba(151, 124, 66, 0.16);
  border-radius: 20rpx;
  padding: 30rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 98, 45, 0.08);
}
.open-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.open-emoji {
  font-size: 64rpx;
}
.open-top-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.open-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #37311e;
  letter-spacing: 1rpx;
}
.open-sub {
  font-size: 22rpx;
  color: #94896a;
}
.open-done {
  font-size: 22rpx;
  color: #a06a10;
  background: rgba(168, 119, 23, 0.1);
  border: 1rpx solid rgba(168, 119, 23, 0.22);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}
.open-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.open-plate {
  position: relative;
  height: 300rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(122, 86, 14, 0.28);
}
.open-plate-img {
  width: 100%;
  height: 100%;
  display: block;
}
.open-plate-tag {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(43, 33, 14, 0.62);
  color: #ffe19a;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
.open-chip {
  font-size: 20rpx;
  color: #6f6547;
  background: rgba(151, 124, 66, 0.1);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}
.open-desc {
  font-size: 24rpx;
  color: #6f6547;
  line-height: 1.7;
}
.open-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.open-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(151, 124, 66, 0.16);
  overflow: hidden;
}
.open-bar {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #b57f1f, #d9a63a);
  transition: width 0.4s ease;
}
.open-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #a06a10;
}
.open-reached {
  font-size: 20rpx;
  color: #94896a;
}
.open-btn {
  margin-top: 6rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #e3b04b, #b57f1f);
  border: 2rpx solid #7a5510;
  box-shadow: 0 5rpx 0 #7a5510;
  color: #fffdf4;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.open-btn::after { border: none; }
.open-btn:active { transform: translateY(3rpx); box-shadow: 0 2rpx 0 #7a5510; opacity: 0.94; }

/* 即将开放网格 */
.coming-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.coming-card {
  background: #f1e9d0;
  border: 1rpx dashed rgba(151, 124, 66, 0.3);
  border-radius: 20rpx;
  padding: 26rpx 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.coming-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.coming-emoji {
  font-size: 48rpx;
  filter: grayscale(0.55);
  opacity: 0.8;
}
.coming-tag {
  font-size: 20rpx;
  color: #8a7c58;
  background: rgba(151, 124, 66, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.coming-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6f6547;
}
.coming-region {
  font-size: 22rpx;
  color: #94896a;
}
.coming-basis {
  font-size: 22rpx;
  color: #4a708c;
}
.foot-tip {
  margin-top: 36rpx;
  font-size: 22rpx;
  color: #94896a;
  text-align: center;
  line-height: 1.6;
}
