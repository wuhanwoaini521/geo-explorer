.page { position: fixed; inset: 0; overflow: hidden; color: var(--geo-ink); background: var(--geo-bg); }
.world-map { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(ellipse at 50% 40%, #10415d 0%, #082d45 48%, #041a2a 80%, #020c16 100%); }
.world-map::before { position: absolute; inset: 0; content: ""; pointer-events: none; background: radial-gradient(ellipse at 50% 42%, rgba(31,118,153,.2), transparent 58%), radial-gradient(circle at 14% 12%, rgba(193,229,225,.5) 0 1rpx, transparent 2rpx), radial-gradient(circle at 78% 18%, rgba(181,225,227,.5) 0 1rpx, transparent 2rpx), radial-gradient(circle at 88% 58%, rgba(181,225,227,.38) 0 1rpx, transparent 2rpx), radial-gradient(circle at 23% 68%, rgba(181,225,227,.34) 0 1rpx, transparent 2rpx), linear-gradient(180deg, rgba(1,10,19,.17), transparent 34%, rgba(1,12,20,.25)); }
.world-map::after { position: absolute; inset: 0; content: ""; pointer-events: none; background: linear-gradient(180deg, rgba(2,13,23,.12), transparent 37%, rgba(1,12,20,.32) 68%, #031522 100%); }
/* 800rpx is the maximum; onReady measures the rail and shrinks this before renderer init. */
.globe-webgl-canvas, .globe-canvas { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 162rpx); left: 0; display: block; width: 100%; height: 800rpx; filter: brightness(1.2) contrast(.98) saturate(1.1) drop-shadow(0 0 16rpx rgba(39,156,200,.32)); touch-action: none; }
.globe-label-canvas { position: absolute; z-index: 24; top: calc(env(safe-area-inset-top) + 162rpx); left: 0; display: block; width: 100%; height: 800rpx; background: transparent; touch-action: none; }
.globe-canvas-earth-only { top: 0; left: 0; width: 100%; height: 100%; }
.world-map-fallback { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 182rpx); left: 0; width: 100%; height: 620rpx; opacity: .78; filter: brightness(.58) saturate(1.25); }
.map-head { position: absolute; left: 44rpx; right: 52rpx; z-index: 30; display: flex; align-items: center; min-height: 126rpx; }
.map-brand-mark { width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 14rpx; display: flex; align-items: center; justify-content: center; }
.map-brand-icon { display: block; width: 36rpx; height: 36rpx; }
.map-title-group { display: flex; flex-direction: column; gap: 3rpx; }
.map-title { color: #f4f5ec; font-size: 36rpx; line-height: 1.12; font-weight: 700; }
.map-subtitle { color: rgba(221,234,228,.82); font-size: 19rpx; line-height: 1.35; }
.map-title-en { margin-top: 2rpx; color: rgba(204,225,225,.7); font-size: 14rpx; letter-spacing: 1.1rpx; }
.map-header-actions { margin-left: auto; display: flex; align-items: center; }
.map-icon-action { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(176,216,220,.25); border-radius: 50%; color: rgba(225,242,238,.9); background: rgba(9,35,52,.72); }
.map-icon-action + .map-icon-action { margin-left: 26rpx; }
.map-header-action-primary { width: 72rpx; height: 72rpx; color: #e2f7f0; background: rgba(15,57,75,.84); border-color: rgba(176,216,220,.34); }
.map-control-icon { display: block; flex-shrink: 0; width: 32rpx; height: 32rpx; }
.world-markers { position: absolute; inset: 0; z-index: 20; pointer-events: none; }
.world-marker { position: absolute; display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -50%); width: 56rpx; height: 56rpx; pointer-events: auto; touch-action: none; }
.marker-pin { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #c6edeb; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #0f5b71; box-shadow: 0 0 0 7rpx rgba(49,187,204,.15), 0 6rpx 18rpx rgba(0,0,0,.3); }
.marker-glyph { color: #d5f5ef; font-size: 20rpx; line-height: 1; font-weight: 800; transform: rotate(45deg); }
.marker-open .marker-pin { background: #31b6c7; border-color: #e5ffff; box-shadow: 0 0 0 8rpx rgba(49,182,199,.19), 0 8rpx 22rpx rgba(0,0,0,.35); }
.marker-open .marker-glyph { color: #052b3a; }
.marker-selected { z-index: 20; }
.marker-selected .marker-pin { width: 52rpx; height: 52rpx; border: 3rpx solid #fff5df; background: #e69a45; box-shadow: 0 0 0 10rpx rgba(230,154,69,.22), 0 0 24rpx rgba(230,154,69,.56); }
.marker-selected .marker-glyph { color: #402617; font-size: 23rpx; }
.marker-label { position: absolute; top: 50rpx; left: 50%; display: flex; flex-direction: column; align-items: flex-start; min-width: 126rpx; padding: 8rpx 12rpx; box-sizing: border-box; transform: translateX(-50%); border: 1rpx solid rgba(143,204,210,.2); border-radius: 9rpx; background: rgba(4,24,37,.82); box-shadow: 0 5rpx 13rpx rgba(0,0,0,.24); white-space: nowrap; }
.marker-label-right { left: 50%; transform: translateX(16rpx); }
.marker-label-left { left: auto; right: 50%; align-items: flex-end; transform: translateX(-16rpx); }
.marker-label-title { color: #f1f5eb; font-size: 17rpx; line-height: 1.25; font-weight: 700; }
.marker-label-meta { margin-top: 2rpx; color: rgba(197,224,224,.78); font-size: 13rpx; line-height: 1.25; }
.marker-selected .marker-label { top: 62rpx; border-color: rgba(235,174,98,.55); }
.map-side-controls { position: absolute; z-index: 35; top: calc(env(safe-area-inset-top) + 338rpx); right: 60rpx; display: flex; flex-direction: column; }
.map-side-control { width: 64rpx; height: 64rpx; margin-bottom: 24rpx; box-sizing: border-box; border: 1rpx solid transparent; border-radius: 50%; background-color: transparent; }
.map-side-control:first-child { width: 70rpx; height: 70rpx; }
.map-side-control-atlas { margin-bottom: 0; }
.continue-panel { position: absolute; z-index: var(--geo-z-overlay); left: 28rpx; right: 28rpx; bottom: calc(env(safe-area-inset-bottom) + 410rpx); padding: 27rpx 25rpx 17rpx; box-sizing: border-box; border: 1rpx solid rgba(164,220,234,.38); border-radius: var(--geo-radius-lg); color: var(--geo-ink); background: linear-gradient(130deg, rgba(34,97,116,.46), rgba(14,51,68,.54) 72%, rgba(30,82,96,.46)); -webkit-backdrop-filter: blur(24px) saturate(1.26); backdrop-filter: blur(24px) saturate(1.26); box-shadow: 0 9rpx 26rpx rgba(0,8,16,.24), inset 0 1rpx 0 rgba(190,230,232,.12); }
.continue-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30rpx; }
.continue-label { color: #8bd4dd; font-size: 26rpx; letter-spacing: .5rpx; font-weight: 700; }
.continue-main { display: flex; align-items: flex-start; }
.continue-image-frame, .continue-image-fallback { position: relative; flex-shrink: 0; width: 230rpx; height: 160rpx; margin-right: 20rpx; overflow: hidden; border-radius: 11rpx; background: linear-gradient(140deg,#b4d1dc,#456676); }
.continue-image { position: absolute; left: 0; top: -18rpx; width: 230rpx; height: 410rpx; }
.continue-image-everest { left: -77rpx; top: 0; width: 384rpx; height: 160rpx; }
.continue-image-fallback { display: flex; align-items: center; justify-content: center; color: #e8f4e8; font-size: 37rpx; }
.continue-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; padding-top: 8rpx; }
.continue-title { color: #f5f7ed; font-size: 28rpx; font-weight: 800; }
.continue-meta { overflow: hidden; color: rgba(190,213,214,.82); font-size: 23rpx; white-space: nowrap; text-overflow: ellipsis; }
.continue-progress-copy { color: #d0e4dc; font-size: 20rpx; }
.continue-progress { width: 100%; max-width: 260rpx; height: 6rpx; margin-top: 4rpx; overflow: hidden; border-radius: 99rpx; background: rgba(157,191,193,.17); }
.continue-progress-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg,#3dabb7,#80c5b2); transition: width 250ms ease-out; }
.continue-action { width: 66rpx; height: 66rpx; flex-shrink: 0; align-self: center; margin-left: 24rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(213,251,246,.2); border-radius: 50%; color: #f1fffa; background: linear-gradient(145deg,#48b8ca,#2785aa); box-shadow: 0 5rpx 14rpx rgba(0,15,27,.28); }
.continue-arrow-icon { display: block; width: 30rpx; height: 30rpx; }
.recommendation-rail { position: absolute; z-index: 8; left: 25rpx; right: 25rpx; bottom: calc(env(safe-area-inset-bottom) + 150rpx); padding: 0; background: transparent; }
.map-recommend-heading { display: block; margin-bottom: 10rpx; }
.recommendation-scroll { width: 100%; }
.recommendation-row { display: inline-flex; gap: 20rpx; }
.recommendation-card { position: relative; width: 220rpx; height: 200rpx; overflow: hidden; border: 1rpx solid rgba(186,225,225,.16); border-radius: 13rpx; background: #183d4f; }
.recommendation-card image, .recommendation-image-fallback, .recommendation-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.recommendation-image { filter: brightness(1.06) saturate(1.06); }
.recommendation-image-p-mariana { filter: brightness(.78) saturate(.78); }
.recommendation-image-fallback { display: flex; align-items: center; justify-content: flex-end; padding-right: 18rpx; box-sizing: border-box; color: rgba(225,248,240,.36); font-size: 60rpx; }
.recommendation-shade { background: linear-gradient(180deg,rgba(4,23,36,0) 34%,rgba(4,23,36,.18) 58%,rgba(4,23,36,.82) 100%); }
.recommendation-copy { position: absolute; left: 12rpx; right: 8rpx; bottom: 11rpx; display: flex; flex-direction: column; gap: 2rpx; }
.recommendation-en { color: rgba(216,230,226,.76); font-size: 14rpx; }
.recommendation-name { color: #fbf7e9; font-size: 20rpx; font-weight: 700; }
.recommendation-metric { color: rgba(203,222,220,.78); font-size: 14rpx; }
.destination-preview { position: absolute; z-index: 80; top: calc(env(safe-area-inset-top) + 270rpx); right: 25rpx; width: 316rpx; overflow: hidden; padding: 17rpx; box-sizing: border-box; border: 1rpx solid rgba(165,216,218,.5); border-radius: 17rpx; color: #edf6ec; background: rgba(4,25,39,.96); box-shadow: 0 16rpx 38rpx rgba(0,0,0,.54); animation: destination-panel-in .22s ease-out; }
.destination-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 6rpx; min-height: 30rpx; }
.destination-kicker { max-width: 242rpx; color: #86cdd5; font-size: 15rpx; line-height: 1.25; }
.destination-title { display: block; max-width: 258rpx; color: #f5f5e9; font-size: 25rpx; line-height: 1.2; font-weight: 800; }
.destination-en { display: block; margin-top: 3rpx; color: rgba(196,225,220,.68); font-size: 14rpx; letter-spacing: .5rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.destination-desc { color: rgba(211,233,226,.78); font-size: 16rpx; line-height: 1.4; margin-top: 7rpx; }
.destination-desc-compact { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.destination-metric { display: block; margin-top: 9rpx; padding-top: 8rpx; border-top: 1rpx solid rgba(174,224,226,.2); color: #eff8ed; font-size: 17rpx; line-height: 1.3; }
.destination-action { display: block; margin-top: 9rpx; padding-top: 8rpx; border-top: 1rpx solid rgba(174,224,226,.14); color: #8ee1e3; font-size: 17rpx; line-height: 24rpx; font-weight: 700; }
.destination-arrow-icon { display: inline-block; width: 26rpx; height: 26rpx; margin-left: 10rpx; vertical-align: middle; }
.destination-close { flex-shrink: 0; padding: 0 2rpx; color: rgba(216,239,232,.68); font-size: 26rpx; line-height: 24rpx; }
.atlas-drawer { position: absolute; z-index: 40; left: 14rpx; right: 14rpx; top: calc(env(safe-area-inset-top) + 100rpx); bottom: calc(env(safe-area-inset-bottom) + 125rpx); padding: 23rpx 19rpx; box-sizing: border-box; border: 1rpx solid #e0d5bd; border-radius: 21rpx; background: #f7f0e2; box-shadow: 0 18rpx 55rpx rgba(3,24,38,.42); }
.atlas-drawer-head { display: flex; align-items: center; justify-content: space-between; }
.atlas-drawer-head > view { display: flex; flex-direction: column; gap: 3rpx; }
.atlas-kicker { color: #608a85; font-size: 14rpx; letter-spacing: 2rpx; }
.atlas-title { color: #1f3947; font-size: 31rpx; font-weight: 800; }
.atlas-close { padding: 8rpx 13rpx; color: #567987; font-size: 42rpx; }
.atlas-search { height: 68rpx; margin-top: 13rpx; padding: 0 22rpx; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; border: 1rpx solid #e3d9c8; border-radius: 12rpx; color: #527481; background: #fcf8ef; }
.atlas-search-icon { display: block; width: 30rpx; height: 30rpx; flex-shrink: 0; }
.atlas-search text { font-size: 28rpx; }
.atlas-search input { flex: 1; min-width: 0; color: #283f4a; font-size: 21rpx; }
.atlas-types { width: 100%; margin-top: 14rpx; }
.atlas-type-row { display: inline-flex; gap: 8rpx; }
.atlas-type { padding: 9rpx 16rpx; border: 1rpx solid #e2d9ca; border-radius: 999rpx; color: #677c7b; background: #fcf8ef; font-size: 19rpx; white-space: nowrap; }
.atlas-type-active { color: #eff8f0; background: #287c9a; border-color: #287c9a; font-weight: 700; }
.atlas-list { height: calc(100% - 205rpx); margin-top: 13rpx; }
.atlas-grid { display: flex; flex-direction: column; gap: 9rpx; padding-bottom: 18rpx; }
.atlas-item { display: flex; align-items: center; gap: 12rpx; padding: 13rpx; border: 1rpx solid #e8decd; border-radius: 12rpx; background: #fcf8ef; }
.atlas-item-mark { width: 59rpx; height: 59rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; color: #39839a; background: #e7eee7; font-size: 27rpx; }
.atlas-item-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.atlas-item-name { color: #273e49; font-size: 23rpx; font-weight: 700; }
.atlas-item-meta { color: #548d9a; font-size: 17rpx; }
.atlas-item-desc { color: #87928b; font-size: 18rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.atlas-item-arrow { color: #287c9a; font-size: 36rpx; }
.atlas-favorite { padding: 7rpx 8rpx; color: #cd7655; font-size: 28rpx; }
@keyframes destination-panel-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
