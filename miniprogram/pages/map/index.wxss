.page { position: fixed; inset: 0; overflow: hidden; background: #03182b; color: #edfaff; }
.world-map { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(circle at 46% 38%, #0b2947 0%, #04172c 45%, #010914 100%); }
.world-map::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 8% 8%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 26% 14%, rgba(160, 223, 255, .9) 0 1rpx, transparent 2rpx), radial-gradient(circle at 54% 9%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 78% 18%, rgba(160, 223, 255, .8) 0 1rpx, transparent 2rpx), radial-gradient(circle at 94% 7%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 87% 38%, rgba(160, 223, 255, .7) 0 1rpx, transparent 2rpx), radial-gradient(circle at 16% 43%, rgba(160, 223, 255, .65) 0 1rpx, transparent 2rpx), radial-gradient(circle at 42% 27%, rgba(160, 223, 255, .55) 0 1rpx, transparent 2rpx), radial-gradient(circle at 64% 52%, rgba(160, 223, 255, .65) 0 1rpx, transparent 2rpx), radial-gradient(circle at 18% 76%, #fff 0 1rpx, transparent 2rpx), radial-gradient(circle at 91% 72%, rgba(160, 223, 255, .7) 0 1rpx, transparent 2rpx), radial-gradient(circle at 18% 20%, rgba(88, 194, 224, .11), transparent 23%), linear-gradient(180deg, rgba(1, 12, 25, .08), rgba(1, 10, 20, .72)); pointer-events: none; }
.world-map::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(1, 11, 22, .28) 0%, transparent 28%, rgba(1, 8, 17, .78) 78%, #020e1c 100%); pointer-events: none; }
.globe-webgl-canvas, .globe-canvas { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 162rpx); left: 0; width: 100%; height: 900rpx; display: block; touch-action: none; }
.globe-label-canvas { position: absolute; z-index: 24; top: calc(env(safe-area-inset-top) + 162rpx); left: 0; width: 100%; height: 900rpx; display: block; background: transparent; touch-action: none; }
.globe-canvas-earth-only { top: 0; left: 0; width: 100%; height: 100%; }
.world-map-fallback { position: absolute; z-index: 1; top: calc(env(safe-area-inset-top) + 182rpx); left: 0; width: 100%; height: 620rpx; opacity: .78; filter: brightness(.58) saturate(1.35); }
.globe-hint { position: absolute; z-index: 35; left: 28rpx; top: calc(env(safe-area-inset-top) + 270rpx); display: flex; align-items: center; gap: 10rpx; padding: 9rpx 14rpx; border-radius: 999rpx; color: rgba(223, 247, 252, .86); background: rgba(3, 19, 34, .78); border: 1rpx solid rgba(130, 211, 229, .24); font-size: 17rpx; letter-spacing: .4rpx; }
.globe-hint-dot { width: 10rpx; height: 10rpx; border: 2rpx solid #65e3ef; border-radius: 50%; box-shadow: 0 0 12rpx rgba(101, 227, 239, .8); }
.map-head { position: absolute; left: 24rpx; right: 24rpx; display: flex; align-items: center; z-index: 30; }
.map-back { width: 46rpx; flex-shrink: 0; font-size: 54rpx; line-height: 50rpx; color: #fff; }
.map-title-group { display: flex; flex-direction: column; gap: 2rpx; }
.map-title { font-size: 38rpx; line-height: 1.15; font-weight: 800; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,.5); }
.map-title-en { color: rgba(221,247,255,.78); font-size: 18rpx; letter-spacing: 3rpx; }
.map-header-actions { margin-left: auto; display: flex; align-items: center; gap: 10rpx; }
.map-header-actions text { min-width: 62rpx; height: 44rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: rgba(4, 24, 40, .86); border: 1rpx solid rgba(160, 222, 235, .3); color: rgba(224, 247, 252, .9); font-size: 16rpx; font-weight: 700; }
.map-header-actions .map-header-action-primary { color: #071d2b; background: #9ee8f2; border-color: #bceff5; }
.world-map-caption { position: absolute; z-index: 30; left: 30rpx; top: 59%; display: flex; flex-direction: column; gap: 5rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.72); }
.caption-kicker { color: #91e6f3; font-size: 18rpx; letter-spacing: 4rpx; font-weight: 700; }
.caption-title { color: #f4fbff; font-size: 30rpx; font-weight: 800; }
.caption-sub { color: rgba(208,237,244,.75); font-size: 19rpx; }
.world-markers { position: absolute; inset: 0; z-index: 20; pointer-events: none; }
.world-marker { position: absolute; display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -50%); width: 56rpx; height: 56rpx; pointer-events: auto; touch-action: none; }
.marker-pin { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #fff; border: 2rpx solid #79a9b8; box-shadow: 0 6rpx 16rpx rgba(38, 90, 109, .22); }
.marker-glyph { transform: rotate(45deg); color: #397588; font-size: 21rpx; line-height: 1; font-weight: 800; }
.marker-open .marker-pin { background: #2c77d9; border-color: #fff; box-shadow: 0 0 0 7rpx rgba(44,119,217,.18), 0 8rpx 18rpx rgba(38,90,109,.26); }
.marker-open .marker-glyph { color: #fff; }
.marker-selected { z-index: 20; }
.marker-selected .marker-pin { width: 54rpx; height: 54rpx; background: #ff7458; border: 3rpx solid #fff; box-shadow: 0 0 0 9rpx rgba(255,116,88,.24), 0 0 24rpx rgba(255,116,88,.65), 0 8rpx 18rpx rgba(38,90,109,.28); }
.marker-selected .marker-glyph { color: #fff; font-size: 24rpx; }
.marker-label { position: absolute; top: 50rpx; left: 50%; display: flex; flex-direction: column; align-items: flex-start; min-width: 126rpx; padding: 8rpx 12rpx; box-sizing: border-box; transform: translateX(-50%); border-radius: 10rpx; background: rgba(3, 21, 35, .92); border: 1rpx solid rgba(140, 214, 230, .34); box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .32); white-space: nowrap; }
.marker-label-right { left: 50%; transform: translateX(16rpx); }
.marker-label-left { left: auto; right: 50%; transform: translateX(-16rpx); align-items: flex-end; }
.marker-label-title { color: #f4fbff; font-size: 18rpx; line-height: 1.25; font-weight: 750; }
.marker-label-meta { margin-top: 2rpx; color: #91d5e7; font-size: 14rpx; line-height: 1.25; }
.marker-selected .marker-label { top: 62rpx; border-color: rgba(255,157,132,.66); background: rgba(29, 22, 27, .95); }
.map-legend { display: none; position: absolute; z-index: 4; left: 28rpx; right: 28rpx; top: 62%; align-items: center; gap: 18rpx; color: rgba(219,243,248,.82); font-size: 18rpx; }
.legend-label { color: #fff; font-size: 21rpx; font-weight: 700; }
.legend-item { display: flex; align-items: center; gap: 6rpx; }
.legend-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; border: 2rpx solid #79a9b8; }
.legend-open { background: #2c77d9; border-color: #2c77d9; }
.legend-count { margin-left: auto; color: rgba(205,234,241,.68); }
.recommendation-rail { position: absolute; z-index: 6; left: 18rpx; right: 18rpx; bottom: calc(env(safe-area-inset-bottom) + 136rpx); padding: 16rpx 0 0; border-radius: 18rpx; background: transparent; border: 0; box-shadow: none; }
.recommendation-head { display: flex; align-items: end; justify-content: space-between; margin-bottom: 12rpx; }
.recommendation-kicker { display: block; color: #8bdaf1; font-size: 16rpx; letter-spacing: 2rpx; }
.recommendation-title { display: block; margin-top: 4rpx; color: #fff; font-size: 26rpx; font-weight: 800; }
.recommendation-count { color: rgba(210,236,243,.64); font-size: 17rpx; }
.recommendation-row { display: inline-flex; gap: 12rpx; }
.recommendation-card { position: relative; width: 300rpx; height: 224rpx; overflow: hidden; border-radius: 14rpx; background: #123b56; border: 1rpx solid rgba(189, 235, 244, .22); }
.recommendation-card image, .recommendation-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.recommendation-shade { background: linear-gradient(90deg, rgba(5,22,36,.82), rgba(5,22,36,.08)); }
.recommendation-copy { position: absolute; left: 16rpx; top: 14rpx; display: flex; flex-direction: column; gap: 3rpx; }
.recommendation-en { color: rgba(239, 251, 255, .94); font-size: 19rpx; font-weight: 700; }
.recommendation-name { color: #fff; font-size: 23rpx; font-weight: 800; }
.recommendation-metric { color: #a9e2ef; font-size: 18rpx; }
.recommendation-cta { position: absolute; left: 14rpx; bottom: 13rpx; display: flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255, 116, 81, .9); color: #fff; font-size: 18rpx; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(255, 116, 81, .24); }
.recommendation-card:nth-child(2) .recommendation-cta { background: rgba(34, 180, 218, .92); box-shadow: 0 4rpx 12rpx rgba(34, 180, 218, .24); }
.recommendation-cta text:last-child { font-size: 28rpx; line-height: 16rpx; }
.recommendation-arrow { display: none; position: absolute; right: 14rpx; bottom: 12rpx; color: #fff; font-size: 36rpx; }
.destination-preview { position: absolute; z-index: 80; top: calc(env(safe-area-inset-top) + 270rpx); right: 28rpx; width: 300rpx; display: block; overflow: hidden; padding: 14rpx; box-sizing: border-box; border-radius: 16rpx; background: #041727; opacity: 1; border: 1rpx solid rgba(172, 229, 240, .72); box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, .58); color: #edfaff; animation: destination-panel-in .24s ease-out; }
.destination-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 6rpx; min-height: 30rpx; }
.destination-image { display: none; }
.destination-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding-top: 2rpx; }
.destination-kicker { display: block; max-width: 242rpx; color: #8bdaf1; font-size: 15rpx; line-height: 1.25; }
.destination-title { display: block; max-width: 242rpx; color: #f5fdff; font-size: 25rpx; line-height: 1.2; font-weight: 800; white-space: normal; word-break: break-all; }
.destination-en { display: block; margin-top: 3rpx; color: rgba(196, 235, 242, .68); font-size: 14rpx; letter-spacing: .6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.destination-desc { color: rgba(211, 235, 241, .78); font-size: 15rpx; line-height: 1.35; margin-top: 6rpx; }
.destination-desc-compact { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.destination-metric { display: block; margin-top: 8rpx; padding-top: 7rpx; border-top: 1rpx solid rgba(174, 224, 235, .2); color: #f2fdff; font-size: 15rpx; line-height: 1.3; white-space: normal; }
.destination-metric-label { color: rgba(185, 222, 230, .72); }
.destination-metric-value { color: #f2fdff; font-size: 20rpx; font-weight: 800; }
.destination-action { position: static; display: block; margin-top: 8rpx; padding-top: 7rpx; border-top: 1rpx solid rgba(174, 224, 235, .14); color: #7de7f5; font-size: 16rpx; line-height: 23rpx; font-weight: 700; }
.destination-action-label { color: #7de7f5; }
.destination-action .destination-arrow { display: inline; margin-left: 4rpx; font-size: 29rpx; line-height: 22rpx; }
.destination-arrow { font-size: 35rpx; line-height: 22rpx; }
.destination-close { flex-shrink: 0; color: rgba(216, 246, 250, .68); font-size: 26rpx; line-height: 24rpx; padding: 0 2rpx; }
@keyframes destination-panel-in { from { opacity: 0; transform: translateX(18rpx); } to { opacity: 1; transform: translateX(0); } }
.atlas-drawer { position: absolute; z-index: 8; left: 14rpx; right: 14rpx; top: calc(env(safe-area-inset-top) + 102rpx); bottom: calc(env(safe-area-inset-bottom) + 128rpx); padding: 22rpx 18rpx; box-sizing: border-box; border-radius: 22rpx; background: rgba(255,255,255,.98); border: 1rpx solid #c7dce3; box-shadow: 0 18rpx 55rpx rgba(16,44,61,.2); }
.atlas-drawer-head { display: flex; align-items: center; justify-content: space-between; }
.atlas-drawer-head > view { display: flex; flex-direction: column; gap: 4rpx; }
.atlas-kicker { color: #168bb9; font-size: 18rpx; letter-spacing: 4rpx; }
.atlas-title { color: #102c3d; font-size: 32rpx; font-weight: 800; }
.atlas-close { color: #2c77d9; font-size: 42rpx; padding: 8rpx 14rpx; }
.atlas-types { width: 100%; margin-top: 18rpx; }
.atlas-type-row { display: inline-flex; gap: 10rpx; }
.atlas-type { padding: 10rpx 18rpx; border-radius: 999rpx; background: #f1f7f9; border: 1rpx solid #d5e2e9; color: #587180; font-size: 20rpx; white-space: nowrap; }
.atlas-type-active { color: #fff; background: #2c77d9; border-color: #2c77d9; font-weight: 700; }
.atlas-list { height: calc(100% - 126rpx); margin-top: 16rpx; }
.atlas-grid { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 18rpx; }
.atlas-item { display: flex; align-items: center; gap: 14rpx; padding: 15rpx; border-radius: 14rpx; background: #f1f7f9; border: 1rpx solid #d5e2e9; }
.atlas-item-mark { width: 62rpx; height: 62rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #e5f3f8; font-size: 30rpx; }
.atlas-item-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.atlas-item-name { color: #102c3d; font-size: 24rpx; font-weight: 700; }
.atlas-item-meta { color: #168bb9; font-size: 18rpx; }
.atlas-item-desc { color: #8da1ad; font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.atlas-item-arrow { color: #2c77d9; font-size: 38rpx; }
.atlas-empty { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding-top: 80rpx; color: #8da1ad; font-size: 22rpx; }
