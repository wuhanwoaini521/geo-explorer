<view class="page explore-page geo-theme-dark">
  <view class="world-map" aria-label="交互式数字地球">
    <canvas wx:if="{{globeRendererReady && !atlasOpen && !webglFailed}}" id="globeWebglCanvas" type="webgl" class="globe-webgl-canvas {{globeEarthOnly ? 'globe-canvas-earth-only' : ''}}" style="height:{{globeCanvasHeight}}" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <canvas wx:if="{{globeRendererReady && !atlasOpen && !webglFailed && !globeEarthOnly}}" id="globeLabelCanvas" type="2d" class="globe-label-canvas" style="height:{{globeCanvasHeight}}" disable-scroll="{{true}}" bindtouchstart="onGlobeTouchStart" catchtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <canvas wx:if="{{globeRendererReady && !atlasOpen && webglFailed && !globeFailed}}" id="globeCanvas" type="2d" class="globe-canvas {{globeEarthOnly ? 'globe-canvas-earth-only' : ''}}" style="height:{{globeCanvasHeight}}" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel"></canvas>
    <image wx:if="{{globeFailed}}" class="world-map-fallback" src="/assets/world/world-map.svg" mode="aspectFill"></image>

    <cover-view wx:if="{{!atlasOpen && !globeEarthOnly && globeFailed}}" class="world-markers">
      <block wx:for="{{worldMarkers}}" wx:key="id">
        <cover-view wx:if="{{item.screenVisible}}" class="world-marker {{item.explorationId ? 'marker-open' : ''}} {{item.id === selectedMarkerId ? 'marker-selected' : ''}}" style="left:{{item.screenLeft}}%;top:{{item.screenTop}}%;opacity:{{item.screenOpacity}}" data-id="{{item.id}}" bindtap="onMapPointTap" bindtouchstart="onGlobeTouchStart" bindtouchmove="onGlobeTouchMove" bindtouchend="onGlobeTouchEnd" bindtouchcancel="onGlobeTouchCancel">
          <cover-view class="marker-pin"><cover-view class="marker-glyph">{{item.typeGlyph}}</cover-view></cover-view>
          <cover-view class="marker-label marker-label-{{item.labelPlacement}}">
            <cover-view class="marker-label-title">{{item.name}}</cover-view>
            <cover-view class="marker-label-meta">{{item.typeLabel}} · {{item.metricText}}</cover-view>
          </cover-view>
        </cover-view>
      </block>
    </cover-view>

    <cover-view wx:if="{{selectedDestination && !atlasOpen}}" class="destination-preview" bindtap="onOpenDestination">
      <cover-view class="destination-panel-head">
        <cover-view class="destination-kicker">{{selectedDestination.typeLabel}} · {{selectedDestination.region}}</cover-view>
        <cover-view class="destination-close" catchtap="onCloseDestination">×</cover-view>
      </cover-view>
      <cover-view class="destination-title">{{selectedDestination.name}}</cover-view>
      <cover-view class="destination-en">{{selectedDestination.nameEn}}</cover-view>
      <cover-view class="destination-desc destination-desc-compact">{{selectedDestination.description}}</cover-view>
      <cover-view class="destination-metric">{{selectedDestination.metricLabel}} · {{selectedDestination.metricValue}}</cover-view>
      <cover-view class="destination-action">{{selectedDestination.actionLabel}} <cover-image class="destination-arrow-icon" src="/assets/icons/arrow-teal.png"></cover-image></cover-view>
    </cover-view>
  </view>

  <block wx:if="{{!globeEarthOnly}}">
    <cover-view class="map-head" style="top:{{headerTop}}px">
      <cover-view class="map-brand-mark" aria-hidden="true"><cover-image class="map-brand-icon" src="/assets/icons/brand-location.png"></cover-image></cover-view>
      <cover-view class="map-title-group">
        <cover-view class="map-title">Geo Explorer</cover-view>
        <cover-view class="map-subtitle">探索地球 · 发现世界 · 理解自然</cover-view>
        <cover-view class="map-title-en">EXPLORE · LEARN · DISCOVER</cover-view>
      </cover-view>
      <cover-view class="map-header-actions">
        <cover-view class="map-icon-action map-header-action-primary" aria-label="打开地貌图鉴" bindtap="onToggleAtlas"><cover-image class="map-control-icon" src="/assets/icons/search-on-dark.png"></cover-image></cover-view>
        <cover-view class="map-icon-action" aria-label="地图设置" bindtap="onOpenMapActions"><cover-image class="map-control-icon" src="/assets/icons/settings-on-dark.png"></cover-image></cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{!atlasOpen}}" class="map-side-controls" aria-label="地球控制">
      <cover-view class="map-side-control map-side-control-layers" aria-label="切换地图图层" bindtap="onToggleMapMode"></cover-view>
      <cover-view class="map-side-control map-side-control-target" aria-label="重置地球视角" bindtap="onResetGlobe"></cover-view>
      <cover-view class="map-side-control map-side-control-atlas" aria-label="打开地貌图鉴" bindtap="onToggleAtlas"></cover-view>
    </cover-view>

    <cover-view wx:if="{{!atlasOpen && continueCard}}" class="continue-panel" data-id="{{continueCard.id}}" bindtap="onGo">
      <cover-view class="continue-head"><cover-view class="continue-label">继续探索</cover-view></cover-view>
      <cover-view class="continue-main">
        <cover-view wx:if="{{continueCard.image}}" class="continue-image-frame"><cover-image class="continue-image continue-image-{{continueCard.id}}" src="{{continueCard.image}}"></cover-image></cover-view>
        <cover-view wx:else class="continue-image-fallback">▲</cover-view>
        <cover-view class="continue-copy">
          <cover-view class="continue-title">{{continueCard.place}}</cover-view>
          <cover-view class="continue-meta">{{continueCard.record ? continueCard.reachedText : '从 0 m 出发'}}  →  {{continueCard.elevText}}</cover-view>
          <cover-view class="continue-progress-copy">进度 {{continueCard.progress}}%</cover-view>
          <cover-view class="continue-progress geo-track"><cover-view class="continue-progress-fill geo-track-fill" style="width:{{continueCard.progress}}%"></cover-view></cover-view>
        </cover-view>
        <cover-view class="continue-action" aria-hidden="true"><cover-image class="continue-arrow-icon" src="/assets/icons/arrow-on-dark.png"></cover-image></cover-view>
      </cover-view>
    </cover-view>
  </block>

  <view wx:if="{{!atlasOpen && !globeEarthOnly && recommendationsVisible}}" class="recommendation-rail">
    <geo-section-heading class="map-recommend-heading" title="今日推荐" action="更多" bind:action="onToggleAtlas" />
    <scroll-view class="recommendation-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="recommendation-row">
        <view wx:for="{{recommendations}}" wx:key="id" class="recommendation-card" data-id="{{item.id}}" bindtap="onOpenRecommendation">
          <image wx:if="{{item.image && !failedImages[item.id]}}" class="recommendation-image recommendation-image-{{item.id}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
          <view wx:else class="recommendation-image-fallback">{{item.typeGlyph}}</view>
          <view class="recommendation-shade"></view>
          <view class="recommendation-copy"><text class="recommendation-en">{{item.typeLabel}}</text><text class="recommendation-name">{{item.name}}</text><text class="recommendation-metric">{{item.metricValue}}</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{atlasOpen}}" class="atlas-drawer">
    <view class="atlas-drawer-head"><view><text class="atlas-kicker">WORLD ATLAS  /  {{atlasTotal}} SITES</text><text class="atlas-title">地貌图鉴</text></view><text class="atlas-close" bindtap="onToggleAtlas">×</text></view>
    <view class="atlas-search"><image class="atlas-search-icon" src="/assets/icons/search-on-light.svg" mode="aspectFit"></image><input value="{{query}}" placeholder="搜索知识、地点或地貌" confirm-type="search" bindinput="onAtlasSearchInput" /><text wx:if="{{query}}" bindtap="onQueryClear">×</text></view>
    <scroll-view class="atlas-types" scroll-x enhanced show-scrollbar="{{false}}"><view class="atlas-type-row"><text wx:for="{{types}}" wx:key="type" class="atlas-type {{activeType === item.type ? 'atlas-type-active' : ''}}" data-type="{{item.type}}" bindtap="onTypeTap">{{item.label}}</text></view></scroll-view>
    <scroll-view class="atlas-list" scroll-y>
      <view wx:if="{{atlas.length}}" class="atlas-grid">
        <view wx:for="{{atlas}}" wx:key="id" class="atlas-item" data-id="{{item.id}}" bindtap="onOpenPlace">
          <view class="atlas-item-mark">{{item.emoji}}</view>
          <view class="atlas-item-copy"><text class="atlas-item-name">{{item.name}}</text><text class="atlas-item-meta">{{item.typeLabel}}{{item.exploration ? ' · 可探索' : ''}}</text><text class="atlas-item-desc">{{item.shortDescription}}</text></view>
          <text class="atlas-favorite" data-id="{{item.id}}" catchtap="onToggleFavorite">{{item.favorited ? '♥' : '♡'}}</text>
        </view>
      </view>
      <geo-empty-state wx:else title="没有匹配的地点" description="试试其他关键词或分类" />
    </scroll-view>
  </view>
</view>
