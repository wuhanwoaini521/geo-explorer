<view class="page" wx:if="{{item}}">
  <view class="detail-back" bindtap="onBack">‹ 返回知识</view>
  <view class="head">
    <view class="head-mark"><text>地貌</text></view>
    <text class="head-title">{{item.title}}</text>
    <text class="head-cat">{{item.category}}</text>
  </view>

  <!-- 知识配图：点击全屏看大图（多张时可左右滑动） -->
  <view wx:if="{{images.length}}" class="media">
    <image wx:if="{{!imageFailed}}" class="media-image" mode="aspectFill" src="{{images[0]}}" bindtap="onPreviewImage" binderror="onImageError"></image>
    <view wx:else class="media-image media-image-fallback" bindtap="onPreviewImage">{{item.emoji}}</view>
    <view class="media-foot">
      <text wx:if="{{images.length > 1}}" class="media-count">共 {{images.length}} 张</text>
      <text class="media-hint">点击看大图</text>
    </view>
  </view>

  <view wx:if="{{process && currentStep}}" class="process-explorer">
    <view class="process-head"><view><text class="section-title">地貌课堂</text><text class="process-question">{{process.question}}</text></view><text class="process-count">{{processIndex + 1}} / {{process.steps.length}}</text></view>
    <view class="process-steps"><view wx:for="{{process.steps}}" wx:key="id" class="process-step-dot {{index < processIndex ? 'complete' : ''}} {{index === processIndex ? 'current' : ''}}"><text>{{item.label}}</text></view></view>
    <view class="process-visual"><text class="visual-line">{{currentStep.visual}}</text><text class="visual-title">{{currentStep.title}}</text><text class="visual-step">{{currentStep.label}}</text></view>
    <text class="process-explanation">{{currentStep.explanation}}</text>
    <view class="process-progress"><view class="process-progress-on" style="width:{{((processIndex + 1) / process.steps.length) * 100}}%"></view></view>
    <view class="process-actions"><view class="process-prev {{processIndex === 0 ? 'disabled' : ''}}" bindtap="onProcessPrev">‹ 上一步</view><view class="process-next {{processIndex === process.steps.length - 1 ? 'disabled' : ''}}" bindtap="onProcessNext">{{processIndex === process.steps.length - 1 ? '已完成' : '下一步 ›'}}</view></view>
  </view>

  <view class="section">
    <text class="section-title">一句话</text>
    <text class="section-body">{{item.summary}}</text>
  </view>

  <view class="section">
    <text class="section-title">详解</text>
    <text class="section-body">{{item.content}}</text>
  </view>

  <view class="section" wx:if="{{relatedPlaces.length}}">
    <text class="section-title">相关地点</text>
    <view class="place-links">
      <view class="place-link" wx:for="{{relatedPlaces}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onOpenPlace">
        <view class="place-link-mark"><text>地点</text></view>
        <text class="place-link-name">{{item.name}}</text>
        <text class="place-link-type">{{item.typeLabel}}</text>
      </view>
    </view>
  </view>

  <view class="section note" wx:if="{{item.sources.length}}">
    <text class="section-title">来源</text>
    <text class="section-body source">{{item.sources[0].name}}{{item.sources[0].approximate ? '（近似值）' : ''}}</text>
  </view>

  <view class="detail-actions"><view class="detail-action-primary" bindtap="onContinueLearning">继续浏览知识</view><view class="detail-action-secondary" bindtap="onBack">返回上一级</view></view>
</view>
