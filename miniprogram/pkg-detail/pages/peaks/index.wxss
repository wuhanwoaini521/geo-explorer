page { background: #07131f; color: #fff; }
.peaks-page { position: relative; min-height: 100vh; overflow: hidden; background: #0a1d31; }
.peaks-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.peaks-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4,17,31,.42), transparent 28%, rgba(4,15,26,.1) 74%, rgba(4,15,26,.58)); }
.peaks-head { position: absolute; top: calc(env(safe-area-inset-top) + 54rpx); left: 28rpx; display: flex; align-items: center; gap: 18rpx; }
.peaks-back { font-size: 64rpx; line-height: 34rpx; text-shadow: 0 2rpx 8rpx #07131f; }.peaks-title { font-size: 36rpx; font-weight: 800; text-shadow: 0 2rpx 8rpx #07131f; }
.peak-label { position: absolute; transform: translate(-50%,-50%); display: flex; flex-direction: column; align-items: center; gap: 2rpx; color: #f3f9fd; font-size: 24rpx; font-weight: 700; text-shadow: 0 2rpx 6rpx #07131f; white-space: nowrap; }.peak-label text:last-child { font-size: 20rpx; color: #d5ecf9; }.peak-stem { width: 2rpx; height: 54rpx; margin-top: 4rpx; background: #fff; }
.compass { position: absolute; left: 30rpx; bottom: 168rpx; width: 280rpx; height: 150rpx; padding: 18rpx; border-radius: 18rpx; background: rgba(6,20,34,.76); display: flex; align-items: center; gap: 20rpx; }.compass-mark { width: 75rpx; height: 75rpx; border: 2rpx solid #b9cbd5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ff7774; font-size: 24rpx; }.compass-center { font-size: 30rpx; }.compass-bearing { color: #e7f0f5; font-size: 22rpx; line-height: 1.7; }
.peaks-switch { position: absolute; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 28rpx); transform: translateX(-50%); display: flex; align-items: center; gap: 14rpx; padding: 14rpx 22rpx; border-radius: 34rpx; background: rgba(6,20,34,.82); color: #eef6fb; font-size: 22rpx; }.switch { width: 54rpx; height: 30rpx; border-radius: 20rpx; background: #314353; padding: 4rpx; }.switch view { width: 22rpx; height: 22rpx; border-radius: 50%; background: #b8c7d0; }.switch-on { background: #2da9ec; }.switch-on view { margin-left: 24rpx; background: #f6fbff; }
