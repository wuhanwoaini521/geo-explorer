/* One five-tab system, tuned to each page family's native surface. */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 0 0 env(safe-area-inset-bottom);
  pointer-events: none;
}
.pill {
  position: relative;
  display: flex;
  height: 96rpx;
  margin: 0 40rpx 26rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(151, 183, 196, 0.25);
  border-radius: 28rpx;
  box-shadow: 0 9rpx 28rpx rgba(4, 19, 31, 0.2);
  pointer-events: auto;
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}
.tabbar-dark .pill { background: rgba(7, 27, 43, 0.95); border-color: rgba(128, 202, 218, 0.24); }
.tabbar-light .pill { background: rgba(255, 251, 243, 0.97); border-color: rgba(98, 124, 133, 0.18); }
.tabs { position: relative; display: flex; flex: 1; height: 100%; }
.indicator {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  width: 20%;
  border-radius: 20rpx;
  transition: left 210ms ease-out;
  pointer-events: none;
}
.tabbar-dark .indicator { background: rgba(58, 181, 203, 0.16); }
.tabbar-dark.tabbar-explore .indicator { background: transparent; }
.tabbar-light .indicator { background: rgba(42, 137, 204, 0.1); }
.tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.tab-ico {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  opacity: 0.78;
  transition: opacity 190ms ease-out, transform 190ms ease-out;
}
.tab-icon-image { display: block; width: 100%; height: 100%; }

.tab-text { color: #8395a1; font-size: 19rpx; line-height: 1.2; letter-spacing: 0.6rpx; transition: color 190ms ease-out; }
.tab-on .tab-ico { opacity: 1; transform: translateY(-2rpx); }
.tabbar-dark .tab-on .tab-ico, .tabbar-dark .tab-on .tab-text { color: #58d5e8; }
.tabbar-light .tab-on .tab-ico, .tabbar-light .tab-on .tab-text { color: #247bca; }
.tab-on .tab-text { font-weight: 700; }

@media (max-width: 360px) {
  .pill { margin-right: 34rpx; margin-left: 34rpx; }
  .tab-text { font-size: 18rpx; }
}
